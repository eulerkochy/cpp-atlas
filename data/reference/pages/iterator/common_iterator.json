a href=\"/w/cpp/container/list\"><span class=\"kw1283\">std::<span class=\"me2\">list</span></span></a><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/string/basic_string\"><span class=\"kw1238\">std::<span class=\"me2\">string</span></span></a><span class=\"sy1\">&gt;</span> stars<span class=\"br0\">{</span><span class=\"st0\">\"Pollux\"</span>, <span class=\"st0\">\"Arcturus\"</span>, <span class=\"st0\">\"Mira\"</span>, <span class=\"st0\">\"Aldebaran\"</span>, <span class=\"st0\">\"Sun\"</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw1\">using</span> IT <span class=\"sy1\">=</span> std<span class=\"sy4\">::</span><span class=\"me2\">common_iterator</span><span class=\"sy1\">&lt;</span>\n                   <a href=\"/w/cpp/iterator/counted_iterator\"><span class=\"kw3138\">std::<span class=\"me2\">counted_iterator</span></span></a><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/container/list\"><span class=\"kw1283\">std::<span class=\"me2\">list</span></span></a><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/string/basic_string\"><span class=\"kw1238\">std::<span class=\"me2\">string</span></span></a><span class=\"sy1\">&gt;</span><span class=\"sy4\">::</span><span class=\"me2\">iterator</span><span class=\"sy1\">&gt;</span>,\n                   <a href=\"/w/cpp/iterator/default_sentinel_t\"><span class=\"kw2896\">std::<span class=\"me2\">default_sentinel_t</span></span></a><span class=\"sy1\">&gt;</span><span class=\"sy4\">;</span>\n&nbsp;\n    fire<span class=\"br0\">(</span>IT<span class=\"br0\">(</span><a href=\"/w/cpp/iterator/counted_iterator\"><span class=\"kw3138\">std::<span class=\"me2\">counted_iterator</span></span></a><span class=\"br0\">(</span>stars.<span class=\"me1\">begin</span><span class=\"br0\">(</span><span class=\"br0\">)</span>, stars.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy2\">-</span> <span class=\"nu0\">1</span><span class=\"br