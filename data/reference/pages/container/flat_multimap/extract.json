 class=\"br0\">)</span> <span class=\"sy1\">==</span> size<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>map.<span class=\"me1\">empty</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>map.<span class=\"me1\">keys</span><span class=\"br0\">(</span><span class=\"br0\">)</span>.<span class=\"me1\">empty</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>map.<span class=\"me1\">values</span><span class=\"br0\">(</span><span class=\"br0\">)</span>.<span class=\"me1\">empty</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"co1\">// The default keys and values containers are std::vector:</span>\n    static_assert<span class=\"br0\">(</span><a href=\"/w/cpp/types/is_same\"><span class=\"kw592\">std::<span class=\"me2\">is_same_v</span></span></a><span class=\"sy1\">&lt;</span>decltype<span class=\"br0\">(</span>c.<span class=\"me1\">keys</span><span class=\"br0\">)</span>, <a href=\"/w/cpp/container/vector\"><span class=\"kw1277\">std::<span class=\"me2\">vector</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span><span class=\"sy1\">&gt;&gt;</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    static_assert<span class=\"br0\">(</span><a href=\"/w/cpp/types/is_same\"><span class=\"kw592\">std::<span class=\"me2\">is_same_v</span></span></a><span class=\"sy1\">&lt;</span>decltype<span class=\"br0\">(</span>c.<span class=\"me1\">value</span><span class=\"br0\">)</span>, <a href=\"/w/cpp/cont