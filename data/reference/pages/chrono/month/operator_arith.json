cpp\"><code><span class=\"co2\">#include &lt;chrono&gt;</span>\n<span class=\"co2\">#include &lt;iostream&gt;</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <a href=\"/w/cpp/io/manip/boolalpha\"><span class=\"kw1781\">std::<span class=\"me2\">boolalpha</span></span></a><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/chrono/month\"><span class=\"kw2621\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">month</span></span></a> m<span class=\"br0\">{</span><span class=\"nu0\">6</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    m <span class=\"sy2\">+</span><span class=\"sy1\">=</span> <a href=\"/w/cpp/chrono/duration\"><span class=\"kw1006\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">months</span></span></a><span class=\"br0\">(</span><span class=\"nu0\">2</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span>m <span class=\"sy1\">==</span> <a href=\"/w/cpp/chrono/month\"><span class=\"kw2621\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">month</span></span></a><span class=\"br0\">(</span><span class=\"nu0\">8</span><span class=\"br0\">)</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">' '</span>\n              <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span>m <span class=\"sy1\">==</span> <a href=\"/w/cpp/chrono/month\"><span class=\"kw2629\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">August</span></span></a><span class