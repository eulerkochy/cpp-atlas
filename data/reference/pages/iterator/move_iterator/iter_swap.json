\">make_move_iterator</span></span></a><span class=\"br0\">(</span>q.<span class=\"me1\">begin</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"sy2\">*</span>x <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">' '</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"sy2\">*</span>y <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n&nbsp;\n    iter_swap<span class=\"br0\">(</span>x, y<span class=\"br0\">)</span><span class=\"sy4\">;</span> <span class=\"co1\">// ADL</span>\n&nbsp;\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"sy2\">*</span>x <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">' '</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"sy2\">*</span>y <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre data-output=\"1\"><code>AA ⱯⱯ\nⱯⱯ AA</code></pre> \n</div>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/algorithm/swap\"> <span class=\"t-lines\"><span>swap</span></span></a></div></div>\n</td>\n<td>  swaps the values of two objects <br> <span class=\"t-mark\">(function template)</span> </td></tr>\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/algorithm/swap_ranges\"> <span class=\"t-lines\"><span>swap_ranges</span></span></a></div></div>\n</td>\n<td>  swaps two ranges of elements <br> <span class=\"t-mark\">(function template)</span> </td></tr>\n<tr class=\"t