<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"task_lambda:<span class=\"es1\">\\t</span>\"</span> <span class=\"sy1\">&lt;&lt;</span> result.<span class=\"me1\">get</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span>\n&nbsp;\n<span class=\"kw4\">void</span> task_bind<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    std<span class=\"sy4\">::</span><span class=\"me2\">packaged_task</span><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy1\">&gt;</span> task<span class=\"br0\">(</span><a href=\"/w/cpp/utility/functional/bind\"><span class=\"kw1059\">std::<span class=\"me2\">bind</span></span></a><span class=\"br0\">(</span>f, <span class=\"nu0\">2</span>, <span class=\"nu0\">11</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/thread/future\"><span class=\"kw2201\">std::<span class=\"me2\">future</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span><span class=\"sy1\">&gt;</span> result <span class=\"sy1\">=</span> task.<span class=\"me1\">get_future</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    task<span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"task_bind:<span class=\"es1\">\\t</span>\"</span> <span class=\"sy1\">&lt;&lt;</span> result.<span class=\"me1\">get</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span>\n&nbsp;\n<span class=\"kw4\">void</span> task_thread<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    std<span class=\"sy4\">::</span><span class=\"me2\">packaged_task</span><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span><span class=\"br0\">(</span><span class=\"kw4\">int</span>, <span class=\"kw4\">int</span><span class=\"br0\">)</span><span class=\"sy1\">&gt;</span> task<span class=\"br0\">(</span>f<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/thread/future\"><span class=\"kw2201\">std::<span class=\"me2\">future</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span><span class=\"sy1\">&gt;</span> result <span class=\"sy1\">=</span> task.<span class=\"me1\">get_future</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/thread/thread\"><span class=\"kw2167\">std::<span class=\"me2\">thread</span></span></a> task_td<span class=\"br0\">(</span>std<span class=\"sy4\">::</span><span class=\"me2\">move</span><span class=\"br0\">(</span>task<span class=\"br0\">)</span>, <span class=\"nu0\">2</span>, <span class=\"nu0\">10</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    task_td.<span class=\"me1\">join</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"task_thread:<span class=\"es1\">\\t</span>\"</span> <span class=\"sy1\">&lt;&lt;</span> result.<span class=\"me1\">get</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</spa