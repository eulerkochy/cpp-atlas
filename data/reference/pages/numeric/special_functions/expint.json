an class=\"sy1\">=</span> <span class=\"nu0\">0</span> <span class=\"sy4\">:</span> q <span class=\"sy1\">==</span> h <span class=\"sy4\">?</span> d<span class=\"br0\">[</span><span class=\"nu0\">2</span><span class=\"br0\">]</span> <span class=\"sy2\">-</span><span class=\"sy1\">=</span> <span class=\"br0\">(</span><span class=\"nu0\">7</span> <span class=\"sy2\">-</span> r<span class=\"br0\">)</span> <span class=\"sy4\">:</span> <span class=\"nu0\">0</span><span class=\"sy4\">;</span>\n            cout_n<span class=\"br0\">(</span>d, BarWidth<span class=\"br0\">)</span>, cout_n<span class=\"br0\">(</span><span class=\"st0\">' '</span>, Padding<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n        <span class=\"br0\">}</span>\n&nbsp;\n        <span class=\"kw1\">if</span> <span class=\"br0\">(</span>DrawMinMax <span class=\"sy3\">&amp;&amp;</span> Height <span class=\"sy1\">&gt;</span> <span class=\"nu0\">1</span><span class=\"br0\">)</span>\n            Height <span class=\"sy2\">-</span> <span class=\"nu0\">1</span> <span class=\"sy1\">==</span> h <span class=\"sy4\">?</span> <a href=\"/w/cpp/io/cout\"><span class=\"kw1772\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"┬ \"</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"sy2\">*</span>max<span class=\"sy4\">:</span>\n                          h <span class=\"sy4\">?</span> <a href=\"/w/cpp/io/cout\"><span class=\"kw1772\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"│ \"</span>\n                            <span class=\"sy4\">:</span> <a href=\"/w/cpp/io/cout\"><span class=\"kw1772\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"┴ \"</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"sy2\">*</span>min<span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n<span class=\"br0\">}</span>\n&nbsp;\n<span cl