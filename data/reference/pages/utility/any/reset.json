an><span class=\"sy4\">;</span>\n    a.<span class=\"me1\">reset</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>not a.<span class=\"me1\">has_value</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n</div>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/utility/any/has_value\"> <span class=\"t-lines\"><span>has_value</span></span></a></div></div>\n</td>\n<td>  checks if object holds a value <br> <span class=\"t-mark\">(public member function)</span> </td></tr>\n</table>","headings":[{"depth":3,"text":"Parameters","id":"Parameters"},{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Example","id":"Example"},{"depth":3,"text":"See also","id":"See_also"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"utility","title":"Utility library"},{"path":"utility/any","title":"std::any"}],"children":[],"map":{"label":"std::any::reset","children":[{"label":"Declarations","note":"1 declaration; revisions: since C++17. If *this contains a value, destroys the contained value."},{"label":"Parameters","note":"(none)"},{"label":"Return value","note":"(none)"},{"label":"Example"},{"label":"See also","children":[{"label":"has_value","note":"checks if object holds a value"}]}]},"standards":["C++17"],"wordCount":55,"codeBlockCount":1}
