"><span class=\"kw2\">false</span></span></code>.\n</p>\n<h3 id=\"Example\">Example</h3>\n<div class=\"t-example\">\n<pre data-lang=\"cpp\"><code><span class=\"co2\">#include &lt;chrono&gt;</span>\n<span class=\"co2\">#include &lt;iomanip&gt;</span>\n<span class=\"co2\">#include &lt;iostream&gt;</span>\n<span class=\"co2\">#include &lt;locale&gt;</span>\n<span class=\"co2\">#include &lt;string&gt;</span>\n&nbsp;\n<span class=\"kw1\">struct</span> weekday_ok <span class=\"sy4\">:</span> <a href=\"/w/cpp/locale/numpunct\"><span class=\"kw1978\">std::<span class=\"me2\">numpunct</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">char</span><span class=\"sy1\">&gt;</span>\n<span class=\"br0\">{</span>\n    <a href=\"/w/cpp/string/basic_string\"><span class=\"kw1238\">std::<span class=\"me2\">string</span></span></a> do_truename<span class=\"br0\">(</span><span class=\"br0\">)</span>  <span class=\"kw4\">const</span> override <span class=\"br0\">{</span> <span class=\"kw1\">return</span> <span class=\"st0\">\" (is valid weekday)\"</span><span class=\"sy4\">;</span> <span class=\"br0\">}</span>\n    <a href=\"/w/cpp/string/basic_string\"><span class=\"kw1238\">std::<span class=\"me2\">string</span></span></a> do_falsename<span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"kw4\">const</span> override <span class=\"br0\">{</span> <span class=\"kw1\">return</span> <span class=\"st0\">\" (is not valid weekday)\"</span><span class=\"sy4\">;</span> <span class=\"br0\">}</span>\n<span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a>.<span class=\"me1\">imbue</span><span class=\"br0\">(</span><a href=\"/w/cpp/locale/locale\"><span class=\"kw1911\">std::<span class=\"me2\">locale</span></span></a><span class=\"br0