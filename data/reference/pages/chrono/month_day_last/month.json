</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <a href=\"/w/cpp/io/manip/boolalpha\"><span class=\"kw1781\">std::<span class=\"me2\">boolalpha</span></span></a><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw4\">auto</span> mdl<span class=\"br0\">{</span>February<span class=\"sy2\">/</span>last<span class=\"br0\">}</span><span class=\"sy4\">;</span> <span class=\"co1\">// Last day of a February</span>\n    <span class=\"kw4\">auto</span> ymdl<span class=\"br0\">{</span>year<span class=\"br0\">(</span><span class=\"nu0\">2020</span><span class=\"br0\">)</span> <span class=\"sy2\">/</span> mdl<span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span>year_month_day<span class=\"br0\">{</span>ymdl<span class=\"br0\">}</span> <span class=\"sy1\">==</span> year_month_day<span class=\"br0\">{</span>February<span class=\"sy2\">/</span><span class=\"nu0\">29</span><span class=\"sy2\">/</span><span class=\"nu0\">2020</span><span class=\"br0\">}</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">' '</span><span class=\"sy4\">;</span>\n&nbsp;\n    mdl <span class=\"sy1\">=</span> <span class=\"br0\">(</span>mdl.<span class=\"me1\">month</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy2\">+</span> months<span class=\"br0\">(</span><span class=\"nu0\">1</span><span class=\"br0\">)</span><span class=\"br0\">)</span> <span class=\"sy2\">/</span> last<span class=\"sy4\">;</span> <span class=\"co1\">// Last day of the next month, in 2020</span>\n    ymdl <span class=\"sy1\">=</span> year<span class=\"br0\">(</span><span class=\"nu0\">2020</span><span class=\"br0\">)</span> <span class=\"sy2\">/</span> mdl<span class=\"sy4\">;</span>\n    <a hr