cts the result from the underlying iterator.</div>\n<h3 id=\"Parameters\">Parameters</h3>\n<p>(none)\n</p>\n<h3 id=\"Return_value\">Return value</h3>\n<div class=\"t-li1\"><span class=\"t-li\">1)</span> A reference to the underlying iterator.</div>\n<div class=\"t-li1\"><span class=\"t-li\">2)</span> An iterator move constructed from the underlying iterator.</div>\n<h3 id=\"Example\">Example</h3>\n<div class=\"t-example\">\n<pre data-lang=\"cpp\"><code><span class=\"co2\">#include &lt;algorithm&gt;</span>\n<span class=\"co2\">#include &lt;iostream&gt;</span>\n<span class=\"co2\">#include &lt;iterator&gt;</span>\n<span class=\"co2\">#include &lt;ranges&gt;</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <span class=\"kw4\">const</span> <span class=\"kw4\">auto</span> v <span class=\"sy1\">=</span> <span class=\"br0\">{</span> <span class=\"nu0\">0</span>, <span class=\"nu0\">1</span>, <span class=\"nu0\">2</span>, <span class=\"nu0\">3</span>, <span class=\"nu0\">4</span> <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <span class=\"kw4\">auto</span> x2 <span class=\"sy1\">=</span> <span class=\"br0\">[</span><span class=\"br0\">]</span><span class=\"br0\">(</span><span class=\"kw4\">int</span> x<span class=\"br0\">)</span> <span class=\"br0\">{</span> <span class=\"kw1\">return</span> x <span class=\"sy1\">&lt;&lt;</span> <span class=\"nu0\">1</span><span class=\"sy4\">;</span> <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    std<span class=\"sy4\">::</span><a href=\"/w/cpp/ranges/transform_view\"><span class=\"kw2939\">ranges::<span class=\"me2\">transform_view</span></span></a> tv<span class=\"br0\">{</span> v, x2 <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/iterator/ostream_iterator\"><span class=\"kw675\">std::<span class=\"me2\">ostream_iterator</span></span></a><span class=\"sy1\">&lt;</span><span class=\"k