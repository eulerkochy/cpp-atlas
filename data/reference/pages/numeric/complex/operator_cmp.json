 class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <span class=\"kw1\">using</span> std<span class=\"sy4\">::</span><span class=\"me2\">operator</span><span class=\"st0\">\"\"</span>i<span class=\"sy4\">;</span> <span class=\"co1\">// or: using namespace std::complex_literals;</span>\n&nbsp;\n    static_assert<span class=\"br0\">(</span>1.0i <span class=\"sy1\">==</span> 1.0i<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    static_assert<span class=\"br0\">(</span>2.0i <span class=\"sy3\">!</span><span class=\"sy1\">=</span> 1.0i<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw4\">constexpr</span> <a href=\"/w/cpp/numeric/complex\"><span class=\"kw1480\">std::<span class=\"me2\">complex</span></span></a> z<span class=\"br0\">(</span><span class=\"nu16\">1.0</span>, <span class=\"nu16\">0.0</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    static_assert<span class=\"br0\">(</span>z <span class=\"sy1\">==</span> <span class=\"nu16\">1.0</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    static_assert<span class=\"br0\">(</span><span class=\"nu16\">1.0</span> <span class=\"sy1\">==</span> z<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    static_assert<span class=\"br0\">(</span><span class=\"nu16\">2.0</span> <span class=\"sy3\">!</span><span class=\"sy1\">=</span> z<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    static_assert<span class=\"br0\">(</span>z <span class=\"sy3\">!</span><span class=\"sy1\">=</span> <span class=\"nu16\">2.0</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n</div>","headings":[{"depth":3,"text":"Parameters","id":"Parameters"},{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Example","id":"Example"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"numeric","title":"Numerics library"},{"path":"numeric/comple