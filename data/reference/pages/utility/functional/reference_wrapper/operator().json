ss=\"br0\">{</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"bind expression called with \"</span> <span class=\"sy1\">&lt;&lt;</span> n <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\" as the argument<span class=\"es1\">\\n</span>\"</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <a href=\"/w/cpp/utility/functional/reference_wrapper\"><span class=\"kw1075\">std::<span class=\"me2\">reference_wrapper</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">void</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy1\">&gt;</span> ref1 <span class=\"sy1\">=</span> <a href=\"/w/cpp/utility/functional/ref\"><span class=\"kw1076\">std::<span class=\"me2\">ref</span></span></a><span class=\"br0\">(</span>f1<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    ref1<span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw4\">auto</span> b <span class=\"sy1\">=</span> <a href=\"/w/cpp/utility/functional/bind\"><span class=\"kw1059\">std::<span class=\"me2\">bind</span></span></a><span class=\"br0\">(</span>f2, std<span class=\"sy4\">::</span><span class=\"me2\">placeholders</span><span class=\"sy4\">::</span>_1<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"kw4\">auto</span> ref2 <span class=\"sy1\">=</span> <a href=\"/w/cpp/utility/functional/ref\"><span class=\"kw1076\">std::<span class=\"me2\">ref</span></span></a><span class=\"br0\">(</span>b<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    ref2<span class=\"br0\">(</span><span class=\"nu0\">7</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw4\">auto</span> c <sp