 class=\"sy1\">&gt;</span> <span class=\"sy1\">==</span> <span class=\"nu0\">4</span><span class=\"br0\">)</span><span class=\"sy4\">;</span> <span class=\"co1\">// array size</span>\n&nbsp;\n    <span class=\"br0\">[</span><span class=\"br0\">[</span>maybe_unused<span class=\"br0\">]</span><span class=\"br0\">]</span> <span class=\"kw4\">int</span> ary<span class=\"br0\">[</span><span class=\"br0\">]</span><span class=\"br0\">[</span><span class=\"nu0\">3</span><span class=\"br0\">]</span> <span class=\"sy1\">=</span> <span class=\"br0\">{</span><span class=\"br0\">{</span><span class=\"nu0\">1</span>, <span class=\"nu0\">2</span>, <span class=\"nu0\">3</span><span class=\"br0\">}</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"co1\">// ary[0] is of type reference to 'int[3]', so, the extent</span>\n    <span class=\"co1\">// cannot be calculated correctly and it returns 0</span>\n    static_assert<span class=\"br0\">(</span><a href=\"/w/cpp/types/is_same\"><span class=\"kw590\">std::<span class=\"me2\">is_same_v</span></span></a><span class=\"sy1\">&lt;</span>decltype<span class=\"br0\">(</span>ary<span class=\"br0\">[</span><span class=\"nu0\">0</span><span class=\"br0\">]</span><span class=\"br0\">)</span>, <span class=\"kw4\">int</span><span class=\"br0\">(</span><span class=\"sy3\">&amp;</span><span class=\"br0\">)</span><span class=\"br0\">[</span><span class=\"nu0\">3</span><span class=\"br0\">]</span><span class=\"sy1\">&gt;</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    static_assert<span class=\"br0\">(</span>std<span class=\"sy4\">::</span><span class=\"me2\">extent_v</span><span class=\"sy1\">&lt;</span>decltype<span class=\"br0\">(</span>ary<span class=\"br0\">[</span><span class=\"nu0\">0</span><span class=\"br0\">]</span><span class=\"br0\">)</span><span class=\"sy1\">&gt;</span> <span class=\"sy1\">==</span> <span class=\"nu0\">0</span><span class=\"br0\">)</span><span class=\"sy4\">;</s