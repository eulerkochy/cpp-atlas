pan class=\"br0\">(</span>\n    <span class=\"kw4\">const</span> <a href=\"/w/cpp/utility/source_location\"><span class=\"kw3634\">std::<span class=\"me2\">source_location</span></span></a><span class=\"sy3\">&amp;</span> location <span class=\"sy1\">=</span> std<span class=\"sy4\">::</span><span class=\"me2\">source_location</span><span class=\"sy4\">::</span><span class=\"me2\">current</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <a href=\"/w/cpp/io/c/puts\"><span class=\"kw1847\">std::<span class=\"me2\">puts</span></span></a><span class=\"br0\">(</span>location.<span class=\"me1\">function_name</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span> <span class=\"co1\">// prints the name of the caller</span>\n<span class=\"br0\">}</span>\n&nbsp;\n<span class=\"kw4\">void</span> foo<span class=\"br0\">(</span><span class=\"kw4\">double</span> <span class=\"sy3\">&amp;&amp;</span><span class=\"br0\">)</span> <span class=\"br0\">{</span> print_function_name<span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span> <span class=\"br0\">}</span>\n&nbsp;\n<span class=\"kw1\">namespace</span> bar <span class=\"br0\">{</span> <span class=\"kw4\">void</span> baz<span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"br0\">{</span> print_function_name<span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span> <span class=\"br0\">}</span> <span class=\"br0\">}</span>\n&nbsp;\n<span class=\"kw1\">template</span> <span class=\"sy1\">&lt;</span><span class=\"kw1\">typename</span> T<span class=\"sy1\">&gt;</span> <span class=\"kw4\">auto</span> pub<span class=\"br0\">(</span>T<span class=\"br0\">)</span> <span class=\"br0\">{</span> print_function_name<span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span> <span class=\"kw1\">return</span> <sp