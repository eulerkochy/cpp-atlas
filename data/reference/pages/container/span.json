<span class=\"kw1\">return</span> data.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">&gt;=</span> prefix.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span>\n        <span class=\"sy3\">&amp;&amp;</span> <a href=\"/w/cpp/algorithm/equal\"><span class=\"kw1585\">std::<span class=\"me2\">equal</span></span></a><span class=\"br0\">(</span>prefix.<span class=\"me1\">begin</span><span class=\"br0\">(</span><span class=\"br0\">)</span>, prefix.<span class=\"me1\">end</span><span class=\"br0\">(</span><span class=\"br0\">)</span>, data.<span class=\"me1\">begin</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span>\n&nbsp;\n<span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span><span class=\"kw1\">class</span> T, <a href=\"/w/cpp/types/size_t\"><span class=\"kw107\">std::<span class=\"me2\">size_t</span></span></a> N, <a href=\"/w/cpp/types/size_t\"><span class=\"kw107\">std::<span class=\"me2\">size_t</span></span></a> M<span class=\"sy1\">&gt;</span>\n<span class=\"kw4\">constexpr</span> <span class=\"kw4\">bool</span> ends_with<span class=\"br0\">(</span>std<span class=\"sy4\">::</span><span class=\"me2\">span</span><span class=\"sy1\">&lt;</span>T, N<span class=\"sy1\">&gt;</span> data, std<span class=\"sy4\">::</span><span class=\"me2\">span</span><span class=\"sy1\">&lt;</span>T, M<span class=\"sy1\">&gt;</span> suffix<span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <span class=\"kw1\">return</span> data.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">&gt;=</span> suffix.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span>\n        <span class=\"sy3\">&amp;&amp;</span> <a href=\"/w/cpp/algorithm/equal\"><span class=\"kw1585\">std::<span class=\"me2\">equal</sp