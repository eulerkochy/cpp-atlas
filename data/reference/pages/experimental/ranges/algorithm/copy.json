span class=\"me2\">experimental</span><span class=\"sy4\">::</span><span class=\"me2\">ranges</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/container/vector\"><span class=\"kw1277\">std::<span class=\"me2\">vector</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span><span class=\"sy1\">&gt;</span> from_vector<span class=\"br0\">(</span><span class=\"nu0\">10</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/algorithm/iota\"><span class=\"kw1667\">std::<span class=\"me2\">iota</span></span></a><span class=\"br0\">(</span>from_vector.<span class=\"me1\">begin</span><span class=\"br0\">(</span><span class=\"br0\">)</span>, from_vector.<span class=\"me1\">end</span><span class=\"br0\">(</span><span class=\"br0\">)</span>, <span class=\"nu0\">0</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/container/vector\"><span class=\"kw1277\">std::<span class=\"me2\">vector</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span><span class=\"sy1\">&gt;</span> to_vector<span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/experimental/ranges/algorithm/copy\"><span class=\"kw2869\">ranges::<span class=\"me2\">copy_if</span></span></a><span class=\"br0\">(</span>from_vector.<span class=\"me1\">begin</span><span class=\"br0\">(</span><span class=\"br0\">)</span>, from_vector.<span class=\"me1\">end</span><span class=\"br0\">(</span><span class=\"br0\">)</span>,\n                    ranges<span class=\"sy4\">::</span><span class=\"me2\">back_inserter</span><span class=\"br0\">(</span>to_vector<span class=\"br0\">)</span>,\n                    <span class=\"br0\">[</span><span class=\"br0\">]</span><span class=\"br0\">(</span><span class=\"kw4\">const</span> <span class=\"kw4\">auto</span> i<span class=\"br0\">)</span>\n                    <span class=\"br0\">{</span>\n                       <span class=\"kw1\">return</span> i <span class=\"sy2\