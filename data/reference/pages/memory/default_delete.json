default_delete object"},{"label":"operator()","note":"deletes the object or array"}]},{"label":"std::default_delete::default_delete","note":"Constructs a std::default_delete object.","children":[{"label":"Parameters","note":"d"},{"label":"Notes","note":"The converting constructor template of std::default_delete makes possible the implicit conversion from std::unique_ptr<Derived> to std::unique_ptr<Base>."}]},{"label":"std::default_delete::operator()","note":"Calls delete on ptr.","children":[{"label":"Parameters","note":"ptr"},{"label":"Exceptions","note":"No exception guarantees."},{"label":"Invoking over Incomplete Types","note":"At the point in the code the operator() is called, the type must be complete. In some implementations a static_assert is used to make sure this is the case."},{"label":"Notes"},{"label":"Example"},{"label":"Defect reports","note":"The following behavior-changing defect reports were applied retroactively to previously published C++ standards."},{"label":"See also"}]}]},"standards":["C++11","C++23"],"wordCount":519,"codeBlockCount":1}
