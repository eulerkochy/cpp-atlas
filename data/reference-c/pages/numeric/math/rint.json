cl","note":"rounds to nearest integer not greater in magnitude than the given value"},{"label":"nearbyint, nearbyintf, nearbyintl","note":"rounds to an integer using current rounding mode"},{"label":"fegetround, fesetround","note":"gets or sets rounding direction"}]}]},"standards":["C99"],"wordCount":910,"codeBlockCount":2}
