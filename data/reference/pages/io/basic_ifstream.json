le for reading</span>\n    std<span class=\"sy4\">::</span><span class=\"me2\">ifstream</span> istrm<span class=\"br0\">(</span>filename, std<span class=\"sy4\">::</span><span class=\"me2\">ios</span><span class=\"sy4\">::</span><span class=\"me2\">binary</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"kw1\">if</span> <span class=\"br0\">(</span><span class=\"sy3\">!</span>istrm.<span class=\"me1\">is_open</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span>\n        <a href=\"/w/cpp/io/cout\"><span class=\"kw1772\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"failed to open \"</span> <span class=\"sy1\">&lt;&lt;</span> filename <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n    <span class=\"kw1\">else</span>\n    <span class=\"br0\">{</span>\n        <span class=\"kw4\">double</span> d<span class=\"sy4\">;</span>\n        istrm.<span class=\"me1\">read</span><span class=\"br0\">(</span><span class=\"kw1\">reinterpret_cast</span><span class=\"sy1\">&lt;</span><span class=\"kw4\">char</span><span class=\"sy2\">*</span><span class=\"sy1\">&gt;</span><span class=\"br0\">(</span><span class=\"sy3\">&amp;</span>d<span class=\"br0\">)</span>, sizeof d<span class=\"br0\">)</span><span class=\"sy4\">;</span> <span class=\"co1\">// binary input</span>\n        <span class=\"kw4\">int</span> n<span class=\"sy4\">;</span>\n        <a href=\"/w/cpp/string/basic_string\"><span class=\"kw1238\">std::<span class=\"me2\">string</span></span></a> s<span class=\"sy4\">;</span>\n        <span class=\"kw1\">if</span> <span class=\"br0\">(</span>istrm <span class=\"sy1\">&gt;&gt;</span> n <span class=\"sy1\">&gt;&gt;</span> s<span class=\"br0\">)</span>                               <span class=\"co1\">// text input</span>\n            <a href=\"/w/cpp/io/cout\"><span class=\"kw1772\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"read back from file: \"</span> <span class=\"sy1\">&lt;&lt;</span> d <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">' '</span> <span class=\"sy1\">&lt;&lt;</span> n <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">' '</span> <span class=\"sy1\">&lt;&lt;</span> s <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre data-output=\"1\"><code>read back from file: 3.14 123 abc</code></pre> \n</div>","headings":[{"depth":3,"text":"Member types","id":"Member_types"},{"depth":3,"text":"Member functions","id":"Member_functions"},{"depth":3,"text":"Non-member functions","id":"Non-member_functions"},{"depth":2,"text":"Inherited from std::basic_istream","id":"Inherited_from_std::basic_istream"},{"depth":3,"text":"Member functions","id":"Member_functions_2"},{"depth":3,"text":"Member classes","id":"Member_classes"},{"depth":2,"text":"Inherited from std::basic_ios","id":"Inherited_from_std::basic_ios"},{"depth":3,"text":"Member types","id":"Member_types_2"},{"depth":3,"text":"Member functions","id":"Member_functions_3"},{"depth":2,"text":"Inherited from std::ios_base","id":"Inherited_from_std::ios_base"},{"depth":3,"text":"Member functions","id":"Member_functions_4"},{"depth":3,"text":"Notes","id":"Notes"},{"depth":3,"text":"Example","id":"Example"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"io","title":"Input/output library"}],"children":[{"path":"io/basic_ifstream/basic_ifstream","title":"std::basic_ifstream<CharT,Traits>::basic_ifstream"},{"path":"io/basic_ifstream/close","title":"std::basic_ifstream<CharT,Traits>::close"},{"path":"io/basic_ifstream/is_open","title":"std::basic_ifstream<CharT,Traits>::is_open"},{"path":"io/basic_ifstream/native_handle","title":"std