an class=\"sy4\">;</span> <span class=\"co1\">// (1) implicit conversion</span>\n        <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>s <span class=\"sy1\">==</span> sub.<span class=\"me1\">str</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>    <span class=\"co1\">// (2)</span>\n        <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> s <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre data-output=\"1\"><code>https://cppreference.com\nhttps\ncppreference\ncom</code></pre> \n</div>","headings":[{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Complexity","id":"Complexity"},{"depth":3,"text":"Example","id":"Example"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"regex","title":"Regular expressions library (since C++11)"},{"path":"regex/sub_match","title":"std::sub_match"}],"children":[],"map":{"label":"std::sub_match<BidirIt>::operator string_type, std::sub_match<BidirIt>::str","children":[{"label":"Declarations","note":"2 declarations. Converts to an object of the underlying std::basic_string type."},{"label":"Return value","note":"The matched character sequence as an object of the underlying std::basic_string type."},{"label":"Complexity","note":"Linear in the length of the underlying character sequence."},{"label":"Example"}]},"standards":[],"wordCount":117,"codeBlockCount":2}
