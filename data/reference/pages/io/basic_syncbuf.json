_streambuf&lt;CharT,Traits&gt;</code>)</span> </td></tr>\n<tr>\n<td colspan=\"2\"> <h5 id=\"Positioning\">Positioning </h5>\n</td></tr>\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/io/basic_streambuf/pubsetbuf\"> <span class=\"t-lines\"><span>pubsetbuf</span></span></a></div></div>\n</td>\n<td>  invokes <code class=\"t-c\"><span class=\"mw-geshi cpp source-cpp\">setbuf<span class=\"br0\">(</span><span class=\"br0\">)</span></span></code> <br> <span class=\"t-mark\">(public member function of <code>std::basic_streambuf&lt;CharT,Traits&gt;</code>)</span> </td></tr>\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/io/basic_streambuf/pubseekoff\"> <span class=\"t-lines\"><span>pubseekoff</span></span></a></div></div>\n</td>\n<td>  invokes <code class=\"t-c\"><span class=\"mw-geshi cpp source-cpp\">seekoff<span class=\"br0\">(</span><span class=\"br0\">)</span></span></code> <br> <span class=\"t-mark\">(public member function of <code>std::basic_streambuf&lt;CharT,Traits&gt;</code>)</span> </td></tr>\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/io/basic_streambuf/pubseekpos\"> <span class=\"t-lines\"><span>pubseekpos</span></span></a></div></div>\n</td>\n<td>  invokes <code class=\"t-c\"><span class=\"mw-geshi cpp source-cpp\">seekpos<span class=\"br0\">(</span><span class=\"br0\">)</span></span></code> <br> <span class=\"t-mark\">(public member function of <code>std::basic_streambuf&lt;CharT,Traits&gt;</code>)</span> </td></tr>\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/io/basic_streambuf/pubsync\"> <span class=\"t-lines\"><span>pubsync</span></span></a></div></div>\n</td>\n<td>  invokes <code class=\"t-c\"><span class=\"mw-geshi cpp source-cpp\">sync<span class=\"br0\">(</span><span class=\"br0\">)</span></span></code> <br> <span class=\"t-mark\">(public member function of <code>std::basic_streambuf&lt;CharT,Traits&gt;</c