\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    static_assert<span class=\"br0\">(</span><span class=\"nu0\">15891</span> <span class=\"sy1\">==</span> leap_years<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"There are \"</span> <span class=\"sy1\">&lt;&lt;</span> leap_years <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\" leap years in the range [\"</span>\n              <span class=\"sy1\">&lt;&lt;</span> <span class=\"kw4\">int</span><span class=\"br0\">(</span>year<span class=\"sy4\">::</span><span class=\"me2\">min</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\", \"</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"kw4\">int</span><span class=\"br0\">(</span>year<span class=\"sy4\">::</span><span class=\"me2\">max</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"].<span class=\"es1\">\\n</span>\"</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre data-output=\"1\"><code>There are 15891 leap years in the range [-32767, 32767].</code></pre> \n</div>","headings":[{"depth":3,"text":"Example","id":"Example"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"chrono","title":"Date and time utilities"},{"path":"chrono/year","title":"std::chrono::year"}],"children":[],"map":{"label":"std::chrono::year::year","children":[{"label":"Declarations","note":"2 declarations; revisions: since C++20. Constructs a year object."},{"label":"Example"}]},"standards":["C++20"],"wordCount":128,"codeBlockCount":2}
