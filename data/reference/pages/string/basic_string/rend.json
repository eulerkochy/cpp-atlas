/td>\n<td>  returns a reverse iterator to the beginning <br> <span class=\"t-mark\">(public member function)</span> </td></tr>\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/string/basic_string_view/rend\"> <span class=\"t-lines\"><span>rend</span><span>crend</span></span></a></div></div>\n</td>\n<td>  returns a reverse iterator to the end <br> <span class=\"t-mark\">(public member function of <code>std::basic_string_view&lt;CharT,Traits&gt;</code>)</span> </td></tr>\n</table>","headings":[{"depth":3,"text":"Parameters","id":"Parameters"},{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Complexity","id":"Complexity"},{"depth":3,"text":"Notes","id":"Notes"},{"depth":3,"text":"Example","id":"Example"},{"depth":3,"text":"See also","id":"See_also"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"string","title":"Strings library"},{"path":"string/basic_string","title":"std::basic_string"}],"children":[],"map":{"label":"std::basic_string<CharT,Traits,Allocator>::rend, std::basic_string<CharT,Traits,Allocator>::crend","children":[{"label":"Declarations","note":"3 declarations; revisions: since C++11. Returns a reverse iterator to the character following the last character of the reversed string."},{"label":"Parameters","note":"(none)"},{"label":"Return value","note":"Reverse iterator to the character following the last character."},{"label":"Complexity","note":"Constant."},{"label":"Notes","note":"libc++ backports crend() to C++98 mode."},{"label":"Example"},{"label":"See also","children":[{"label":"rbegin, crbegin","note":"returns a reverse iterator to the beginning"},{"label":"rend, crend","note":"returns a reverse iterator to the end"}]}]},"standards":["C++11","C++20"],"wordCount":185,"codeBlockCount":2}
