an><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    latch<span class=\"br0\">(</span><span class=\"kw4\">const</span> latch<span class=\"sy3\">&amp;</span><span class=\"br0\">)</span> <span class=\"sy1\">=</span> delete<span class=\"sy4\">;</span>\n    latch<span class=\"sy3\">&amp;</span> operator<span class=\"sy1\">=</span><span class=\"br0\">(</span><span class=\"kw4\">const</span> latch<span class=\"sy3\">&amp;</span><span class=\"br0\">)</span> <span class=\"sy1\">=</span> delete<span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw4\">void</span> count_down<span class=\"br0\">(</span>ptrdiff_t update <span class=\"sy1\">=</span> <span class=\"nu0\">1</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"kw4\">bool</span> try_wait<span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"kw4\">const</span> <span class=\"kw1\">noexcept</span><span class=\"sy4\">;</span>\n    <span class=\"kw4\">void</span> wait<span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"kw4\">const</span><span class=\"sy4\">;</span>\n    <span class=\"kw4\">void</span> arrive_and_wait<span class=\"br0\">(</span>ptrdiff_t update <span class=\"sy1\">=</span> <span class=\"nu0\">1</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n  <span class=\"kw1\">private</span><span class=\"sy4\">:</span>\n    ptrdiff_t counter<span class=\"sy4\">;</span>  <span class=\"co1\">// exposition only</span>\n  <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>","headings":[{"depth":3,"text":"Synopsis","id":"Synopsis"},{"depth":4,"text":"Class std::latch","id":"Class_std::latch"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"header","title":"C++ Standard Library headers"}],"children":[],"map":{"label":"Standard library header <latch> (C++20)","children":[{"label":"Classes","children":[{"label":"latch","note":"single-use thread barrier"}]},{"l