lass=\"kw4\">int</span><span class=\"br0\">(</span>x<span class=\"br0\">)</span> <span class=\"sy1\">&lt;=&gt;</span> <span class=\"kw4\">int</span><span class=\"br0\">(</span>y<span class=\"br0\">)</span></span></code></div>\n<h3 id=\"Example\">Example</h3>\n<div class=\"t-example\">\n<pre data-lang=\"cpp\"><code><span class=\"co2\">#include &lt;chrono&gt;</span>\n<span class=\"co2\">#include &lt;iostream&gt;</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <span class=\"kw1\">using</span> <span class=\"kw1\">namespace</span> std<span class=\"sy4\">::</span><span class=\"me2\">chrono</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw4\">constexpr</span> year y1<span class=\"br0\">{</span><span class=\"nu0\">2020</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <span class=\"kw4\">constexpr</span> year y2<span class=\"br0\">{</span><span class=\"nu0\">2021</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <a href=\"/w/cpp/io/manip/boolalpha\"><span class=\"kw1781\">std::<span class=\"me2\">boolalpha</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span>y1 <span class=\"sy3\">!</span><span class=\"sy1\">=</span> y2<span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n&nbsp;\n    static_assert<span class=\"br0\">(</span><span class=\"br0\">(</span>2020y <span class=\"sy1\">&lt;</span> 2023y<span class=\"br0\">)</span> <span class=\"sy3\">&amp;&amp;</span> <span class=\"br0\">(</span>2020y <span class=\"sy1\">==</span> 2020y<span class=\"br0\">)</span> <span class=\"sy3\">&amp;&amp;</span> <span class=\"br0\">(</span>2020y <span class=\"sy1\">&lt;=</span> 2023y<span class=\"br0\">)</span> <span class=\"sy3\">&amp;&amp;</span>\n                  <span class=\"br0\">(</span>2023y <span class=\"sy1\">&gt;</span> 2020y<span class=\"br0\">)</span> <span class=\"sy3\">&amp;&amp;</span> <span class=\"br0\">(</span>2023y <span class=\"sy3\">!</span><span class=\"sy1\">=</span> 2020y<span class=\"br0\">)</span> <span class=\"sy3\">&amp;&amp;</span> <span class=\"br0\">(</span>2023y <span class=\"sy1\">&gt;=</span> 2020y<span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre data-output=\"1\"><code>true</code></pre> \n</div>","headings":[{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Example","id":"Example"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"chrono","title":"Date and time utilities"},{"path":"chrono/year","title":"std::chrono::year"}],"children":[],"map":{"label":"std::chrono::operator==,<=>(std::chrono::year)","children":[{"label":"Declarations","note":"2 declarations; revisions: since C++20. Compare the two std::chrono::year x and y."},{"label":"Return value","note":"int(x) == int(y)"},{"label":"Example"}]},"standards":["C++20"],"wordCount":116,"codeBlockCount":2}
