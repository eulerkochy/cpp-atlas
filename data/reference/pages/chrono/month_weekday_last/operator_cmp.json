pan>\n&nbsp;\n    <span class=\"kw4\">constexpr</span> <a href=\"/w/cpp/chrono/month_weekday_last\"><span class=\"kw2605\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">month_weekday_last</span></span></a> mwdl2\n    <span class=\"br0\">{</span>\n        <a href=\"/w/cpp/chrono/month\"><span class=\"kw2624\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">March</span></span></a>, <a href=\"/w/cpp/chrono/weekday\"><span class=\"kw2581\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">Friday</span></span></a><span class=\"br0\">[</span><a href=\"/w/cpp/chrono/last_spec\"><span class=\"kw2561\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">last</span></span></a><span class=\"br0\">]</span>\n    <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n    static_assert<span class=\"br0\">(</span>mwdl1 <span class=\"sy1\">==</span> mwdl2<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n</div>","headings":[{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Example","id":"Example"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"chrono","title":"Date and time utilities"},{"path":"chrono/month_weekday_last","title":"std::chrono::month_weekday_last"}],"children":[],"map":{"label":"std::chrono::operator==(std::chrono::month_weekday_last)","children":[{"label":"Declarations","note":"1 declaration; revisions: since C++20. Compares the two month_weekday_last values x and y."},{"label":"Return value","note":"x.month() == y.month() && x.weekday_last() == y.weekday_last()"},{"label":"Example"}]},"standards":["C++20"],"wordCount":64,"codeBlockCount":1}
