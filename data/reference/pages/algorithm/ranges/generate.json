n class=\"sy1\">&lt;</span>R, <a href=\"/w/cpp/types/result_of\"><span class=\"kw3239\">std::<span class=\"me2\">invoke_result_t</span></span></a><span class=\"sy1\">&lt;</span>F<span class=\"sy3\">&amp;</span><span class=\"sy1\">&gt;&gt;</span>\n    <span class=\"kw4\">constexpr</span> <a href=\"/w/cpp/ranges/borrowed_iterator_t\"><span class=\"kw2873\">ranges::<span class=\"me2\">borrowed_iterator_t</span></span></a><span class=\"sy1\">&lt;</span>R<span class=\"sy1\">&gt;</span> operator<span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">(</span>R<span class=\"sy3\">&amp;&amp;</span> r, F gen<span class=\"br0\">)</span> <span class=\"kw4\">const</span>\n    <span class=\"br0\">{</span>\n        <span class=\"kw1\">return</span> <span class=\"br0\">(</span><span class=\"sy2\">*</span>this<span class=\"br0\">)</span><span class=\"br0\">(</span><a href=\"/w/cpp/ranges/begin\"><span class=\"kw2900\">ranges::<span class=\"me2\">begin</span></span></a><span class=\"br0\">(</span>r<span class=\"br0\">)</span>, <a href=\"/w/cpp/ranges/end\"><span class=\"kw2902\">ranges::<span class=\"me2\">end</span></span></a><span class=\"br0\">(</span>r<span class=\"br0\">)</span>, std<span class=\"sy4\">::</span><span class=\"me2\">move</span><span class=\"br0\">(</span>gen<span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n<span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n<span class=\"kw1\">inline</span> <span class=\"kw4\">constexpr</span> generate_fn generate <span class=\"br0\">{</span><span class=\"br0\">}</span><span class=\"sy4\">;</span></code></pre>\n</td></tr></table>\n<h3 id=\"Example\">Example</h3>\n<div class=\"t-example\">\n<pre data-lang=\"cpp\"><code><span class=\"co2\">#include &lt;algorithm&gt;</span>\n<span class=\"co2\">#include &lt;array&gt;</span>\n<span class=\"co2\">#include &lt;iostream&gt;</span>\n<span class=\"co2\">#include &lt;random&gt;</span>\n<s