70\">std::<span class=\"me2\">is_pointer_v</span></span></a><span class=\"sy1\">&lt;</span>From<span class=\"sy1\">&gt;</span> <span class=\"sy3\">&amp;&amp;</span> <a href=\"/w/cpp/types/is_pointer\"><span class=\"kw470\">std::<span class=\"me2\">is_pointer_v</span></span></a><span class=\"sy1\">&lt;</span>To<span class=\"sy1\">&gt;</span> <span class=\"sy3\">&amp;&amp;</span>\n        <span class=\"sy3\">!</span><a href=\"/w/cpp/concepts/convertible_to\"><span class=\"kw2952\">std::<span class=\"me2\">convertible_to</span></span></a><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/types/remove_pointer\"><span class=\"kw618\">std::<span class=\"me2\">remove_pointer_t</span></span></a><span class=\"sy1\">&lt;</span>From<span class=\"sy1\">&gt;</span><span class=\"br0\">(</span><span class=\"sy2\">*</span><span class=\"br0\">)</span><span class=\"br0\">[</span><span class=\"br0\">]</span>,\n                             <a href=\"/w/cpp/types/remove_pointer\"><span class=\"kw618\">std::<span class=\"me2\">remove_pointer_t</span></span></a><span class=\"sy1\">&lt;</span>To<span class=\"sy1\">&gt;</span><span class=\"br0\">(</span><span class=\"sy2\">*</span><span class=\"br0\">)</span><span class=\"br0\">[</span><span class=\"br0\">]</span><span class=\"sy1\">&gt;</span><span class=\"sy4\">;</span></code></pre></div>\n<div class=\"t-li1\"><span class=\"t-li\">3)</span> Determines whether <code>From</code> is convertible to <code>To</code> without derived-to-base conversion:\n<pre data-lang=\"cpp\"><code><span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span><span class=\"kw1\">class</span> From, <span class=\"kw1\">class</span> To<span class=\"sy1\">&gt;</span>\nconcept <span class=\"coMULTI\">/*convertible-to-non-slicing*/</span> <span class=\"sy1\">=</span>\n    <a href=\"/w/cpp/concepts/convertible_to\"><span class=\"kw2952\">std::<span class=\"me2\">convertible_to</span></span></a><span class=\"sy1\">&lt;</span>From, To<span class=\"sy1\">&gt;</span> <spa