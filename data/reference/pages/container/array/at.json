u0\">2</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"data size = \"</span> <span class=\"sy1\">&lt;&lt;</span> data.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw1\">try</span>\n    <span class=\"br0\">{</span>\n        <span class=\"co1\">// Try to set an element at random position &gt;= size()</span>\n        <span class=\"kw4\">auto</span> moon_phase <span class=\"sy1\">=</span> <span class=\"br0\">[</span><span class=\"br0\">]</span>\n        <span class=\"br0\">{</span>\n            <span class=\"kw1\">return</span> <a href=\"/w/cpp/chrono/system_clock/now\"><span class=\"kw2693\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">system_clock</span><span class=\"sy4\">::</span><span class=\"me2\">now</span></span></a><span class=\"br0\">(</span><span class=\"br0\">)</span>.<span class=\"me1\">time_since_epoch</span><span class=\"br0\">(</span><span class=\"br0\">)</span>.<span class=\"me1\">count</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy2\">%</span> <span class=\"nu0\">8</span><span class=\"sy4\">;</span>\n        <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n        data.<span class=\"me1\">at</span><span class=\"br0\">(</span>data.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy2\">+</span> moon_phase<span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span> <span class=\"sy1\">=</span> <span class=\"nu0\">13</span><span clas