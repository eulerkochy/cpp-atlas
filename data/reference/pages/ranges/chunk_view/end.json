nt to:\n<pre data-lang=\"cpp\"><code><span class=\"kw1\">if</span> <span class=\"kw4\">constexpr</span> <span class=\"br0\">(</span><a href=\"/w/cpp/ranges/common_range\"><span class=\"kw2926\">ranges::<span class=\"me2\">common_range</span></span></a><span class=\"sy1\">&lt;</span>V<span class=\"sy1\">&gt;</span> <span class=\"sy3\">&amp;&amp;</span> <a href=\"/w/cpp/ranges/sized_range\"><span class=\"kw2918\">ranges::<span class=\"me2\">sized_range</span></span></a><span class=\"sy1\">&lt;</span>V<span class=\"sy1\">&gt;</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <span class=\"kw4\">auto</span> missing <span class=\"sy1\">=</span> <span class=\"br0\">(</span>n_ <span class=\"sy2\">-</span> <a href=\"/w/cpp/iterator/ranges/distance\"><span class=\"kw3160\">ranges::<span class=\"me2\">distance</span></span></a><span class=\"br0\">(</span>base_<span class=\"br0\">)</span> <span class=\"sy2\">%</span> n_<span class=\"br0\">)</span> <span class=\"sy2\">%</span> n_<span class=\"sy4\">;</span>\n    <span class=\"kw1\">return</span> iterator<span class=\"sy1\">&lt;</span><span class=\"kw2\">false</span><span class=\"sy1\">&gt;</span><span class=\"br0\">(</span>this, <a href=\"/w/cpp/ranges/end\"><span class=\"kw2902\">ranges::<span class=\"me2\">end</span></span></a><span class=\"br0\">(</span>base_<span class=\"br0\">)</span>, missing<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span>\n<span class=\"kw1\">else</span> <span class=\"kw1\">if</span> <span class=\"kw4\">constexpr</span> <span class=\"br0\">(</span><a href=\"/w/cpp/ranges/common_range\"><span class=\"kw2926\">ranges::<span class=\"me2\">common_range</span></span></a><span class=\"sy1\">&lt;</span>V<span class=\"sy1\">&gt;</span> <span class=\"sy3\">&amp;&amp;</span> <span class=\"sy3\">!</span><a href=\"/w/cpp/ranges/bidirectional_range\"><span class=\"kw2923\">ranges::<span class=\"me2\">bidirectional_range</span></span></a><span class=\"sy1\">&lt