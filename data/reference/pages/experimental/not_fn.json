span class=\"br0\">(</span>f, <a href=\"/w/cpp/utility/forward\"><span class=\"kw1125\">std::<span class=\"me2\">forward</span></span></a><span class=\"sy1\">&lt;</span>Args<span class=\"sy1\">&gt;</span><span class=\"br0\">(</span>args<span class=\"br0\">)</span>...<span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"br0\">)</span>\n            <span class=\"sy2\">-</span><span class=\"sy1\">&gt;</span> decltype<span class=\"br0\">(</span><span class=\"sy3\">!</span><a href=\"/w/cpp/utility/functional/invoke\"><span class=\"kw1065\">std::<span class=\"me2\">invoke</span></span></a><span class=\"br0\">(</span>f, <a href=\"/w/cpp/utility/forward\"><span class=\"kw1125\">std::<span class=\"me2\">forward</span></span></a><span class=\"sy1\">&lt;</span>Args<span class=\"sy1\">&gt;</span><span class=\"br0\">(</span>args<span class=\"br0\">)</span>...<span class=\"br0\">)</span><span class=\"br0\">)</span> <span class=\"br0\">{</span>\n            <span class=\"kw1\">return</span> <span class=\"sy3\">!</span><a href=\"/w/cpp/utility/functional/invoke\"><span class=\"kw1065\">std::<span class=\"me2\">invoke</span></span></a><span class=\"br0\">(</span>f, <a href=\"/w/cpp/utility/forward\"><span class=\"kw1125\">std::<span class=\"me2\">forward</span></span></a><span class=\"sy1\">&lt;</span>Args<span class=\"sy1\">&gt;</span><span class=\"br0\">(</span>args<span class=\"br0\">)</span>...<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n        <span class=\"br0\">}</span>\n    <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span>\n&nbsp;\n<span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span><span class=\"kw1\">class</span> F<span class=\"sy1\">&gt;</span>\ndetail<span class=\"sy4\">::</span><span class=\"me2\">not_fn_t</span><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/types/decay\"><span class=\"kw634\">std::<span class=\"me2\">decay_t</span></span></a><span class=\"sy1\">&lt;</span>F<span class=\"sy1\">&gt;&gt;</span> not_fn<span class=\"br0\">(</span>F<span class=\"sy3\">&amp;&amp;</span> f<span class=\"br0\">)</span> <span class=\"br0\">{</span> <span class=\"kw1\">return</span> <span class=\"br0\">{</span> <a href=\"/w/cpp/utility/forward\"><span class=\"kw1125\">std::<span class=\"me2\">forward</span></span></a><span class=\"sy1\">&lt;</span>F<span class=\"sy1\">&gt;</span><span class=\"br0\">(</span>f<span class=\"br0\">)</span> <span class=\"br0\">}</span><span class=\"sy4\">;</span> <span class=\"br0\">}</span></code></pre>\n</td></tr></table>\n<h3 id=\"Notes\">Notes </h3>\n<p><code>not_fn</code> is intended to replace the C++03-era negators <span class=\"t-lc\"><a href=\"/w/cpp/utility/functional/not1\">std::not1</a></span> and <span class=\"t-lc\"><a href=\"/w/cpp/utility/functional/not2\">std::not2</a></span>.\n</p>\n<h3 id=\"See_also\">See also </h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/utility/functional/not_fn\"> <span class=\"t-lines\"><span>not_fn</span></span></a></div><div><span class=\"t-lines\"><span><span class=\"t-mark-rev t-since-cxx17\">(C++17)</span></span></span></div></div>\n</td>\n<td>  creates a function object that returns the complement of the result of the function object it holds <br> <span class=\"t-mark\">(function template)</span> </td></tr>\n</table>","headings":[{"depth":3,"text":"Parameters","id":"Parameters"},{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Remarks","id":"Remarks"},{"depth":3,"text":"Exceptions","id":"Exceptions"},{"depth":3,"text":"Possible implementation","id":"Possible_implementation"},{"depth":3,"text":"Notes","id":"Notes"},{"depth":3,"text":"See also","id":"See_also"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"experimental","title":"Experimental C++ Features"}],"children":[],"map":{"label":"std::experimental::not_fn","children":[{"label":"Declarations","note":"1 declaration. Creates a forwarding call wrapper that returns the complement of the callable object it holds."},{"label":"Parameters","note":"f"},{"label":"Return value","note":"Let FD be std::decay_t<F> and fd be an lvalue of type FD constructed from std::forward<F>(f)."},{"label":"Remarks","note":"If fd is not Callable, or std::is_constructible<FD, F>::value is not true, the behavior is undefined."},{"label":"Exceptions","note":"Throws no exceptions, unless the construction of fd throws."},{"label":"Possible implementation"},{"label":"Notes","note":"not_fn is intended to replace the C++03-era negators std::not1 and std::not2."},{"label":"See also","children":[{"label":"not_fn","note":"creates a function object that returns the complement of the result of the function object it holds"}]}]},"standards":["C++17"],"wordCount":262,"codeBlockCount":1}
