48\">printf</span></a><span class=\"br0\">(</span><span class=\"st0\">\"lround(LONG_MAX+1.5) =&nbsp;%ld<span class=\"es1\">\\n</span>\"</span>, lround<span class=\"br0\">(</span><a href=\"/w/c/types/limits\"><span class=\"kw365\">LONG_MAX</span></a> <span class=\"sy2\">+</span> <span class=\"nu16\">1.5</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"kw1\">if</span> <span class=\"br0\">(</span><a href=\"/w/c/numeric/fenv/fetestexcept\"><span class=\"kw716\">fetestexcept</span></a><span class=\"br0\">(</span><a href=\"/w/c/numeric/fenv/FE_exceptions\"><span class=\"kw729\">FE_INVALID</span></a><span class=\"br0\">)</span><span class=\"br0\">)</span>\n        <a href=\"/w/c/io/puts\"><span class=\"kw833\">puts</span></a><span class=\"br0\">(</span><span class=\"st0\">\"    FE_INVALID was raised\"</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Possible output:\n</p>\n<pre data-output=\"1\"><code>round(+2.3) = +2.0  round(+2.5) = +3.0  round(+2.7) = +3.0\nround(-2.3) = -2.0  round(-2.5) = -3.0  round(-2.7) = -3.0\nround(-0.0) = -0.0\nround(-Inf) = -inf\nlround(+2.3) = +2  lround(+2.5) = +3  lround(+2.7) = +3\nlround(-2.3) = -2  lround(-2.5) = -3  lround(-2.7) = -3\nlround(-0.0) = +0\nlround(-Inf) = -9223372036854775808\nlround(LONG_MAX+1.5) = -9223372036854775808\n    FE_INVALID was raised</code></pre> \n</div>\n<h3 id=\"References\">References</h3>\n<div class=\"t-ref-std-23\">\n<ul><li> C23 standard (ISO/IEC 9899:2024): \n</li></ul>\n<dl><dd><ul><li> 7.12.9.6 The round functions (p: TBD)\n</li></ul>\n</dd></dl>\n<dl><dd><ul><li> 7.12.9.7 The lround and llround functions (p: TBD)\n</li></ul>\n</dd></dl>\n<dl><dd><ul><li> 7.25 Type-generic math &lt;tgmath.h&gt; (p: TBD)\n</li></ul>\n</dd></dl>\n<dl><dd><ul><li> F.10.6.6 The round functions (p: TBD)\n</li></ul>\n</dd></dl>\n<dl><dd><ul><li> F.10.6.7 The lround and llround functions (p: TBD)\n</li></