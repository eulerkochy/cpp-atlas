pan class=\"sy4\">::</span><span class=\"me2\">unsized</span><br><span class=\"sy1\">&gt;</span><br>&nbsp; &nbsp; requires <span class=\"br0\">(</span>K <span class=\"sy1\">==</span> ranges<span class=\"sy4\">::</span><span class=\"me2\">subrange_kind</span><span class=\"sy4\">::</span><span class=\"me2\">sized</span> <span class=\"sy3\">||</span><br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<span class=\"sy3\">!</span><a href=\"/w/cpp/iterator/sized_sentinel_for\"><span class=\"kw2881\">std::<span class=\"me2\">sized_sentinel_for</span></span></a><span class=\"sy1\">&lt;</span>S, I<span class=\"sy1\">&gt;</span><span class=\"br0\">)</span><br><span class=\"kw1\">class</span> subrange<br>&nbsp; &nbsp; <span class=\"sy4\">:</span> <span class=\"kw1\">public</span> <a href=\"/w/cpp/ranges/view_interface\"><span class=\"kw3120\">ranges::<span class=\"me2\">view_interface</span></span></a><span class=\"sy1\">&lt;</span>subrange<span class=\"sy1\">&lt;</span>I, S, K<span class=\"sy1\">&gt;&gt;</span></span></div></td>\n<td> (1) </td>\n<td> <span class=\"t-mark-rev t-since-cxx20\">(since C++20)</span> </td>\n</tr>\n<tr class=\"t-dcl-h\">\n<td> <div>Helper concepts</div></td>\n<td></td>\n<td></td>\n</tr>\n<tr class=\"t-dcl\">\n<td><div><span id=\"Version_2\"></span><span class=\"mw-geshi cpp source-cpp\"><span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span><span class=\"kw1\">class</span> From, <span class=\"kw1\">class</span> To<span class=\"sy1\">&gt;</span><br>concept <span class=\"coMULTI\">/*uses-nonqualification-pointer-conversion*/</span> <span class=\"sy1\">=</span><br>&nbsp; &nbsp; <span class=\"coMULTI\">/* see description */</span><span class=\"sy4\">;</span></span></div></td>\n<td> (2)</td>\n<td class=\"t-dcl-nopad\"><span class=\"t-mark t-mark-expos\">(<span>exposition only*</span>)</span></td>\n</tr>\n<tr class=\"t-dcl\">\n<td><div><span id=\"Version_3\"></span><span class=\"mw-geshi cpp source-cpp\"><span class=\"kw1\">templa