: 532-545)\n</li></ul>\n</dd></dl>\n</div>\n<div class=\"t-ref-std-c99\">\n<ul><li> C99 standard (ISO/IEC 9899:1999): \n</li></ul>\n<dl><dd><ul><li> 6.10.8/2 <code>__STDC_IEC_559_COMPLEX__</code> (p: 161)\n</li></ul>\n</dd></dl>\n<dl><dd><ul><li> 7.3 Complex arithmetic <code>&lt;complex.h&gt;</code> (p: 170-180)\n</li></ul>\n</dd></dl>\n<dl><dd><ul><li> 7.22 Type-generic math <code>&lt;tgmath.h&gt;</code> (p: 335-337)\n</li></ul>\n</dd></dl>\n<dl><dd><ul><li> 7.26.1 Complex arithmetic <code>&lt;complex.h&gt;</code> (p: 401)\n</li></ul>\n</dd></dl>\n<dl><dd><ul><li> Annex G (informative) IEC 60559-compatible complex arithmetic (p: 467-480)\n</li></ul>\n</dd></dl>\n</div>\n</details></div>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td colspan=\"2\"> <div class=\"t-dsc-see\"><span><a href=\"/w/cpp/numeric/complex\">C++ documentation</a></span> for <span><span>Complex number arithmetic</span></span></div>\n</td></tr>\n</table>","headings":[{"depth":3,"text":"Notes","id":"Notes"},{"depth":3,"text":"Example","id":"Example"},{"depth":3,"text":"References","id":"References"},{"depth":3,"text":"See also","id":"See_also"}],"breadcrumbs":[{"path":"","title":"C reference"},{"path":"numeric","title":"Numerics"}],"children":[{"path":"numeric/complex/cabs","title":"cabsf, cabs, cabsl"},{"path":"numeric/complex/cacos","title":"cacosf, cacos, cacosl"},{"path":"numeric/complex/cacosh","title":"cacoshf, cacosh, cacoshl"},{"path":"numeric/complex/carg","title":"cargf, carg, cargl"},{"path":"numeric/complex/casin","title":"casinf, casin, casinl"},{"path":"numeric/complex/casinh","title":"casinhf, casinh, casinhl"},{"path":"numeric/complex/catan","title":"catanf, catan, catanl"},{"path":"numeric/complex/catanh","title":"catanhf, catanh, catanhl"},{"path":"numeric/complex/ccos","title":"ccosf, ccos, ccosl"},{"path":"numeric/complex/ccosh","title":"ccoshf, ccosh, ccoshl"},{"path":"numeric/complex/cexp","title":"cexpf, cexp, cexpl"},{"path":"numeric/complex/cimag","title":"cimagf, cimag, cimagl"},{"path":"numeric/complex/clog","title":"clogf, clog, clogl"},{"path":"numeric/complex/CMPLX","title":"CMPLXF, CMPLX, CMPLXL"},{"path":"numeric/complex/complex","title":"complex"},{"path":"numeric/complex/Complex_I","title":"_Complex_I"},{"path":"numeric/complex/conj","title":"conjf, conj, conjl"},{"path":"numeric/complex/cpow","title":"cpowf, cpow, cpowl"},{"path":"numeric/complex/cproj","title":"cprojf, cproj, cprojl"},{"path":"numeric/complex/creal","title":"crealf, creal, creall"},{"path":"numeric/complex/csin","title":"csinf, csin, csinl"},{"path":"numeric/complex/csinh","title":"csinhf, csinh, csinhl"},{"path":"numeric/complex/csqrt","title":"csqrtf, csqrt, csqrtl"},{"path":"numeric/complex/ctan","title":"ctanf, ctan, ctanl"},{"path":"numeric/complex/ctanh","title":"ctanhf, ctanh, ctanhl"},{"path":"numeric/complex/I","title":"I"},{"path":"numeric/complex/imaginary","title":"imaginary"},{"path":"numeric/complex/Imaginary_I","title":"_Imaginary_I"}],"map":{"label":"Complex number arithmetic","children":[{"label":"Types","children":[{"label":"imaginary","note":"imaginary type macro"},{"label":"complex","note":"complex type macro"}]},{"label":"The imaginary constant","children":[{"label":"_Imaginary_I","note":"the imaginary unit constant i"},{"label":"_Complex_I","note":"the complex unit constant i"},{"label":"I","note":"the complex or imaginary unit constant i"}]},{"label":"Manipulation","children":[{"label":"CMPLX, CMPLXF, CMPLXL","note":"constructs a complex number from real and imaginary parts"},{"label":"creal, crealf, creall","note":"computes the real part of a complex number"},{"label":"cimag, cimagf, cimagl","note":"computes the imaginary part a complex number"},{"label":"cabs, cabsf, cabsl","note":"computes the magnitude of a complex number"},{"label":"carg, cargf, cargl","note":"computes the phase angle of a complex number"},{"label":"conj, conjf, conjl","note":"computes the complex conjugate"},{"label":"cproj, cprojf, cprojl","note":"computes the projection on Riemann sphere"}]},{"label":"Exponential functions","children":[{"label":"cexp, cexpf, cexpl","note":"computes the complex base-e exponential"},{"label":"clog, clogf, clogl","note":"computes the complex natural logarithm"}]},{"label":"Power functions","children":[{"label":"cpow, cpowf, cpowl","note":"computes the complex power function"},{"label":"csqrt, csqrtf, csqrtl","note":"computes the complex square root"}]},{"label":"Trigonometric functions","children":[{"label":"csin, csinf, csinl","note":"computes the complex sine"},{"label":"ccos, ccosf, ccosl","note":"computes the complex cosine"},{"label":"ctan, ctanf, ctanl","note":"computes the complex tangent"},{"label":"casin, casinf, casinl","note":"computes the complex arc sine"},{"label":"cacos, cacosf, cacosl","note":"computes the complex arc cosine"},{"label":"catan, catanf, catanl","note":"computes the complex arc tangent"}]},{"label":"Hyperbolic functions","children":[{"label":"csinh, csinhf, csinhl","note":"computes the complex hyperbolic sine"},{"label":"ccosh, ccoshf, ccoshl","note":"computes the complex hyperbolic cosine"},{"label":"ctanh, ctanhf, ctanhl","note":"computes the complex hyperbolic tangent"},{"label":"casinh, casinhf, casinhl","note":"computes the complex arc hyperbolic sine"},{"label":"cacosh, cacoshf, cacoshl","note":"computes the complex arc hyperbolic cosine"},{"label":"catanh, catanhf, catanhl","note":"computes the complex arc hyperbolic tangent"}]},{"label":"Notes","note":"The following function names are potentially(since C23) reserved for future addition to <complex.h> and are not available for use in the programs that include…","children":[{"label":"<complex.h>"}]},{"label":"Example"},{"label":"See also"}]},"standards":["C99","C11","C23"],"wordCount":890,"codeBlockCount":2}
