lass=\"br0\">{</span><span class=\"st0\">\"x,y,z\"</span>sv, <span class=\"st0\">','</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <span class=\"co1\">// type of w2 is lazy_split_view&lt;string_view, single_view&lt;char&gt;&gt;:</span>\n    static_assert<span class=\"br0\">(</span><a href=\"/w/cpp/types/is_same\"><span class=\"kw592\">std::<span class=\"me2\">is_same_v</span></span></a><span class=\"sy1\">&lt;</span>\n        decltype<span class=\"br0\">(</span>w2<span class=\"br0\">)</span>,\n        std<span class=\"sy4\">::</span><a href=\"/w/cpp/ranges/lazy_split_view\"><span class=\"kw3699\">ranges::<span class=\"me2\">lazy_split_view</span></span></a><span class=\"sy1\">&lt;</span>\n            <a href=\"/w/cpp/string/basic_string_view\"><span class=\"kw1254\">std::<span class=\"me2\">basic_string_view</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">char</span>, <a href=\"/w/cpp/string/char_traits\"><span class=\"kw1275\">std::<span class=\"me2\">char_traits</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">char</span><span class=\"sy1\">&gt;&gt;</span>,\n            std<span class=\"sy4\">::</span><a href=\"/w/cpp/ranges/single_view\"><span class=\"kw3122\">ranges::<span class=\"me2\">single_view</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">char</span><span class=\"sy1\">&gt;&gt;&gt;</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n</div>","headings":[{"depth":3,"text":"Example","id":"Example"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"ranges","title":"Ranges library (since C++20)"},{"path":"ranges/lazy_split_view","title":"std::ranges::views::lazy_split, std::ranges::lazy_split_view"}],"children":[],"map":{"label":"deduction guides for std::ranges::lazy_split_view","children":[{"label":"Declarations","note":"2 declarations; revisions: since C++20. These deduction guides are provided for lazy_split_vie