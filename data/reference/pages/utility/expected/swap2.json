ror() = 19937\nswap(ex1, ex2);\nex1.error() = 19937\nex2.error() = 13</code></pre> \n</div>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/utility/expected/swap\"> <span class=\"t-lines\"><span>swap</span></span></a></div></div>\n</td>\n<td>  exchanges the contents <br> <span class=\"t-mark\">(public member function)</span> </td></tr>\n</table>","headings":[{"depth":3,"text":"Parameters","id":"Parameters"},{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Exceptions","id":"Exceptions"},{"depth":3,"text":"Example","id":"Example"},{"depth":3,"text":"See also","id":"See_also"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"utility","title":"Utility library"},{"path":"utility/expected","title":"std::expected"}],"children":[],"map":{"label":"swap(std::expected)","children":[{"label":"Declarations","note":"1 declaration; revisions: since C++23. Overloads the std::swap algorithm for std::expected. Exchanges the state of lhs with that of rhs."},{"label":"Parameters","note":"lhs, rhs"},{"label":"Return value","note":"(none)"},{"label":"Exceptions"},{"label":"Example"},{"label":"See also","children":[{"label":"swap","note":"exchanges the contents"}]}]},"standards":["C++23"],"wordCount":261,"codeBlockCount":2}
