d>\n<td class=\"t-dcl-nopad\">  </td>\n<td> <span class=\"t-mark-rev t-since-cxx11\">(since C++11)</span> </td>\n</tr>\n</tbody><tbody>\n<tr class=\"t-dcl\" id=\"Version_5\">\n<td> <div><span class=\"mw-geshi cpp source-cpp\"><span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span> <span class=\"kw1\">class</span> InputIt <span class=\"sy1\">&gt;</span><br>deque<span class=\"br0\">(</span> InputIt first, InputIt last, <span class=\"kw4\">const</span> Allocator<span class=\"sy3\">&amp;</span> alloc <span class=\"sy1\">=</span> Allocator<span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"br0\">)</span><span class=\"sy4\">;</span></span></div></td>\n<td> (5) </td>\n<td class=\"t-dcl-nopad\">  </td>\n</tr>\n<tr class=\"t-dcl t-since-cxx23\" id=\"Version_6\">\n<td> <div><span class=\"mw-geshi cpp source-cpp\"><span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span> <a href=\"/w/cpp/ranges/to\"><span class=\"kw100\">container-compatible-range</span></a><span class=\"sy1\">&lt;</span>T<span class=\"sy1\">&gt;</span> R <span class=\"sy1\">&gt;</span><br>deque<span class=\"br0\">(</span> <a href=\"/w/cpp/ranges/from_range\"><span class=\"kw3603\">std::<span class=\"me2\">from_range_t</span></span></a>, R<span class=\"sy3\">&amp;&amp;</span> rg, <span class=\"kw4\">const</span> Allocator<span class=\"sy3\">&amp;</span> alloc <span class=\"sy1\">=</span> Allocator<span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"br0\">)</span><span class=\"sy4\">;</span></span></div></td>\n<td> (6) </td>\n<td> <span class=\"t-mark-rev t-since-cxx23\">(since C++23)</span> </td>\n</tr>\n<tr class=\"t-dcl\" id=\"Version_7\">\n<td> <div><span class=\"mw-geshi cpp source-cpp\">deque<span class=\"br0\">(</span> <span class=\"kw4\">const</span> deque<span class=\"sy3\">&amp;</span> other <span class=\"br0\">)</span><span class=\"sy4\">;</span></span></div></td>\n<td> (7) </td>\n<td class=\"t-dcl-nopad\">  </td>\n</tr>\n<tr class=\"t-dcl t-si