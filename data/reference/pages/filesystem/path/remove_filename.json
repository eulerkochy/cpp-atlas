sp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    fs<span class=\"sy4\">::</span><span class=\"me2\">path</span> p<span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <a href=\"/w/cpp/io/manip/boolalpha\"><span class=\"kw1781\">std::<span class=\"me2\">boolalpha</span></span></a>\n              <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span>p <span class=\"sy1\">=</span> <span class=\"st0\">\"foo/bar\"</span><span class=\"br0\">)</span>.<span class=\"me1\">remove_filename</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\t</span>'</span> <span class=\"sy1\">&lt;&lt;</span> p.<span class=\"me1\">has_filename</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span>\n              <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span>p <span class=\"sy1\">=</span> <span class=\"st0\">\"foo/\"</span><span class=\"br0\">)</span>.<span class=\"me1\">remove_filename</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\t</span>'</span> <span class=\"sy1\">&lt;&lt;</span> p.<span class=\"me1\">has_filename</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span>\n              <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span>p <span class=\"sy1\">=</span> <span class=\"st0\">\"/foo\"</span><span class=\"br0\">)</span>.<span class=\"me1\">remove_filename</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=