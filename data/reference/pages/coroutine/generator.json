</span><span class=\"sy1\">&lt;</span><span class=\"kw4\">const</span> T<span class=\"sy3\">&amp;</span><span class=\"sy1\">&gt;</span> traverse_inorder<span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"kw4\">const</span>\n    <span class=\"br0\">{</span>\n        <span class=\"kw1\">if</span> <span class=\"br0\">(</span>left<span class=\"br0\">)</span>\n            co_yield std<span class=\"sy4\">::</span><span class=\"me2\">ranges</span><span class=\"sy4\">::</span><span class=\"me2\">elements_of</span><span class=\"br0\">(</span>left<span class=\"sy2\">-</span><span class=\"sy1\">&gt;</span>traverse_inorder<span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n        co_yield value<span class=\"sy4\">;</span>\n&nbsp;\n        <span class=\"kw1\">if</span> <span class=\"br0\">(</span>right<span class=\"br0\">)</span>\n            co_yield std<span class=\"sy4\">::</span><span class=\"me2\">ranges</span><span class=\"sy4\">::</span><span class=\"me2\">elements_of</span><span class=\"br0\">(</span>right<span class=\"sy2\">-</span><span class=\"sy1\">&gt;</span>traverse_inorder<span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n<span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    Tree<span class=\"sy1\">&lt;</span><span class=\"kw4\">char</span><span class=\"sy1\">&gt;</span> tree<span class=\"br0\">[</span><span class=\"br0\">]</span>\n    <span class=\"br0\">{</span>\n                                    <span class=\"br0\">{</span><span class=\"st0\">'D'</span>, tree <span class=\"sy2\">+</span> <span class=\"nu0\">1</span>, tree <span class=\"sy2\">+</span> <span class=\"nu0\">2</span><span class=\"br0\">}</span>,\n        <span class=\"co1\">// 