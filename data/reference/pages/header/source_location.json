/code></pre>","headings":[{"depth":3,"text":"Synopsis","id":"Synopsis"},{"depth":4,"text":"Class std::source_location","id":"Class_std::source_location"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"header","title":"C++ Standard Library headers"}],"children":[],"map":{"label":"Standard library header <source_location> (C++20)","children":[{"label":"Classes","children":[{"label":"source_location","note":"a class representing information about the source code, such as file names, line numbers, and function names"}]},{"label":"Synopsis","children":[{"label":"Class std::source_location"}]}]},"standards":["C++20"],"wordCount":107,"codeBlockCount":2}
