1</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n        out<span class=\"br0\">(</span><span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw4\">auto</span> data <span class=\"sy1\">=</span> <span class=\"br0\">[</span><span class=\"br0\">]</span><span class=\"br0\">(</span><span class=\"kw4\">int</span> n, <span class=\"kw4\">int</span> w, <span class=\"kw4\">auto</span><span class=\"sy3\">&amp;</span> first, <span class=\"kw4\">auto</span> last<span class=\"br0\">)</span>\n    <span class=\"br0\">{</span>\n        <span class=\"kw1\">for</span> <span class=\"br0\">(</span>out<span class=\"br0\">(</span><span class=\"st0\">' '</span>, w<span class=\"br0\">)</span><span class=\"sy4\">;</span> n<span class=\"sy2\">--</span> <span class=\"sy1\">&gt;</span> <span class=\"nu0\">0</span> <span class=\"sy3\">&amp;&amp;</span> first <span class=\"sy3\">!</span><span class=\"sy1\">=</span> last<span class=\"sy4\">;</span> <span class=\"sy2\">++</span>first<span class=\"br0\">)</span>\n            out<span class=\"br0\">(</span><span class=\"sy2\">*</span>first<span class=\"br0\">)</span>, out<span class=\"br0\">(</span><span class=\"st0\">' '</span>, w <span class=\"sy2\">+</span> w <span class=\"sy2\">+</span> <span class=\"nu0\">1</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n        out<span class=\"br0\">(</span><span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw4\">auto</span> tier <span class=\"sy1\">=</span> <span class=\"br0\">[</span><span class=\"sy3\">&amp;</span><span class=\"br0\">]</span><span class=\"br0\">(</span><span class=\"kw4\">int</span> t, <span class=\"kw4\">int</span> m, <span class=\"kw4\">auto</span><span class=\"sy3\">&amp;</span> first, <span class=\"kw4\">auto</span> last<span class=\"br0\">)</span>\n    <span class=\"br0\">{</span>\n        <span class=\"kw4\">const</span> <span class=\"kw4\">int</span> n<span class=\"br0\">{</span><span class=\"nu0\">1</span> <span class=\"sy1\">&lt;&lt;</span> t<span class=\"br0\">}</span><span class=\"sy4\">;</span>\n        <span class=\"kw4\">const</span> <span class=\"kw4\">int</span> w<span class=\"br0\">{</span><span class=\"br0\">(</span><span class=\"nu0\">1</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span>m <span class=\"sy2\">-</span> t <span class=\"sy2\">-</span> <span class=\"nu0\">1</span><span class=\"br0\">)</span><span class=\"br0\">)</span> <span class=\"sy2\">-</span> <span class=\"nu0\">1</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n        bails<span class=\"br0\">(</span>n, w<span class=\"br0\">)</span>, data<span class=\"br0\">(</span>n, w, first, last<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw4\">const</span> <span class=\"kw4\">int</span> m<span class=\"br0\">{</span><span class=\"kw1\">static_cast</span><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span><span class=\"sy1\">&gt;</span><span class=\"br0\">(</span><a href=\"/w/cpp/numeric/math/ceil\"><span class=\"kw1358\">std::<span class=\"me2\">ceil</span></span></a><span class=\"br0\">(</span><a href=\"/w/cpp/numeric/math/log2\"><span class=\"kw2723\">std::<span class=\"me2\">log2</span></span></a><span class=\"br0\">(</span><span class=\"nu0\">1</span> <span class=\"sy2\">+</span> v.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <span class=\"kw4\">auto</span> first<span class=\"br0\">{</span>v.<span class=\"me1\">cbe