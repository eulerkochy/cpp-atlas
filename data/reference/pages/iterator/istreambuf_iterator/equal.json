rdless of the stream buffer objects they use."},{"label":"Parameters","note":"it"},{"label":"Return value","note":"true if both *this and it are valid, or both are invalid, false otherwise."},{"label":"Exceptions","note":"May throw implementation-defined exceptions."}]},"standards":[],"wordCount":109,"codeBlockCount":0}
