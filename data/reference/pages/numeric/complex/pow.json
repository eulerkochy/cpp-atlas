<span class=\"kw4\">const</span> <a href=\"/w/cpp/numeric/complex\"><span class=\"kw1480\">std::<span class=\"me2\">complex</span></span></a><span class=\"sy1\">&lt;</span>T<span class=\"sy1\">&gt;</span><span class=\"sy3\">&amp;</span> y <span class=\"br0\">)</span><span class=\"sy4\">;</span></span></div></td>\n<td> (4) </td>\n<td class=\"t-dcl-nopad\">  </td>\n</tr>\n<tr class=\"t-dcl-h\">\n<td> <div><a href=\"#Notes\">Additional overloads</a> <span class=\"t-mark-rev t-since-cxx11\">(since C++11)</span></div></td>\n<td></td>\n<td></td>\n</tr>\n<tr class=\"t-dsc-header\">\n<td> <div>Defined in header <code><a href=\"/w/cpp/header/complex\">&lt;complex&gt;</a></code>\n </div></td>\n<td></td>\n<td></td>\n</tr>\n</tbody>\n<tbody class=\"t-dcl-rev t-dcl-rev-num\"><tr class=\"t-dcl-rev-aux\">\n<td></td>\n<td rowspan=\"142\">(A)</td>\n<td></td>\n</tr>\n<tr class=\"t-dcl t-until-cxx23\">\n<td><div><span class=\"mw-geshi cpp source-cpp\"><span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span> <span class=\"kw1\">class</span> T1, <span class=\"kw1\">class</span> T2 <span class=\"sy1\">&gt;</span><br><a href=\"/w/cpp/numeric/complex\"><span class=\"kw1480\">std::<span class=\"me2\">complex</span></span></a><span class=\"sy1\">&lt;</span><span class=\"coMULTI\">/* common-type */</span><span class=\"sy1\">&gt;</span><br>&nbsp; &nbsp; pow<span class=\"br0\">(</span> <span class=\"kw4\">const</span> <a href=\"/w/cpp/numeric/complex\"><span class=\"kw1480\">std::<span class=\"me2\">complex</span></span></a><span class=\"sy1\">&lt;</span>T1<span class=\"sy1\">&gt;</span><span class=\"sy3\">&amp;</span> x, <span class=\"kw4\">const</span> <a href=\"/w/cpp/numeric/complex\"><span class=\"kw1480\">std::<span class=\"me2\">complex</span></span></a><span class=\"sy1\">&lt;</span>T2<span class=\"sy1\">&gt;</span><span class=\"sy3\">&amp;</span> y <span class=\"br0\">)</span><span class=\"sy4\">;</span></span></div></td>\n<td class=\"t-dcl-nopad\"> </td>\n<td><span class=\"t