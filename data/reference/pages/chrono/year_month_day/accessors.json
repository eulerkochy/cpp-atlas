pan class=\"sy1\">==</span> <a href=\"/w/cpp/chrono/year\"><span class=\"kw2636\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">year</span></span></a><span class=\"br0\">(</span><span class=\"nu0\">2021</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    static_assert<span class=\"br0\">(</span>ymd.<span class=\"me1\">month</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">==</span> <a href=\"/w/cpp/chrono/month\"><span class=\"kw2621\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">month</span></span></a><span class=\"br0\">(</span><span class=\"nu0\">7</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    static_assert<span class=\"br0\">(</span>ymd.<span class=\"me1\">day</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">==</span> <a href=\"/w/cpp/chrono/day\"><span class=\"kw2620\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">day</span></span></a><span class=\"br0\">(</span><span class=\"nu0\">1</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n</div>","headings":[{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Example","id":"Example"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"chrono","title":"Date and time utilities"},{"path":"chrono/year_month_day","title":"std::chrono::year_month_day"}],"children":[],"map":{"label":"std::chrono::year_month_day::year, std::chrono::year_month_day::month, std::chrono::year_month_day::day","children":[{"label":"Declarations","note":"3 declarations; revisions: since C++20. Retrieves the year, month and day values stored in this year_month_day object."},{"label":"Return value","note":"Returns the stored std::chrono::year value."},{"lab