\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span> <span class=\"sy2\">++</span>it<span class=\"br0\">)</span>\n        <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"sy2\">*</span>it <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">' '</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/container/list\"><span class=\"kw1283\">std::<span class=\"me2\">list</span></span></a> list2<span class=\"br0\">{</span><span class=\"nu0\">2</span>, <span class=\"nu0\">7</span>, <span class=\"nu0\">1</span>, <span class=\"nu0\">8</span>, <span class=\"nu0\">2</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <span class=\"kw4\">const</span> <span class=\"kw4\">auto</span> seq2<span class=\"br0\">{</span>list2 <span class=\"sy3\">|</span> <a href=\"/w/cpp/ranges/take_view\"><span class=\"kw2942\">views::<span class=\"me2\">take</span></span></a><span class=\"br0\">(</span><span class=\"nu0\">4</span><span class=\"br0\">)</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    static_assert<span class=\"br0\">(</span><a href=\"/w/cpp/ranges/sized_range\"><span class=\"kw2918\">ranges::<span class=\"me2\">sized_range</span></span></a><span class=\"sy1\">&lt;</span>decltype<span class=\"br0\">(</span>seq2<span class=\"br0\">)</span><span class=\"sy1\">&gt;</span> and\n                  not <a href=\"/w/cpp/ranges/random_access_range\"><span class=\"kw2924\">ranges::<span class=\"me2\">random_access_range</span></span></a><span class=\"sy1\">&lt;</span>decltype<span class=\"br0\">(</span>seq2<span class=\"br0\">)</span><span class=\"sy1\">&gt;</span> and\n                  <a href=\"/w/cpp/types/i