>\n    <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw4\">const</span> std<span class=\"sy4\">::</span><span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">year_month_day_last</span> ymdl\n    <span class=\"br0\">{</span>\n        ymd.<span class=\"me1\">year</span><span class=\"br0\">(</span><span class=\"br0\">)</span>, ymd.<span class=\"me1\">month</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy2\">/</span> <a href=\"/w/cpp/chrono/last_spec\"><span class=\"kw2561\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">last</span></span></a>\n    <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"The last day of present month (\"</span> <span class=\"sy1\">&lt;&lt;</span> ymdl <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\") is: \"</span>\n              <span class=\"sy1\">&lt;&lt;</span> <a href=\"/w/cpp/chrono/year_month_day\"><span class=\"kw2574\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">year_month_day</span></span></a><span class=\"br0\">{</span>ymdl<span class=\"br0\">}</span>.<span class=\"me1\">day</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"co1\">// The 'last' object can be placed wherever it is legal to place a 'day':</span>\n    <span class=\"kw1\">using</span> <span class=\"kw1\">namespace</span> std<span class=\"sy4\">::</span><span class=\"me2\">chrono</span><span class=\"sy4\">;</span>\n    <span class=\"kw4\">constexpr</span> std<span class=\"sy4\">::</span><span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">year_month_day_last</span>\n        ymdl1 <span class=\"sy1\">=</span> 2023y <span class=\"sy2\">/</span> February <span class=\"sy2\">/</span> last,\n        ymdl2 <span class=\"sy1\">=</span> last <span class=\"sy2\">/</span> February <span class=\"sy2\">/</span> 2023y,\n        ymdl3 <span class=\"sy1\">=</span> February <span class=\"sy2\">/</span> last <span class=\"sy2\">/</span> 2023y<span class=\"sy4\">;</span>\n    static_assert<span class=\"br0\">(</span>ymdl1 <span class=\"sy1\">==</span> ymdl2 <span class=\"sy3\">&amp;&amp;</span> ymdl2 <span class=\"sy1\">==</span> ymdl3<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Possible output:\n</p>\n<pre data-output=\"1\"><code>The last day of present month (2023/Aug/last) is: 31</code></pre> \n</div>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/chrono/year_month_day\"> <span class=\"t-lines\"><span>year_month_day</span></span></a></div><div><span class=\"t-lines\"><span><span class=\"t-mark-rev t-since-cxx20\">(C++20)</span></span></span></div></div>\n</td>\n<td>  represents a specific <a href=\"/w/cpp/chrono/year\"><code>year</code></a>, <a href=\"/w/cpp/chrono/month\"><code>month</code></a>, and <a href=\"/w/cpp/chrono/day\"><code>day</code></a> <br> <span class=\"t-mark\">(class)</span> </td></tr>\n</table>","headings":[{"depth":3,"text":"Member functions","id":"Member_functions"},{"depth":3,"text":"Nonmember functions","id":"Nonmember_functions"},{"depth":3,"text":"Helper classes","id":"Helper_classes"},{"depth":3,"text":"Example","id":"Example"},{"depth":3,"text":"See also","id":"See_also"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"chrono","title":"Date and time utilities"}],"children":[{"path":"chrono/year_month_day_last/accessors","title":"std::chrono::year_month_day_last::year, std::chrono::year_month_day_last::m