<span class=\"me2\">move</span><span class=\"br0\">(</span>result<span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n<span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n<span class=\"kw1\">inline</span> <span class=\"kw4\">constexpr</span> copy_fn copy<span class=\"sy4\">;</span></code></pre>\n</td></tr>\n<tr>\n<th><a href=\"#Version_3\">copy_if</a>\n</th></tr>\n<tr>\n<td>\n<pre data-lang=\"cpp\"><code><span class=\"kw1\">struct</span> copy_if_fn\n<span class=\"br0\">{</span>\n    <span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/iterator/input_iterator\"><span class=\"kw2882\">std::<span class=\"me2\">input_iterator</span></span></a> I, <a href=\"/w/cpp/iterator/sentinel_for\"><span class=\"kw2880\">std::<span class=\"me2\">sentinel_for</span></span></a><span class=\"sy1\">&lt;</span>I<span class=\"sy1\">&gt;</span> S, <a href=\"/w/cpp/iterator/weakly_incrementable\"><span class=\"kw2877\">std::<span class=\"me2\">weakly_incrementable</span></span></a> O,\n             <span class=\"kw1\">class</span> Proj <span class=\"sy1\">=</span> <a href=\"/w/cpp/utility/functional/identity\"><span class=\"kw2741\">std::<span class=\"me2\">identity</span></span></a>,\n             <a href=\"/w/cpp/iterator/indirect_unary_predicate\"><span class=\"kw3150\">std::<span class=\"me2\">indirect_unary_predicate</span></span></a><span class=\"sy1\">&lt;</span>std<span class=\"sy4\">::</span><a href=\"/w/cpp/iterator/projected\"><span class=\"kw2695\">projected</span></a><span class=\"sy1\">&lt;</span>I, Proj<span class=\"sy1\">&gt;&gt;</span> Pred<span class=\"sy1\">&gt;</span>\n    requires <a href=\"/w/cpp/iterator/indirectly_copyable\"><span class=\"kw3141\">std::<span class=\"me2\">indirectly_copyable</span></span></a><span class=\"sy1\">&lt;</span>I, O<span class=\"sy1\">&gt;</span>\n    <span class=\"kw4\">constexpr</span> ranges<span class=\"sy4\">::</span><span cl