ed_iterator\"><span class=\"kw3139\">std::<span class=\"me2\">counted_iterator</span></span></a><span class=\"sy1\">&lt;</span>\n            <a href=\"/w/cpp/iterator/ostream_iterator\"><span class=\"kw675\">std::<span class=\"me2\">ostream_iterator</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">double</span><span class=\"sy1\">&gt;&gt;</span>,\n            <a href=\"/w/cpp/iterator/default_sentinel_t\"><span class=\"kw2896\">std::<span class=\"me2\">default_sentinel_t</span></span></a><span class=\"sy1\">&gt;</span>\n            beg<span class=\"br0\">{</span><a href=\"/w/cpp/iterator/counted_iterator\"><span class=\"kw3139\">std::<span class=\"me2\">counted_iterator</span></span></a><span class=\"br0\">{</span><a href=\"/w/cpp/iterator/ostream_iterator\"><span class=\"kw675\">std::<span class=\"me2\">ostream_iterator</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">double</span><span class=\"sy1\">&gt;</span><span class=\"br0\">{</span><a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a>,<span class=\"st0\">\";  \"</span><span class=\"br0\">}</span>, <span class=\"nu0\">5</span><span class=\"br0\">}</span><span class=\"br0\">}</span>,\n            end<span class=\"br0\">{</span><a href=\"/w/cpp/iterator/default_sentinel_t\"><span class=\"kw2897\">std::<span class=\"me2\">default_sentinel</span></span></a><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/algorithm/iota\"><span class=\"kw1667\">std::<span class=\"me2\">iota</span></span></a><span class=\"br0\">(</span>beg, end, <span class=\"nu16\">3.1</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre d