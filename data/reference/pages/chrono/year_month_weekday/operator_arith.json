pan> <span class=\"kw4\">const</span> <a href=\"/w/cpp/chrono/duration\"><span class=\"kw1006\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">months</span></span></a><span class=\"sy3\">&amp;</span> dm <span class=\"br0\">)</span> <span class=\"kw4\">const</span> <span class=\"kw1\">noexcept</span><span class=\"sy4\">;</span></span></div></td>\n<td> (2) </td>\n<td> <span class=\"t-mark-rev t-since-cxx20\">(since C++20)</span> </td>\n</tr>\n<tr class=\"t-dcl t-since-cxx20\" id=\"Version_3\">\n<td> <div><span class=\"mw-geshi cpp source-cpp\"><span class=\"kw4\">constexpr</span> <a href=\"/w/cpp/chrono/year_month_weekday\"><span class=\"kw2571\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">year_month_weekday</span></span></a><span class=\"sy3\">&amp;</span><br>&nbsp; &nbsp; operator<span class=\"sy2\">-</span><span class=\"sy1\">=</span><span class=\"br0\">(</span> <span class=\"kw4\">const</span> <a href=\"/w/cpp/chrono/duration\"><span class=\"kw1007\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">years</span></span></a><span class=\"sy3\">&amp;</span> dy <span class=\"br0\">)</span> <span class=\"kw4\">const</span> <span class=\"kw1\">noexcept</span><span class=\"sy4\">;</span></span></div></td>\n<td> (3) </td>\n<td> <span class=\"t-mark-rev t-since-cxx20\">(since C++20)</span> </td>\n</tr>\n<tr class=\"t-dcl t-since-cxx20\" id=\"Version_4\">\n<td> <div><span class=\"mw-geshi cpp source-cpp\"><span class=\"kw4\">constexpr</span> <a href=\"/w/cpp/chrono/year_month_weekday\"><span class=\"kw2571\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">year_month_weekday</span></span></a><span class=\"sy3\">&amp;</span><br>&nbsp; &nbsp; operator<span class=\"sy2\">-</span><span class=\"sy1\">=</span><span class=\"br0\">(</span> <span class=\"kw4\">const</span> <a href=\"/w/cpp/chrono/duration\"><span class=\"kw1006