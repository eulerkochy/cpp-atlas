 class=\"br0\">)</span><span class=\"sy1\">&gt;</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw4\">auto</span> v2 <span class=\"sy1\">=</span> <a href=\"/w/cpp/container/forward_list\"><span class=\"kw1281\">std::<span class=\"me2\">forward_list</span></span></a><span class=\"br0\">{</span><span class=\"nu0\">1</span>, <span class=\"nu0\">2</span>, <span class=\"nu0\">3</span>, <span class=\"nu0\">4</span>, <span class=\"nu0\">5</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <span class=\"kw4\">auto</span> ev2 <span class=\"br0\">{</span>v2 <span class=\"sy3\">|</span> std<span class=\"sy4\">::</span><span class=\"me2\">views</span><span class=\"sy4\">::</span><span class=\"me2\">enumerate</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    static_assert<span class=\"br0\">(</span>not std<span class=\"sy4\">::</span><a href=\"/w/cpp/ranges/sized_range\"><span class=\"kw2918\">ranges::<span class=\"me2\">sized_range</span></span></a><span class=\"sy1\">&lt;</span>decltype<span class=\"br0\">(</span>v2<span class=\"br0\">)</span><span class=\"sy1\">&gt;</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"co1\">// auto size = ev2.size(); // Error: v2 is not a sized range</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>std<span class=\"sy4\">::</span><a href=\"/w/cpp/iterator/ranges/distance\"><span class=\"kw3160\">ranges::<span class=\"me2\">distance</span></span></a><span class=\"br0\">(</span>v2<span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"nu0\">5</span><span class=\"br0\">)</span><span class=\"sy4\">;</span> <span class=\"co1\">// OK, distance does not require sized</span>\n                                            <span class=\"co1\">// range, but has O(N) complexity here</span>\n<span class=\"br0\">}</span></code></pre>\n</div>\n<h3 id=\"See_also\">See also</h3>\