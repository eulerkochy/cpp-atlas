</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n    <span class=\"kw1\">else</span>\n        <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"value not set<span class=\"es1\">\\n</span>\"</span><span class=\"sy4\">;</span>\n&nbsp;\n    opt.<span class=\"me1\">reset</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"kw1\">if</span> <span class=\"br0\">(</span>opt.<span class=\"me1\">has_value</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span>\n        <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"value still set to \"</span> <span class=\"sy1\">&lt;&lt;</span> opt.<span class=\"me1\">value</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n    <span class=\"kw1\">else</span>\n        <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"value no longer set<span class=\"es1\">\\n</span>\"</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre data-output=\"1\"><code>false\nvalue set to 43\nvalue no longer set</code></pre> \n</div>","headings":[{"depth":3,"text":"Parameters","id":"Parameters"},{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Example","id":"Example"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"utility","title":"Utility library"},{"path":"utility/optional","title":"std::optional"}],"children":[],"map":{"label":"std::optional<T>::operator bool, std::optional<T>::has_value","ch