&lt;</span> e <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">' '</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"→ \"</span><span class=\"sy4\">;</span>\n    std<span class=\"sy4\">::</span><span class=\"me2\">ranges</span><span class=\"sy4\">::</span><span class=\"me2\">reverse</span><span class=\"br0\">(</span>a<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"kw1\">for</span> <span class=\"br0\">(</span><span class=\"kw4\">auto</span> e <span class=\"sy4\">:</span> a<span class=\"br0\">)</span>\n        <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> e <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">' '</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre data-output=\"1\"><code>ABCDEF → FEDCBA → ABCDEF │ 1 2 3 4 5 → 5 4 3 2 1</code></pre> \n</div>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td> <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/algorithm/ranges/reverse_copy\"> <span class=\"t-lines\"><span>ranges::reverse_copy</span></span></a></div><div><span class=\"t-lines\"><span><span class=\"t-mark-rev t-since-cxx20\">(C++20)</span></span></span></div></div>\n</td>\n<td> creates a copy of a range that is reversed<br><span class=\"t-mark\">(algorithm function object)</span></td></tr>\n<tr class=\"t-dsc\">\n<td> <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/ranges/reverse_view\"> <span class=\"t-lines\"><span>ranges::reverse_view</span><span>views::reverse</span></span></a></div><div><span class=\"t-lines\"><span><span class=\"t-mark-rev t-since-cxx20\">(C++20)</span></span></span></div></div>\n</td>\n<td> a <a href=\"/w/cpp/ranges/view\"><code>view</code></a> that iterates over the elements of another bidirectional view in reverse order<br><span class=\"t-mark\">(class template)</span> <span class=\"t-mark\">(range adaptor object)</span></td></tr>\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/algorithm/reverse\"> <span class=\"t-lines\"><span>reverse</span></span></a></div></div>\n</td>\n<td>  reverses the order of elements in a range <br> <span class=\"t-mark\">(function template)</span> </td></tr>\n</table>","headings":[{"depth":3,"text":"Parameters","id":"Parameters"},{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Complexity","id":"Complexity"},{"depth":3,"text":"Notes","id":"Notes"},{"depth":3,"text":"Possible implementation","id":"Possible_implementation"},{"depth":3,"text":"Example","id":"Example"},{"depth":3,"text":"See also","id":"See_also"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"algorithm","title":"Algorithms library"},{"path":"algorithm/ranges","title":"Constrained algorithms (since C++20)"}],"children":[],"map":{"label":"std::ranges::reverse","children":[{"label":"Declarations","note":"2 declarations; revisions: since C++20. Reverses the order of the elements in the range [first, last)."},{"label":"Parameters","note":"first, last, r"},{"label":"Return value","note":"An iterator equal to last."},{"label":"Complexity","note":"Exactly (last - first) / 2 swaps."},{"label":"Notes","note":"Implementations (e.g."},{"label":"Possible implementation","note":"See also implementations in libstdc++ and MSVC STL."},{"label":"Example"},{"label":"See also","children":[{"label":"ranges::reverse_copy","note":"creates a copy of a range that is reversed"},{"label":"ranges::reverse_view, views::reverse","note":"a view that iterates over the elements of another bidirectional view in reverse order"},{"label":"reverse","note":"reverses the order of elements in a range"}]}]},"standards":["C++20"],"wordCount":429,"codeBlockCount":3}
