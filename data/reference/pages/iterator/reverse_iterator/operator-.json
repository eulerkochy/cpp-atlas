0\">}</span><span class=\"br0\">}</span>,\n        vec_ri2<span class=\"br0\">{</span><a href=\"/w/cpp/iterator/reverse_iterator\"><span class=\"kw663\">std::<span class=\"me2\">reverse_iterator</span></span></a><span class=\"br0\">{</span>vec.<span class=\"me1\">rend</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">}</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span>vec_ri2 <span class=\"sy2\">-</span> vec_ri1<span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">' '</span><span class=\"sy4\">;</span> <span class=\"co1\">// 4</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span>vec_ri1 <span class=\"sy2\">-</span> vec_ri2<span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span> <span class=\"co1\">// -4</span>\n&nbsp;\n    <a href=\"/w/cpp/container/list\"><span class=\"kw1283\">std::<span class=\"me2\">list</span></span></a> lst<span class=\"br0\">{</span><span class=\"nu0\">5</span>, <span class=\"nu0\">6</span>, <span class=\"nu0\">7</span>, <span class=\"nu0\">8</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/iterator/reverse_iterator\"><span class=\"kw663\">std::<span class=\"me2\">reverse_iterator</span></span></a><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/container/list\"><span class=\"kw1283\">std::<span class=\"me2\">list</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span><span class=\"sy1\">&gt;</span><span class=\"sy4\">::</span><span class=\"me2\">iterator</span><span class=\"sy1\">&gt;</span>\n        lst_ri1<span class=\"br0\">{</spa