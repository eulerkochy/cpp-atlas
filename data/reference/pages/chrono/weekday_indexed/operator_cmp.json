ay</span></span></a><span class=\"br0\">(</span><span class=\"nu0\">3</span><span class=\"br0\">)</span>, <span class=\"nu0\">2</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    static_assert<span class=\"br0\">(</span>wdi1 <span class=\"sy1\">==</span> wdi2<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n</div>","headings":[{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Example","id":"Example"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"chrono","title":"Date and time utilities"},{"path":"chrono/weekday_indexed","title":"std::chrono::weekday_indexed"}],"children":[],"map":{"label":"std::chrono::operator==(std::chrono::weekday_indexed)","children":[{"label":"Declarations","note":"1 declaration; revisions: since C++20. Compares the two weekday_indexed x and y."},{"label":"Return value","note":"x.weekday() == y.weekday() && x.index() == y.index()"},{"label":"Example"}]},"standards":["C++20"],"wordCount":57,"codeBlockCount":1}
