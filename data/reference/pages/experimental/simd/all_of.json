stq<span class=\"sy4\">::</span><span class=\"me2\">some_of</span><span class=\"br0\">(</span>mask3<span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"kw2\">true</span> <span class=\"sy3\">&amp;&amp;</span>\n        stq<span class=\"sy4\">::</span><span class=\"me2\">all_of</span><span class=\"br0\">(</span>mask3<span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"kw2\">false</span>\n    <span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n</div>","headings":[{"depth":3,"text":"Parameters","id":"Parameters"},{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Example","id":"Example"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"experimental","title":"Experimental C++ Features"},{"path":"experimental/simd","title":"SIMD library"}],"children":[],"map":{"label":"std::experimental::all_of, std::experimental::any_of, std::experimental::none_of, std::experimental::some_of","children":[{"label":"Declarations","note":"4 declarations. Returns true if all values in k are true."},{"label":"Parameters","note":"k"},{"label":"Return value","note":"The boolean result of the horizontal reduction."},{"label":"Example"}]},"standards":[],"wordCount":241,"codeBlockCount":1}
