\"me2\">for_each_n</span><span class=\"br0\">(</span>a.<span class=\"me1\">begin</span><span class=\"br0\">(</span><span class=\"br0\">)</span>, <span class=\"nu0\">3</span>, <span class=\"br0\">[</span><span class=\"br0\">]</span><span class=\"br0\">(</span><span class=\"kw4\">auto</span><span class=\"sy3\">&amp;</span> n<span class=\"br0\">)</span> <span class=\"br0\">{</span> n <span class=\"sy2\">*</span><span class=\"sy1\">=</span> <span class=\"sy2\">-</span><span class=\"nu0\">1</span><span class=\"sy4\">;</span> <span class=\"br0\">}</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    print<span class=\"br0\">(</span><span class=\"st0\">\"a\"</span>, a<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/container/array\"><span class=\"kw1276\">std::<span class=\"me2\">array</span></span></a> s <span class=\"br0\">{</span> P<span class=\"br0\">{</span><span class=\"nu0\">1</span>,<span class=\"st0\">'a'</span><span class=\"br0\">}</span>, P<span class=\"br0\">{</span><span class=\"nu0\">2</span>, <span class=\"st0\">'b'</span><span class=\"br0\">}</span>, P<span class=\"br0\">{</span><span class=\"nu0\">3</span>, <span class=\"st0\">'c'</span><span class=\"br0\">}</span>, P<span class=\"br0\">{</span><span class=\"nu0\">4</span>, <span class=\"st0\">'d'</span><span class=\"br0\">}</span> <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    print<span class=\"br0\">(</span><span class=\"st0\">\"s\"</span>, s<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"co1\">// Negate data members 'P::first' using projection:</span>\n    std<span class=\"sy4\">::</span><span class=\"me2\">ranges</span><span class=\"sy4\">::</span><span class=\"me2\">for_each_n</span><span class=\"br0\">(</span>s.<span class=\"me1\">begin</span><span class=\"br0\">(</span><span class=\"br0\">)</span>, <span class=\"nu0\">2</span>, <span class=\"br0\">[</span><span class=\"br0\">]</span><span class=\"br0\">(</span><span class=\"kw4\">auto</span><span class=\"sy3\">&amp;</span> x<span class=\"br0\">)</span> <span class=\"br0\">{</span> x <span class=\"sy2\">*</span><span class=\"sy1\">=</span> <span class=\"sy2\">-</span><span class=\"nu0\">1</span><span class=\"sy4\">;</span> <span class=\"br0\">}</span>, <span class=\"sy3\">&amp;</span>P<span class=\"sy4\">::</span><span class=\"me2\">first</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    print<span class=\"br0\">(</span><span class=\"st0\">\"s\"</span>, s<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"co1\">// Capitalize data members 'P::second' using projection:</span>\n    std<span class=\"sy4\">::</span><span class=\"me2\">ranges</span><span class=\"sy4\">::</span><span class=\"me2\">for_each_n</span><span class=\"br0\">(</span>s.<span class=\"me1\">begin</span><span class=\"br0\">(</span><span class=\"br0\">)</span>, <span class=\"nu0\">3</span>, <span class=\"br0\">[</span><span class=\"br0\">]</span><span class=\"br0\">(</span><span class=\"kw4\">auto</span><span class=\"sy3\">&amp;</span> c<span class=\"br0\">)</span> <span class=\"br0\">{</span> c <span class=\"sy2\">-</span><span class=\"sy1\">=</span> <span class=\"st0\">'a'</span><span class=\"sy2\">-</span><span class=\"st0\">'A'</span><span class=\"sy4\">;</span> <span class=\"br0\">}</span>, <span class=\"sy3\">&amp;</span>P<span class=\"sy4\">::</span><span class=\"me2\">second</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    print<span class=\"br0\">(</span><span class=\"st0\">\"s\"</span>, s<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre data-output=\"1\"><code>a: 1, 2, 3, 4, 5\na: -1, -2, -3, 4, 5\ns: {1,'a'}, {2,'b'}, {3,'c'}, {4,'d'}\ns: {-1,'a'}, {-2,'b'}, {3,'c'}, {4,'d'}\ns: {-1,'A'}, {-2,'B'}, {3,'C'}, {4,'d'}</code></pre> \n</div>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr cl