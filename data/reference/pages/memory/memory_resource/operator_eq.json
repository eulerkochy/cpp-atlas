 class=\"br0\">)</span></span></code></div>\n<div class=\"t-li1\"><span class=\"t-li\">2)</span> <code class=\"t-c\"><span class=\"mw-geshi cpp source-cpp\"><span class=\"sy3\">!</span><span class=\"br0\">(</span>a <span class=\"sy1\">==</span> b<span class=\"br0\">)</span></span></code></div>\n<h3 id=\"See_also\">See also </h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/memory/memory_resource/is_equal\"> <span class=\"t-lines\"><span>is_equal</span></span></a></div></div>\n</td>\n<td>  compare for equality with another <code>memory_resource</code> <br> <span class=\"t-mark\">(public member function)</span> </td></tr>\n</table>","headings":[{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"See also","id":"See_also"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"memory","title":"Memory management library"},{"path":"memory/memory_resource","title":"std::pmr::memory_resource"}],"children":[],"map":{"label":"std::pmr::operator==, std::pmr::operator!=","children":[{"label":"Declarations","note":"2 declarations; revisions: since C++17, until C++20. Compares the memory_resources a and b for equality."},{"label":"Return value","note":"&a == &b || a.is_equal(b)"},{"label":"See also","children":[{"label":"is_equal","note":"compare for equality with another memory_resource"}]}]},"standards":["C++17","C++20"],"wordCount":95,"codeBlockCount":0}
