an> v <span class=\"sy1\">=</span> <span class=\"br0\">{</span><span class=\"nu0\">1</span>, <span class=\"nu0\">2</span>, <span class=\"nu0\">3</span>, <span class=\"nu0\">4</span>, <span class=\"nu0\">5</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    static_assert\n    <span class=\"br0\">(</span>\n        vs<span class=\"sy4\">::</span><span class=\"me2\">stride</span><span class=\"br0\">(</span>v, <span class=\"nu0\">1</span><span class=\"br0\">)</span>.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"nu0\">5</span> and\n        vs<span class=\"sy4\">::</span><span class=\"me2\">stride</span><span class=\"br0\">(</span>v, <span class=\"nu0\">2</span><span class=\"br0\">)</span>.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"nu0\">3</span> and\n        vs<span class=\"sy4\">::</span><span class=\"me2\">stride</span><span class=\"br0\">(</span>v, <span class=\"nu0\">3</span><span class=\"br0\">)</span>.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"nu0\">2</span> and\n        vs<span class=\"sy4\">::</span><span class=\"me2\">stride</span><span class=\"br0\">(</span>v, <span class=\"nu0\">4</span><span class=\"br0\">)</span>.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"nu0\">2</span> and\n        vs<span class=\"sy4\">::</span><span class=\"me2\">stride</span><span class=\"br0\">(</span>v, <span class=\"nu0\">5</span><span class=\"br0\">)</span>.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"nu0\">1</span> and\n        vs<span class=\"sy4\">::</span><span class=\"me2\">stride</span><span class=\"br0\">(</span>v, <span class=\"n