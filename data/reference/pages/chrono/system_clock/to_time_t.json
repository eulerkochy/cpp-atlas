a-lang=\"cpp\"><code><span class=\"co2\">#include &lt;chrono&gt;</span>\n<span class=\"co2\">#include &lt;ctime&gt;</span>\n<span class=\"co2\">#include &lt;iostream&gt;</span>\n<span class=\"co2\">#include &lt;thread&gt;</span>\n<span class=\"kw1\">using</span> <span class=\"kw1\">namespace</span> std<span class=\"sy4\">::</span><span class=\"me2\">chrono_literals</span><span class=\"sy4\">;</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <span class=\"co1\">// The old way</span>\n    <a href=\"/w/cpp/chrono/c/time_t\"><span class=\"kw1031\">std::<span class=\"me2\">time_t</span></span></a> oldt <span class=\"sy1\">=</span> <a href=\"/w/cpp/chrono/c/time\"><span class=\"kw1018\">std::<span class=\"me2\">time</span></span></a><span class=\"br0\">(</span><span class=\"br0\">{</span><span class=\"br0\">}</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/thread/sleep_for\"><span class=\"kw2170\">std::<span class=\"me2\">this_thread</span><span class=\"sy4\">::</span><span class=\"me2\">sleep_for</span></span></a><span class=\"br0\">(</span>2700ms<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"co1\">// The new way</span>\n    <span class=\"kw4\">auto</span> <span class=\"kw4\">const</span> now <span class=\"sy1\">=</span> <a href=\"/w/cpp/chrono/system_clock/now\"><span class=\"kw2693\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">system_clock</span><span class=\"sy4\">::</span><span class=\"me2\">now</span></span></a><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/chrono/c/time_t\"><span class=\"kw1031\">std::<span class=\"me2\">time_t</span></span></a> newt <span class=\"sy1\">=</span> std<span class=\"sy4\">::</span><span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">system_clock</span><span class=\"sy4\">::</span><span class=\"me2\">to_time_t</span><span class=\"br0\">(</span>now<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"newt - oldt == \"</span> <span class=\"sy1\">&lt;&lt;</span> newt <span class=\"sy2\">-</span> oldt <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\" s<span class=\"es1\">\\n</span>\"</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Possible output:\n</p>\n<pre data-output=\"1\"><code>newt - oldt == 3 s</code></pre> \n</div>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/chrono/system_clock/from_time_t\"> <span class=\"t-lines\"><span>from_time_t</span></span></a></div><div><span class=\"t-lines\"><span><span class=\"t-cmark\">[static]</span></span></span></div></div>\n</td>\n<td>  converts <span class=\"t-lc\"><a href=\"/w/cpp/chrono/c/time_t\">std::time_t</a></span> to a system clock time point <br> <span class=\"t-mark\">(public static member function)</span> </td></tr>\n</table>","headings":[{"depth":3,"text":"Parameters","id":"Parameters"},{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Example","id":"Example"},{"depth":3,"text":"See also","id":"See_also"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"chrono","title":"Date and time utilities"},{"path":"chrono/system_clock","title":"std::chrono::system_clock"}],"children":[],"map":{"label":"std::chrono::system_clock::to_time_t","children":[{"label":"Declarations","note":"1 declaration; revisions: since C++11. Converts t to a std::time_t type."},{"label":"Parameters","note":"t"},{"label":"Return value","note":"A std::time_t value representing t."},{"label":"Example","note":"Get the current time as 