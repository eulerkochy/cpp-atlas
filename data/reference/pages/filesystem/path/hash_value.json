\">;</span>\n    <a href=\"/w/cpp/container/unordered_set\"><span class=\"kw1297\">std::<span class=\"me2\">unordered_set</span></span></a><span class=\"sy1\">&lt;</span>fs<span class=\"sy4\">::</span><span class=\"me2\">path</span>, PathHash<span class=\"sy1\">&gt;</span> dirs<span class=\"br0\">{</span>\n        <span class=\"st0\">\"/bin\"</span>, <span class=\"st0\">\"/bin\"</span>, <span class=\"st0\">\"/lib\"</span>, <span class=\"st0\">\"/lib\"</span>, <span class=\"st0\">\"/opt\"</span>, <span class=\"st0\">\"/opt\"</span>, <span class=\"st0\">\"/tmp\"</span>, <span class=\"st0\">\"/tmp/../tmp\"</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <span class=\"kw1\">for</span> <span class=\"br0\">(</span>fs<span class=\"sy4\">::</span><span class=\"me2\">path</span> <span class=\"kw4\">const</span><span class=\"sy3\">&amp;</span> p <span class=\"sy4\">:</span> dirs<span class=\"br0\">)</span>\n        <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> p <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">' '</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Possible output:\n</p>\n<pre data-output=\"1\"><code>6050C47ADB62DFE5&nbsp;: \"/tmp\"\n62795A58B69AD90A&nbsp;: \"/tmp/../tmp\"\nFF302110C9991974&nbsp;: \"/a///b\"\nFF302110C9991974&nbsp;: \"/a//b\"\nFD6167277915D464&nbsp;: \"/a/c\"\nC42040F82CD8B542&nbsp;: \"...\"\nD2D30154E0B78BBC&nbsp;: \"..\"\nD18C722215ED0530&nbsp;: \".\"\n               0&nbsp;: \"\"\n\"/tmp/../tmp\" \"/opt\" \"/lib\" \"/tmp\" \"/bin\"</code></pre> \n</div>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-di