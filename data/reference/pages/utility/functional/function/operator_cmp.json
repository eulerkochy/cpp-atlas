>bind</span></span></a><span class=\"br0\">(</span><span class=\"sy3\">&amp;</span>C<span class=\"sy4\">::</span><span class=\"me2\">default_func</span>, this, std<span class=\"sy4\">::</span><span class=\"me2\">placeholders</span><span class=\"sy4\">::</span>_1<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n        void_func_<span class=\"br0\">(</span><span class=\"nu0\">7</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n&nbsp;\n    <span class=\"kw4\">void</span> default_func<span class=\"br0\">(</span><span class=\"kw4\">int</span> i<span class=\"br0\">)</span> <span class=\"br0\">{</span> <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> i <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span> <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n<span class=\"kw1\">private</span><span class=\"sy4\">:</span>\n    SomeVoidFunc void_func_<span class=\"sy4\">;</span>\n<span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n<span class=\"kw4\">void</span> user_func<span class=\"br0\">(</span><span class=\"kw4\">int</span> i<span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span>i <span class=\"sy2\">+</span> <span class=\"nu0\">1</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    C c1<span class=\"sy4\">;</span>\n    C c2<span class=\"br0\">(</span>user_func<span class=\"br0\">)</span><span class=\"s