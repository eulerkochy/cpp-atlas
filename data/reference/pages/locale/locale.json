nst category messages","note":"a bitmask value indicating the messages facet category"},{"label":"const category all","note":"collate | ctype | monetary | numeric | time | messages"}]},{"label":"Member functions","children":[{"label":"(constructor)","note":"constructs a new locale"},{"label":"(destructor)","note":"destructs the locale and the facets whose reference count becomes zero"},{"label":"operator=","note":"replaces a locale"},{"label":"combine","note":"constructs a locale with compile-time identified facet copied from another locale"},{"label":"name","note":"returns the name of the locale or \"*\" if unnamed"},{"label":"encoding","note":"returns the character encoding scheme associated with the locale"},{"label":"operator==, operator!=","note":"equality comparison between locale objects"},{"label":"+3 more"}]},{"label":"Example","note":"Demonstrates the typical prologue of a locale-sensitive program (cross-platform)."},{"label":"See also","children":[{"label":"text_encoding","note":"describes an interface for accessing the IANA Character Sets registry"},{"label":"use_facet","note":"obtains a facet from a locale"},{"label":"has_facet","note":"checks if a locale implements a specific facet"},{"label":"imbue","note":"sets locale"},{"label":"getloc","note":"returns current locale"}]}]},"standards":["C++11","C++20","C++26"],"wordCount":761,"codeBlockCount":2}
