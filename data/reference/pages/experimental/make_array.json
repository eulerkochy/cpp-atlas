an class=\"br0\">{</span> <span class=\"kw1\">using</span> type <span class=\"sy1\">=</span> D<span class=\"sy4\">;</span> <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span><span class=\"kw1\">class</span>... <span class=\"me1\">Types</span><span class=\"sy1\">&gt;</span>\n    <span class=\"kw1\">struct</span> return_type_helper<span class=\"sy1\">&lt;</span><span class=\"kw4\">void</span>, Types...<span class=\"sy1\">&gt;</span> <span class=\"sy4\">:</span> <a href=\"/w/cpp/types/common_type\"><span class=\"kw640\">std::<span class=\"me2\">common_type</span></span></a><span class=\"sy1\">&lt;</span>Types...<span class=\"sy1\">&gt;</span>\n    <span class=\"br0\">{</span>\n        static_assert<span class=\"br0\">(</span><a href=\"/w/cpp/types/conjunction\"><span class=\"kw647\">std::<span class=\"me2\">conjunction_v</span></span></a><span class=\"sy1\">&lt;</span>not_ref_wrapper<span class=\"sy1\">&lt;</span>Types<span class=\"sy1\">&gt;</span>...<span class=\"sy1\">&gt;</span>,\n                      <span class=\"st0\">\"Types cannot contain reference_wrappers when D is void\"</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span><span class=\"kw1\">class</span> D, <span class=\"kw1\">class</span>... <span class=\"me1\">Types</span><span class=\"sy1\">&gt;</span>\n    <span class=\"kw1\">using</span> return_type <span class=\"sy1\">=</span> <a href=\"/w/cpp/container/array\"><span class=\"kw1276\">std::<span class=\"me2\">array</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw1\">typename</span> return_type_helper<span class=\"sy1\">&lt;</span>D, Types...<span class=\"sy1\">&gt;</span><span class=\"sy4\">::</span><span class=\"me2\">type</span>,\n                                   sizeof...<span class=\"br0\">(</span>Types<s