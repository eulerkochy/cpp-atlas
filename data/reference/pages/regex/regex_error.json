2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"The code was error_brack<span class=\"es1\">\\n</span>\"</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Possible output:\n</p>\n<pre data-output=\"1\"><code>regex_error caught: The expression contained mismatched [ and ].\nThe code was error_brack</code></pre> \n</div>","headings":[{"depth":3,"text":"Member functions","id":"Member_functions"},{"depth":2,"text":"Inherited from std::runtime_error","id":"Inherited_from_std::runtime_error"},{"depth":2,"text":"Inherited from std::exception","id":"Inherited_from_std::exception"},{"depth":3,"text":"Member functions","id":"Member_functions_2"},{"depth":3,"text":"Example","id":"Example"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"regex","title":"Regular expressions library (since C++11)"}],"children":[{"path":"regex/regex_error/code","title":"std::regex_error::code"},{"path":"regex/regex_error/operator=","title":"std::regex_error::operator="},{"path":"regex/regex_error/regex_error","title":"std::regex_error::regex_error"}],"map":{"label":"std::regex_error","children":[{"label":"Declarations","note":"1 declaration; revisions: since C++11. Defines the type of exception object thrown to report errors in the regular expressions library."},{"label":"Member functions","children":[{"label":"(constructor)","note":"constructs a regex_error object"},{"label":"operator=","note":"replaces the regex_error object"},{"label":"code","note":"gets the std::regex_constants::error_type for a regex_error"}]},{"label":"Inherited from std::runtime_error"},{"label":"Inherited from std::exception","children":[{"label":"Member functions"},{"label":"Example"}]}]},"standards":["C++11"],"wordCount":137,"codeBlockCount":2}
