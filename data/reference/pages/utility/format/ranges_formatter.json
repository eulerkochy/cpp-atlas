"note":"formatting utility for ranges in set form"},{"label":"range-default-formatter<std::range_format::string>…","note":"formatting utility for ranges in string or escaped string form"}]},{"label":"Example"},{"label":"See also","children":[{"label":"formatter","note":"defines formatting rules for a given type"},{"label":"range_formatter","note":"class template that helps implementing std::formatter specializations for range types"}]}]},"standards":["C++20","C++23"],"wordCount":243,"codeBlockCount":0}
