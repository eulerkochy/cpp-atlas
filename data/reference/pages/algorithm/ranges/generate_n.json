distribution</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span><span class=\"sy1\">&gt;</span> distr <span class=\"br0\">{</span><span class=\"nu0\">1</span>, <span class=\"nu0\">6</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <span class=\"kw4\">static</span> <a href=\"/w/cpp/numeric/random/random_device\"><span class=\"kw1495\">std::<span class=\"me2\">random_device</span></span></a> engine<span class=\"sy4\">;</span>\n    <span class=\"kw4\">static</span> <a href=\"/w/cpp/numeric/random/mersenne_twister_engine\"><span class=\"kw1498\">std::<span class=\"me2\">mt19937</span></span></a> noise <span class=\"br0\">{</span>engine<span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <span class=\"kw1\">return</span> distr<span class=\"br0\">(</span>noise<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span>\n&nbsp;\n<span class=\"kw4\">void</span> print<span class=\"br0\">(</span><span class=\"kw4\">const</span> <span class=\"kw4\">auto</span><span class=\"sy3\">&amp;</span> v, <a href=\"/w/cpp/string/basic_string_view\"><span class=\"kw1256\">std::<span class=\"me2\">string_view</span></span></a> comment<span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <span class=\"kw1\">for</span> <span class=\"br0\">(</span><span class=\"kw4\">int</span> i <span class=\"sy4\">:</span> v<span class=\"br0\">)</span>\n        <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> i <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">' '</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'('</span> <span class=\"sy1\">&lt;&lt;</span> comment <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\")<span c