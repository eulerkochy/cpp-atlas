a>\n</th></tr>\n<tr>\n<td>\n<pre data-lang=\"cpp\"><code><span class=\"kw1\">struct</span> __contains_subrange_fn\n<span class=\"br0\">{</span>\n    <span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/iterator/forward_iterator\"><span class=\"kw2884\">std::<span class=\"me2\">forward_iterator</span></span></a> I1, <a href=\"/w/cpp/iterator/sentinel_for\"><span class=\"kw2880\">std::<span class=\"me2\">sentinel_for</span></span></a><span class=\"sy1\">&lt;</span>I1<span class=\"sy1\">&gt;</span> S1,\n             <a href=\"/w/cpp/iterator/forward_iterator\"><span class=\"kw2884\">std::<span class=\"me2\">forward_iterator</span></span></a> I2, <a href=\"/w/cpp/iterator/sentinel_for\"><span class=\"kw2880\">std::<span class=\"me2\">sentinel_for</span></span></a><span class=\"sy1\">&lt;</span>I2<span class=\"sy1\">&gt;</span> S2,\n             <span class=\"kw1\">class</span> Pred <span class=\"sy1\">=</span> <a href=\"/w/cpp/utility/functional/ranges/equal_to\"><span class=\"kw2859\">ranges::<span class=\"me2\">equal_to</span></span></a>,\n             <span class=\"kw1\">class</span> Proj1 <span class=\"sy1\">=</span> <a href=\"/w/cpp/utility/functional/identity\"><span class=\"kw2741\">std::<span class=\"me2\">identity</span></span></a>, <span class=\"kw1\">class</span> Proj2 <span class=\"sy1\">=</span> <a href=\"/w/cpp/utility/functional/identity\"><span class=\"kw2741\">std::<span class=\"me2\">identity</span></span></a><span class=\"sy1\">&gt;</span>\n    requires <a href=\"/w/cpp/iterator/indirectly_comparable\"><span class=\"kw3142\">std::<span class=\"me2\">indirectly_comparable</span></span></a><span class=\"sy1\">&lt;</span>I1, I2, Pred, Proj1, Proj2<span class=\"sy1\">&gt;</span>\n    <span class=\"kw4\">constexpr</span> <span class=\"kw4\">bool</span> operator<span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">(</span>I1 first1, S1 last1,\n                              I2 first2, S2 last2,\n                              Pred pred <span class=\"sy1\">=</span> <span class=\"br0\">{</span><span class=\"br0\">}</span>,\n                              Proj1 proj1 <span class=\"sy1\">=</span> <span class=\"br0\">{</span><span class=\"br0\">}</span>, Proj2 proj2 <span class=\"sy1\">=</span> <span class=\"br0\">{</span><span class=\"br0\">}</span><span class=\"br0\">)</span> <span class=\"kw4\">const</span>\n    <span class=\"br0\">{</span>\n        <span class=\"kw1\">return</span> <span class=\"br0\">(</span>first2 <span class=\"sy1\">==</span> last2<span class=\"br0\">)</span> <span class=\"sy3\">||</span>\n               <span class=\"sy3\">!</span><a href=\"/w/cpp/algorithm/ranges/search\"><span class=\"kw3073\">ranges::<span class=\"me2\">search</span></span></a><span class=\"br0\">(</span>first1, last1, first2, last2, pred, proj1, proj2<span class=\"br0\">)</span>.<span class=\"me1\">empty</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n&nbsp;\n    <span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/ranges/forward_range\"><span class=\"kw2922\">ranges::<span class=\"me2\">forward_range</span></span></a> R1, <a href=\"/w/cpp/ranges/forward_range\"><span class=\"kw2922\">ranges::<span class=\"me2\">forward_range</span></span></a> R2,\n             <span class=\"kw1\">class</span> Pred <span class=\"sy1\">=</span> <a href=\"/w/cpp/utility/functional/ranges/equal_to\"><span class=\"kw2859\">ranges::<span class=\"me2\">equal_to</span></span></a>,\n             <span class=\"kw1\">class</span> Proj1 <span class=\"sy1\">=</span> <a href=\"/w/cpp/utility/functional/identity\"><span class=\"kw2741\">std::<span class=\"me2\">identity</span></span></a>, <span class=\"kw1\">class</span> Proj2 <span class=\"sy1\">=</span> <a href=\"/w/cpp/utility/functional/identity\"><span class=\"kw2741\">std::<span class=\"me2\">identity</span></span></a><span class=\"sy1\">&gt;</span