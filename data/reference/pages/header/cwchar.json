 reports","id":"Defect_reports"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"header","title":"C++ Standard Library headers"}],"children":[],"map":{"label":"Standard library header <cwchar>","children":[{"label":"Macros","children":[{"label":"NULL","note":"implementation-defined null pointer constant"},{"label":"WEOF","note":"a non-character value of type std::wint_t used to indicate errors"},{"label":"WCHAR_MIN","note":"the smallest valid value of wchar_t"},{"label":"WCHAR_MAX","note":"the largest valid value of wchar_t"}]},{"label":"Types","children":[{"label":"mbstate_t","note":"conversion state information necessary to iterate multibyte character strings"},{"label":"size_t","note":"unsigned integer type returned by the sizeof operator"},{"label":"wint_t","note":"integer type that can hold any valid wide character and at least one more value"},{"label":"tm","note":"calendar time type"}]},{"label":"Functions","children":[{"label":"wcscpy","note":"copies one wide string to another"},{"label":"wcsncpy","note":"copies a certain amount of wide characters from one string to another"},{"label":"wcscat","note":"appends a copy of one wide string to another"},{"label":"wcsncat","note":"appends a certain amount of wide characters from one wide string to another"},{"label":"wcsxfrm","note":"transform a wide string so that wcscmp would produce the same result as wcscoll"},{"label":"wcslen","note":"returns the length of a wide string"},{"label":"wcscmp","note":"compares two wide strings"},{"label":"+38 more"}]},{"label":"Notes"},{"label":"Synopsis"}]},"standards":["C++11"],"wordCount":1347,"codeBlockCount":1}
