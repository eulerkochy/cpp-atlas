\"><span class=\"kw3360\">std::<span class=\"me2\">flat_multimap</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span>, <span class=\"kw4\">double</span><span class=\"sy1\">&gt;</span> map<span class=\"br0\">{</span><span class=\"br0\">{</span><span class=\"nu0\">1</span>, <span class=\"nu16\">1.1</span><span class=\"br0\">}</span>, <span class=\"br0\">{</span><span class=\"nu0\">2</span>, <span class=\"nu16\">2.2</span><span class=\"br0\">}</span>, <span class=\"br0\">{</span><span class=\"nu0\">3</span>, <span class=\"nu16\">3.3</span><span class=\"br0\">}</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"co1\">// The default values container is std::vector:</span>\n    static_assert<span class=\"br0\">(</span><a href=\"/w/cpp/types/is_same\"><span class=\"kw592\">std::<span class=\"me2\">is_same_v</span></span></a><span class=\"sy1\">&lt;</span>decltype<span class=\"br0\">(</span>map.<span class=\"me1\">values</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span>, <span class=\"kw4\">const</span> <a href=\"/w/cpp/container/vector\"><span class=\"kw1277\">std::<span class=\"me2\">vector</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span><span class=\"sy1\">&gt;</span><span class=\"sy3\">&amp;</span><span class=\"sy1\">&gt;</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/io/println\"><span class=\"kw3402\">std::<span class=\"me2\">println</span></span></a><span class=\"br0\">(</span><span class=\"st0\">\"{}\"</span>, map.<span class=\"me1\">values</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre data-output=\"1\"><code>[1.1, 2.2, 3.3]</code></pre> \n</div>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td>  <div class