/span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">}</span><span class=\"sy4\">;</span> <span class=\"co1\">// C++23, (6)</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>c4.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"nu0\">5</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"co2\"># endif</span>\n&nbsp;\n<span class=\"co2\"># if __cpp_lib_containers_ranges &gt;= 202202L</span>\n    <span class=\"co1\">// C++23, overload (13)</span>\n    <span class=\"kw4\">auto</span> c5 <span class=\"sy1\">=</span> <a href=\"/w/cpp/container/stack\"><span class=\"kw1305\">std::<span class=\"me2\">stack</span></span></a><span class=\"br0\">(</span><a href=\"/w/cpp/ranges/from_range\"><span class=\"kw3603\">std::<span class=\"me2\">from_range_t</span></span></a>, std<span class=\"sy4\">::</span><a href=\"/w/cpp/algorithm/ranges/iota\"><span class=\"kw3667\">ranges::<span class=\"me2\">iota</span></span></a><span class=\"br0\">(</span><span class=\"nu0\">0</span>, <span class=\"nu0\">42</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>c5.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"nu0\">42</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"co1\">// the same effect with pipe syntax, internally uses overload (13)</span>\n    <span class=\"kw4\">auto</span> c6 <span class=\"sy1\">=</span> std<span class=\"sy4\">::</span><a href=\"/w/cpp/algorithm/ranges/iota\"><span class=\"kw3667\">ranges::<span class=\"me2\">iota</span></span></a><span class=\"br0\">(</span><span class=\"nu0\">0</span>, <span class=\"nu0\">42</span><span class=\"br0\">)</span> <span class=\"sy3\">|</span> std<span class=\"sy4\">::</span><a href=\"/w/cpp/ranges/to\"><span class=\"kw3711\">ranges::<span class=\"me2\">to</span></span></a><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/container/stack\"><span class=\"kw1305\">std::<span class=\"me2\">stack</span></span></a><span class=\"sy1\">&gt;</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>c6.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"nu0\">42</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/memory/allocator\"><span class=\"kw704\">std::<span class=\"me2\">allocator</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span><span class=\"sy1\">&gt;</span> alloc<span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"co1\">// C++23, overload (14)</span>\n    <span class=\"kw4\">auto</span> c7 <span class=\"sy1\">=</span> <a href=\"/w/cpp/container/stack\"><span class=\"kw1305\">std::<span class=\"me2\">stack</span></span></a><span class=\"br0\">(</span><a href=\"/w/cpp/ranges/from_range\"><span class=\"kw3603\">std::<span class=\"me2\">from_range_t</span></span></a>, std<span class=\"sy4\">::</span><a href=\"/w/cpp/algorithm/ranges/iota\"><span class=\"kw3667\">ranges::<span class=\"me2\">iota</span></span></a><span class=\"br0\">(</span><span class=\"nu0\">0</span>, <span class=\"nu0\">42</span><span class=\"br0\">)</span>, alloc<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>c7.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"nu0\">42</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"co1\">// the same effect with pipe syntax, internally uses overload (14)</span>\n    <span class=\"kw4\">auto</span> c8 <span class=\"sy1\">=</span> std<span class=\"sy4\">::</span><a href=\"/w/cpp/algorithm/ranges/iota\"><span class=\"kw3667\">ranges::<span class=\"me2\">iota</span></span></a><span class=\"br0\">(</span><span class=\"nu0\">0</span>, <span class=\"nu0\">42</span><span class=\"br0\">)</span> <span class=\"sy3\">|</span> std<span class=\"sy4\">::</span><a href=\"/w/cpp/ranges/to\"><span class=\"kw3711\">ranges::<span class=\"me2\">to</span></span></a><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/container/stack\"><span class=\"kw1305\">std::<span class=\"me2\">stack</span></span></a><span class=\"sy1\">&gt;</span><span class=\"br0\">(</span>alloc<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>c8.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"nu0\">42</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"co2\"># endif</span>\n<span class=\"br0\">}</span></code></pre>\n</div>\n<h3 id=\"Defect_reports\">Defect reports</h3>\n<p>The following behavior-changing defect reports were applied retroactively to previously published C++ standards.\n</p>\n<table class=\"dsctable\">\n<tr>\n<th>DR\n</th>\n<th>Applied to\n</th>\n<th>Behavior as published\n</th>\n<th>Correct behavior\n</th></tr>\n<tr>\n<td><a class=\"external text\" href=\"https://wg21.link/P0935R0\" data-external=\"1\">P0935R0</a>\n</td>\n<td>C++11\n</td>\n<td>default constructor was explicit\n</td>\n<td>made implicit\n</td></tr></table>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/container/stack/operator=\"> <span class=\"t-