me2\">ranges</span><span class=\"sy4\">::</span><span class=\"me2\">next</span><span class=\"br0\">(</span>v.<span class=\"me1\">begin</span><span class=\"br0\">(</span><span class=\"br0\">)</span>, v.<span class=\"me1\">end</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n        <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>n <span class=\"sy1\">==</span> v.<span class=\"me1\">end</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n    <span class=\"br0\">{</span>\n        <span class=\"kw4\">auto</span> n <span class=\"sy1\">=</span> std<span class=\"sy4\">::</span><span class=\"me2\">ranges</span><span class=\"sy4\">::</span><span class=\"me2\">next</span><span class=\"br0\">(</span>v.<span class=\"me1\">begin</span><span class=\"br0\">(</span><span class=\"br0\">)</span>, <span class=\"nu0\">42</span>, v.<span class=\"me1\">end</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n        <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>n <span class=\"sy1\">==</span> v.<span class=\"me1\">end</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n<span class=\"br0\">}</span></code></pre>\n</div>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td> <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/iterator/ranges/prev\"> <span class=\"t-lines\"><span>ranges::prev</span></span></a></div><div><span class=\"t-lines\"><span><span class=\"t-mark-rev t-since-cxx20\">(C++20)</span></span></span></div></div>\n</td>\n<td> decrement an iterator by a given distance or to a bound<br><span class=\