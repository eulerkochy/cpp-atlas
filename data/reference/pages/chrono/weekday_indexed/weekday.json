uesday =&gt; 2nd Thursday</span>\n    wdi <span class=\"sy1\">=</span> <span class=\"br0\">{</span>wdi.<span class=\"me1\">weekday</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy2\">+</span> <a href=\"/w/cpp/chrono/duration\"><span class=\"kw1004\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">days</span></span></a><span class=\"br0\">(</span><span class=\"nu0\">2</span><span class=\"br0\">)</span>, wdi.<span class=\"me1\">index</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span><a href=\"/w/cpp/chrono/year_month_day\"><span class=\"kw2574\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">year_month_day</span></span></a><span class=\"br0\">{</span>wdi<span class=\"sy2\">/</span><span class=\"nu0\">10</span><span class=\"sy2\">/</span><span class=\"nu0\">2019</span><span class=\"br0\">}</span> <span class=\"sy1\">==</span> \n                  <a href=\"/w/cpp/chrono/year_month_day\"><span class=\"kw2574\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">year_month_day</span></span></a><span class=\"br0\">{</span><a href=\"/w/cpp/chrono/month\"><span class=\"kw2631\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">October</span></span></a><span class=\"sy2\">/</span><span class=\"nu0\">10</span><span class=\"sy2\">/</span><span class=\"nu0\">2019</span><span class=\"br0\">}</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre data-output=\"1\"><code>true true</code></pre> \n</div>\n