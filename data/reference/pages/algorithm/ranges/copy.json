span class=\"sy4\">;</span>\n<span class=\"co1\">// or, alternatively,</span>\n<span class=\"co1\">//  std::vector&lt;int&gt; destination(source.size());</span>\n<span class=\"co1\">//  std::ranges::copy(source.begin(), source.end(), destination.begin());</span>\n<span class=\"co1\">// either way is equivalent to</span>\n<span class=\"co1\">//  std::vector&lt;int&gt; destination = source;</span>\n&nbsp;\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"destination contains: \"</span><span class=\"sy4\">;</span>\n&nbsp;\n    std<span class=\"sy4\">::</span><a href=\"/w/cpp/algorithm/ranges/copy\"><span class=\"kw2868\">ranges::<span class=\"me2\">copy</span></span></a><span class=\"br0\">(</span>destination, <a href=\"/w/cpp/iterator/ostream_iterator\"><span class=\"kw675\">std::<span class=\"me2\">ostream_iterator</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span><span class=\"sy1\">&gt;</span><span class=\"br0\">(</span><a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a>, <span class=\"st0\">\" \"</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"odd numbers in destination are: \"</span><span class=\"sy4\">;</span>\n&nbsp;\n    std<span class=\"sy4\">::</span><a href=\"/w/cpp/algorithm/ranges/copy\"><span class=\"kw2869\">ranges::<span class=\"me2\">copy_if</span></span></a><span class=\"br0\">(</span>destination, <a href=\"/w/cpp/iterator/ostream_iterato