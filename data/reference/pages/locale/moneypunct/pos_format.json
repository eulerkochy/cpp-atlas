ncy identifier"},{"label":"do_positive_sign, do_negative_sign","note":"provides the string to indicate a positive or negative value"},{"label":"do_get","note":"parses a monetary value from an input stream"},{"label":"do_put","note":"formats a monetary value and writes to output stream"}]}]},"standards":[],"wordCount":286,"codeBlockCount":2}
