=\"kw4\">char</span><span class=\"sy2\">*</span><span class=\"sy1\">&gt;</span> s<span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span><span class=\"sy3\">!</span>s.<span class=\"me1\">matched</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n</div>","headings":[{"depth":3,"text":"Example","id":"Example"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"regex","title":"Regular expressions library (since C++11)"},{"path":"regex/sub_match","title":"std::sub_match"}],"children":[],"map":{"label":"std::sub_match<BidirIt>::sub_match","children":[{"label":"Declarations","note":"1 declaration; revisions: since C++11. Default constructs a std::sub_match."},{"label":"Example"}]},"standards":["C++11"],"wordCount":46,"codeBlockCount":1}
