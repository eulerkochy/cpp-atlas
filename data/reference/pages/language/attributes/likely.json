sy1\">&gt;</span> <span class=\"nu0\">1</span><span class=\"br0\">)</span>\n            <span class=\"kw1\">return</span> n <span class=\"sy2\">*</span> fact<span class=\"br0\">(</span>n <span class=\"sy2\">-</span> <span class=\"nu0\">1</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n        <span class=\"kw1\">else</span>\n            <span class=\"kw1\">return</span> <span class=\"nu0\">1</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n    <span class=\"kw4\">constexpr</span> <span class=\"kw4\">double</span> cos<span class=\"br0\">(</span><span class=\"kw4\">double</span> x<span class=\"br0\">)</span> <span class=\"kw1\">noexcept</span>\n    <span class=\"br0\">{</span>\n        <span class=\"kw4\">constexpr</span> <span class=\"kw4\">long</span> <span class=\"kw4\">long</span> precision<span class=\"br0\">{</span>16LL<span class=\"br0\">}</span><span class=\"sy4\">;</span>\n        <span class=\"kw4\">double</span> y<span class=\"br0\">{</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n        <span class=\"kw1\">for</span> <span class=\"br0\">(</span><span class=\"kw4\">auto</span> n<span class=\"br0\">{</span>0LL<span class=\"br0\">}</span><span class=\"sy4\">;</span> n <span class=\"sy1\">&lt;</span> precision<span class=\"sy4\">;</span> n <span class=\"sy2\">+</span><span class=\"sy1\">=</span> 2LL<span class=\"br0\">)</span>\n            y <span class=\"sy2\">+</span><span class=\"sy1\">=</span> pow<span class=\"br0\">(</span>x, n<span class=\"br0\">)</span> <span class=\"sy2\">/</span> <span class=\"br0\">(</span>n <span class=\"sy3\">&amp;</span> 2LL <span class=\"sy4\">?</span> <span class=\"sy2\">-</span>fact<span class=\"br0\">(</span>n<span class=\"br0\">)</span> <span class=\"sy4\">:</span> fact<span class=\"br0\">(</span>n<span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n        <span class=\"kw1\">return</span> y<span class=\"sy4\">;</span>\n    <span class=\"