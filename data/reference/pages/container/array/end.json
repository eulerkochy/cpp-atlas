</span>   <span class=\"co1\">// OK</span>\n    static_assert<span class=\"br0\">(</span>constants.<span class=\"me1\">cbegin</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy3\">!</span><span class=\"sy1\">=</span> constants.<span class=\"me1\">cend</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span> <span class=\"co1\">// OK</span>\n    static_assert<span class=\"br0\">(</span><span class=\"sy2\">*</span>constants.<span class=\"me1\">begin</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"st0\">'A'</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>              <span class=\"co1\">// OK</span>\n    static_assert<span class=\"br0\">(</span><span class=\"sy2\">*</span>constants.<span class=\"me1\">cbegin</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"st0\">'A'</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>             <span class=\"co1\">// OK</span>\n    <span class=\"co1\">// *constants.begin() = 'Z'; // compile-time error: </span>\n                                 <span class=\"co1\">// read-only variable is not assignable</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre data-output=\"1\"><code>1) true true\n2) false false\n3) 5 5\n4) 1\n5) 1 2 3 4</code></pre> \n</div>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/container/array/begin\"> <span class=\"t-lines\"><span>begin</span><span>cbegin</span></span></a></div></div>\n</td>\n<td>  returns an iterator to the beginning <br> <span class=\"t-mark\">(public member function)</span> </td></tr>\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/iterator/end\"> <span class=\"t-lines\"><span>end</span><span>cend</span></sp