_bound</span></span></a><span class=\"br0\">(</span>first, last, value, <a href=\"/w/cpp/utility/functional/ref\"><span class=\"kw1076\">std::<span class=\"me2\">ref</span></span></a><span class=\"br0\">(</span>comp<span class=\"br0\">)</span>, <a href=\"/w/cpp/utility/functional/ref\"><span class=\"kw1076\">std::<span class=\"me2\">ref</span></span></a><span class=\"br0\">(</span>proj<span class=\"br0\">)</span><span class=\"br0\">)</span>\n        <span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n&nbsp;\n    <span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/ranges/forward_range\"><span class=\"kw2922\">ranges::<span class=\"me2\">forward_range</span></span></a> R, <span class=\"kw1\">class</span> Proj <span class=\"sy1\">=</span> <a href=\"/w/cpp/utility/functional/identity\"><span class=\"kw2741\">std::<span class=\"me2\">identity</span></span></a>,\n             <span class=\"kw1\">class</span> T <span class=\"sy1\">=</span> std<span class=\"sy4\">::</span><span class=\"me2\">projected_value_t</span><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/ranges/iterator_t\"><span class=\"kw2908\">ranges::<span class=\"me2\">iterator_t</span></span></a><span class=\"sy1\">&lt;</span>R<span class=\"sy1\">&gt;</span>, Proj<span class=\"sy1\">&gt;</span>,\n             <a href=\"/w/cpp/iterator/indirect_strict_weak_order\"><span class=\"kw3150\">std::<span class=\"me2\">indirect_strict_weak_order</span></span></a>\n                 <span class=\"sy1\">&lt;</span><span class=\"kw4\">const</span> T<span class=\"sy2\">*</span>, std<span class=\"sy4\">::</span><a href=\"/w/cpp/iterator/projected\"><span class=\"kw2695\">projected</span></a><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/ranges/iterator_t\"><span class=\"kw2908\">ranges::<span class=\"me2\">iterator_t</span></span></a><span class=\"sy1\">&lt;</span>R<span class=\"sy1\">&gt;</span>,\n                                           Proj<span cla