/cpp/string/byte/isxdigit\"><code>isxdigit</code></a><br>\n<a href=\"/w/cpp/string/wide/iswxdigit\"><code>iswxdigit</code></a>\n</p>\n</th></tr>\n<tr>\n<th>decimal\n</th>\n<th>hexadecimal\n</th>\n<th>octal\n</th></tr>\n<tr>\n<td>0–8\n</td>\n<td><code>\\x0</code>–<code>\\x8</code>\n</td>\n<td><code>\\0</code>–<code>\\10</code>\n</td>\n<td>control codes (<code>NUL</code>, etc.)\n</td>\n<td class=\"table-yes\"><b><code>≠0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td></tr>\n<tr>\n<td>9\n</td>\n<td><code>\\x9</code>\n</td>\n<td><code>\\11</code>\n</td>\n<td>tab (<code>\\t</code>)\n</td>\n<td class=\"table-yes\"><b><code>≠0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-yes\"><b><code>≠0</code></b>\n</td>\n<td class=\"table-yes\"><b><code>≠0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td>\n<td class=\"table-no\"> <b><code>0</code></b>\n</td></tr>\n<tr>\n<td>10–13\n</td>\n<td><code>\\xA</code>–<code>\\xD</code>\n</td>\n<td><code>\\12</code>–<code>\\15</code>\n</td>\n<td>whitespaces (<code>\\n</code>, <code>\\v</code>, <code>\\f</code