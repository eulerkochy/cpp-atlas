>&gt;</span><span class=\"sy2\">*</span> pv <span class=\"br0\">)</span> <span class=\"kw1\">noexcept</span><span class=\"sy4\">;</span></span></div></td>\n<td class=\"t-dcl-nopad\">  </td>\n<td class=\"t-dcl-nopad\">  </td>\n</tr>\n<tr class=\"t-dcl\">\n<td class=\"t-dcl-nopad\"> <div><span class=\"mw-geshi cpp source-cpp\"><span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span> <a href=\"/w/cpp/types/size_t\"><span class=\"kw107\">std::<span class=\"me2\">size_t</span></span></a> I, <span class=\"kw1\">class</span>... <span class=\"me1\">Types</span> <span class=\"sy1\">&gt;</span><br><span class=\"kw4\">constexpr</span> <a href=\"/w/cpp/types/add_pointer\"><span class=\"kw620\">std::<span class=\"me2\">add_pointer_t</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">const</span> <a href=\"/w/cpp/utility/variant/variant_alternative\"><span class=\"kw1101\">std::<span class=\"me2\">variant_alternative_t</span></span></a><span class=\"sy1\">&lt;</span>I, <a href=\"/w/cpp/utility/variant\"><span class=\"kw1093\">std::<span class=\"me2\">variant</span></span></a><span class=\"sy1\">&lt;</span>Types...<span class=\"sy1\">&gt;&gt;&gt;</span><br>&nbsp; &nbsp; get_if<span class=\"br0\">(</span> <span class=\"kw4\">const</span> <a href=\"/w/cpp/utility/variant\"><span class=\"kw1093\">std::<span class=\"me2\">variant</span></span></a><span class=\"sy1\">&lt;</span>Types...<span class=\"sy1\">&gt;</span><span class=\"sy2\">*</span> pv <span class=\"br0\">)</span> <span class=\"kw1\">noexcept</span><span class=\"sy4\">;</span></span></div></td>\n<td class=\"t-dcl-nopad\">  </td>\n<td class=\"t-dcl-nopad\">  </td>\n</tr>\n</tbody><tbody>\n</tbody>\n<tbody class=\"t-dcl-rev t-dcl-rev-num t-dcl-rev-notes t-since-cxx17\"><tr class=\"t-dcl-rev-aux\" id=\"Version_2\">\n<td></td>\n<td rowspan=\"142\">(2)</td>\n<td rowspan=\"142\"><span class=\"t-mark-rev t-since-cxx17\">(since C++17)</span></td>\n</tr>\n<tr class=\"t-dcl\">\n<td class=\"t-dcl-nopad\"> <div><span class=\"mw-geshi cpp source-cpp\"><span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span> <span class=\"kw1\">class</span> T, <span class=\"kw1\">class</span>... <span class=\"me1\">Types</span> <span class=\"sy1\">&gt;</span><br><span class=\"kw4\">constexpr</span> <a href=\"/w/cpp/types/add_pointer\"><span class=\"kw620\">std::<span class=\"me2\">add_pointer_t</span></span></a><span class=\"sy1\">&lt;</span>T<span class=\"sy1\">&gt;</span><br>&nbsp; &nbsp; get_if<span class=\"br0\">(</span> <a href=\"/w/cpp/utility/variant\"><span class=\"kw1093\">std::<span class=\"me2\">variant</span></span></a><span class=\"sy1\">&lt;</span>Types...<span class=\"sy1\">&gt;</span><span class=\"sy2\">*</span> pv <span class=\"br0\">)</span> <span class=\"kw1\">noexcept</span><span class=\"sy4\">;</span></span></div></td>\n<td class=\"t-dcl-nopad\">  </td>\n<td class=\"t-dcl-nopad\">  </td>\n</tr>\n<tr class=\"t-dcl\">\n<td class=\"t-dcl-nopad\"> <div><span class=\"mw-geshi cpp source-cpp\"><span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span> <span class=\"kw1\">class</span> T, <span class=\"kw1\">class</span>... <span class=\"me1\">Types</span> <span class=\"sy1\">&gt;</span><br><span class=\"kw4\">constexpr</span> <a href=\"/w/cpp/types/add_pointer\"><span class=\"kw620\">std::<span class=\"me2\">add_pointer_t</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">const</span> T<span class=\"sy1\">&gt;</span><br>&nbsp; &nbsp; get_if<span class=\"br0\">(</span> <span class=\"kw4\">const</span> <a href=\"/w/cpp/utility/variant\"><span class=\"kw1093\">std::<span class=\"me2\">variant</span></span></a><span class=\"sy1\">&lt;</span>Types...<span class=\"sy1\">&gt;</span><span class=\"sy2\">*</span> pv <span class=\"br0\">)</span> <span class=\"kw1\">noexcept</span><span class=\"sy4\">;</span></span></div></td>\n<td class=\"t-dcl-nopad\">  </td>\n<td class=\"t-dcl-nopad\">  </td>\n</tr>\n</tbody><tbody>\n<tr class=\"t-dcl-sep\"><td></td><td></td><td></td></tr>\n</tbody></table>\n<div class=\"t-li1\"><span class=\"t-li\">1)</span> Index-based non-throwing accessor: If <code class=\"t-c\"><span class=\"mw-geshi cpp source-cpp\">pv</span></code> is not a null pointer and <code class=\"t-c\"><span class=\"mw-geshi cpp source-cpp\">pv<span class=\"sy2\">-</span><span class=\"sy1\">&gt;</span>index<span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">==</span> I</span></code>, returns a pointer to the value stored in the variant pointed to by <code class=\"t-c\"><span class=\"mw-geshi cpp source-cpp\">pv</span></code>. Otherwise, returns a null pointer value. The call is ill-formed if <code>I</code> is not a valid index in the variant.</div>\n<div class=\"t-li1\"><span class=\"t-li\">2)</span> Type-based non-throwing accessor: Equivalent to <span class=\"t-v\">(1)</span> with <code>I</code> being the zero-based index of <code>T</code> in <code class=\"t-c\"><span class=\"mw-geshi cpp source-cpp\">Types...</span></code>. The call is ill-formed if <code>T</code> is not a unique element of <code class=\"t-c\"><span class=\"mw-geshi cpp source-cpp\">Types...</span></code>.</div>\n<h3 id=\"Template_parameters\">Template parameters</h3>\n<table class=\"t-par-begin\">\n<tr class=\"t-par\">\n<td> I\n</td>\n<td> -\n</td>\n<td> index to look up\n</td></tr>\n<tr class=\"t-par\">\n<td> Type\n</td>\n<td> -\n</td>\n<td> unique type to look up\n</td></tr></table>\n<h3 id=\"Parameters\">Parameters</h3>\n<table class=\"t-par-begin\">\n<tr class=\"t-par\">\n<td> pv\n</td>\n<td> -\n</td>\n<td> pointer to a variant\n</td></tr></table>\n<h3 id=\"Return_value\">Return value</h3>\n<p>Pointer to the value stored in the pointed-to variant or null pointer on error.\n</p>\n<h3 id=\"Example\">Example</h3>\n<div class=\"t-example\">\n<pre data-lang=\"cpp\"><code><span class=\"co2\">#include &lt;iostream&gt;</span>\n<span class=\"co2\">#include &lt;variant&gt;</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <span class=\"kw4\">auto</span> check_value <span class=\"sy1\">=</span> <span class=\"br0\">[</span><span class=\"br0\">]</span><span class=\"br0\">(</span><span class=\"kw4\">const</span> <a href=\"/w/cpp/utility/variant\"><span class=\"kw1093\">std::<span class=\"me2\">variant</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span>, <span class=\"kw4\">float</span><span class=\"sy1\">&gt;</span><span class=\"sy3\">&amp;</span> v<span class=\"br0\">)</span>\n    <span class=\"br0\">{</span>\n        <span class=\"kw1\">if</span> <span class=\"br0\">(</span><span class=\"kw4\">const</span> <span class=\"kw4\">int</span><span class=\"sy2\">*</span> pval <span class=\"sy1\">=</span> std<span class=\"sy4\">::</span><span class=\"me2\">get_if</span><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span><span class=\"sy1\">&gt;</span><span class=\"br0\">(</span><span class=\"sy3\">&amp;</span>v<span class=\"br0\">)</span><span class=\"br0\">)</span>\n            <a href=\"/w/cpp/io/cout\"><span class=\"kw1774\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"variant value: \"</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"sy2\">*</span>pval <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n        <span class=\"kw1\">else</span>\n            <a href=\"/w/cpp/io/cout\"><span class=\"kw1774\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"failed to get value!\"</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/utility/variant\"><span class=\"kw1093\">std::<span class=\"me2\">variant</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span>, <span class=\"kw4\">float</span><span class=\"sy1\">&gt;</span> v<span class=\"br0\">{</span><span class=\"nu0\">12</span><span class=\"br0\">}</span>, w<span class=\"br0\">{</span><span class=\"nu0\">3</span>.<span class=\"me1\">f</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    check_value<span class=\"br0\">(</span>v<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    check_value<span class=\"br0\">(</span>w<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre data-output=\"1\"><code>variant value: 12\nfailed to get value!</code></pre> \n</div>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/utility/variant/get\"> <span class=\"t-lines\"><span>get<span class=\"t-dsc-small\">(std::variant)</span></span></span></a></div><div><span class=\"t-lines\"><span><span class=\"t-mark-rev t-since-cxx17\">(C++17)</span></span></span></div></div>\n</td>\n<td>  reads the value of the variant given the index or the type (if the type is unique), throws on error <br> <span class=\"t-mark\">(function template)</span> </td></tr>\n</table>","headings":[{"depth":3,"text":"Template parameters","id":"Template_parameters"},{"depth":3,"text":"Parameters","id":"Parameters"},{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Example","id":"Example"},{"depth":3,"text":"See also","id":"See_also"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"utility","title":"Utility library"},{"path":"utility/variant","title":"std::variant"}],"children":[],"map":{"label":"std::get_if (std::variant)","children":[{"label":"Declarations","note":"4 declarations. Index-based non-throwing accessor: If pv is not a null pointer and pv->index() == I, returns a pointer to the value…"},{"label":"Template parameters","note":"I, Type"},{"label":"Parameters","note":"pv"},{"label":"Return value","note":"Pointer to the value stored in the pointed-to variant or null pointer on error."},{"label":"Example"},{"label":"See also","children":[{"label":"get(std::variant)","note":"reads the value of the variant given the index or the type (if the type is unique), throws on error"}]}]},"standards":["C++17"],"wordCount":262,"codeBlockCount":2}
