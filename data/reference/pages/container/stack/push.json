"sy4\">;</span>\n                <span class=\"kw1\">case</span> <span class=\"st0\">','</span><span class=\"sy4\">:</span>\n                    <a href=\"/w/cpp/io/cin\"><span class=\"kw1773\">std::<span class=\"me2\">cin</span></span></a> <span class=\"sy1\">&gt;&gt;</span> data_<span class=\"br0\">[</span>pos_<span class=\"br0\">]</span><span class=\"sy4\">;</span>\n                    <span class=\"kw1\">break</span><span class=\"sy4\">;</span>\n                <span class=\"kw1\">case</span> <span class=\"st0\">'['</span><span class=\"sy4\">:</span>\n                    <span class=\"kw1\">if</span> <span class=\"br0\">(</span>data_<span class=\"br0\">[</span>pos_<span class=\"br0\">]</span> <span class=\"sy1\">==</span> <span class=\"nu0\">0</span><span class=\"br0\">)</span>\n                        program_ <span class=\"sy1\">=</span> open_brackets<span class=\"br0\">[</span>program_<span class=\"br0\">]</span><span class=\"sy4\">;</span>\n                    <span class=\"kw1\">break</span><span class=\"sy4\">;</span>\n                <span class=\"kw1\">case</span> <span class=\"st0\">']'</span><span class=\"sy4\">:</span>\n                    <span class=\"kw1\">if</span> <span class=\"br0\">(</span>data_<span class=\"br0\">[</span>pos_<span class=\"br0\">]</span> <span class=\"sy3\">!</span><span class=\"sy1\">=</span> <span class=\"nu0\">0</span><span class=\"br0\">)</span>\n                        program_ <span class=\"sy1\">=</span> close_brackets<span class=\"br0\">[</span>program_<span class=\"br0\">]</span><span class=\"sy4\">;</span>\n                    <span class=\"kw1\">break</span><span class=\"sy4\">;</span>\n            <span class=\"br0\">}</span>\n    <span class=\"br0\">}</span>\n<span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    BrainHackInterpreter\n    <span class=\"br0\">{</span>\n        <sp