ass=\"co2\">#include &lt;iostream&gt;</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <a href=\"/w/cpp/experimental/optional\"><span class=\"kw2319\">std::<span class=\"me2\">experimental</span><span class=\"sy4\">::</span><span class=\"me2\">optional</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span><span class=\"sy1\">&gt;</span> opt <span class=\"sy1\">=</span> <span class=\"br0\">{</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw1\">try</span>\n    <span class=\"br0\">{</span>\n        <span class=\"kw4\">int</span> n <span class=\"sy1\">=</span> opt.<span class=\"me1\">value</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n    <span class=\"kw1\">catch</span> <span class=\"br0\">(</span><span class=\"kw4\">const</span> <a href=\"/w/cpp/error/logic_error\"><span class=\"kw769\">std::<span class=\"me2\">logic_error</span></span></a><span class=\"sy3\">&amp;</span> e<span class=\"br0\">)</span>\n    <span class=\"br0\">{</span>\n        <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> e.<span class=\"me1\">what</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Possible output:\n</p>\n<pre data-output=\"1\"><code>optional&lt;T&gt;::value: not engaged</code></pre> \n</div>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/experimental/optional/value_or\"> <span class=\"t-lines\"><span>value_or</span></span></a></div></div>\n</td>\n<