ing"},{"label":"end","note":"returns an iterator or a sentinel to the end"},{"label":"size","note":"returns the number of elements. Provided only if the underlying (adapted) range satisfies sized_range."},{"label":"empty","note":"returns whether the derived view is empty. Provided if it satisfies sized_range or forward_range."},{"label":"cbegin","note":"returns a constant iterator to the beginning of the range."},{"label":"cend","note":"returns a sentinel for the constant iterator of the range."},{"label":"+4 more"}]},{"label":"Deduction guides"},{"label":"Nested classes","children":[{"label":"iterator","note":"the iterator type"}]},{"label":"Notes"},{"label":"Example"},{"label":"See also","children":[{"label":"ranges::zip_view, views::zip","note":"a view consisting of tuples of references to corresponding elements of the adapted views"}]}]},"standards":["C++23"],"wordCount":988,"codeBlockCount":2}
