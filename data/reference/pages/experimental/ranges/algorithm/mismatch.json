2<span class=\"br0\">{</span><span class=\"br0\">}</span> <span class=\"br0\">)</span><br>&nbsp; &nbsp; <span class=\"sy2\">-</span><span class=\"sy1\">&gt;</span> <a href=\"/w/cpp/experimental/ranges/utility/tagged_pair\"><span class=\"kw2853\">ranges::<span class=\"me2\">tagged_pair</span></span></a><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/experimental/ranges/algorithm/tags\"><span class=\"kw2826\">tag::<span class=\"me2\">in1</span></span></a><span class=\"br0\">(</span>I1<span class=\"br0\">)</span>, <a href=\"/w/cpp/experimental/ranges/algorithm/tags\"><span class=\"kw2827\">tag::<span class=\"me2\">in2</span></span></a><span class=\"br0\">(</span><a href=\"/w/cpp/types/decay\"><span class=\"kw634\">std::<span class=\"me2\">decay_t</span></span></a><span class=\"sy1\">&lt;</span>I2<span class=\"sy1\">&gt;</span><span class=\"br0\">)</span><span class=\"sy1\">&gt;</span><span class=\"sy4\">;</span></span></div></td>\n<td> (3) </td>\n<td> <span class=\"t-mark-rev t-since-ranges-ts t-mark-ts\">(ranges TS)</span> <br><span class=\"t-mark\">(deprecated)</span> </td>\n</tr>\n<tr class=\"t-dcl t-since-ranges\" id=\"Version_4\">\n<td> <div><span class=\"mw-geshi cpp source-cpp\"><span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span> InputRange R1, <span class=\"kw1\">class</span> I2, <span class=\"kw1\">class</span> Pred <span class=\"sy1\">=</span> <a href=\"/w/cpp/experimental/ranges/functional/equal_to\"><span class=\"kw2859\">ranges::<span class=\"me2\">equal_to</span></span></a><span class=\"sy1\">&lt;&gt;</span>,<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; <span class=\"kw1\">class</span> Proj1 <span class=\"sy1\">=</span> <a href=\"/w/cpp/experimental/ranges/functional/identity\"><span class=\"kw2857\">ranges::<span class=\"me2\">identity</span></span></a>, <span class=\"kw1\">class</span> Proj2 <span class=\"sy1\">=</span> <a href=\"/w/cpp/experimental/ranges/functional/identity\"><span class=\"kw2857\">ranges::<span class=\"me2\">identity</span></