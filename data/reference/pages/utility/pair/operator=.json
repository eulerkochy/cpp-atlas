iv>\n<div class=\"t-li1\"><span class=\"t-li\">6-10)</span> May throw implementation-defined exceptions.</div>\n<h3 id=\"Example\">Example</h3>\n<div class=\"t-example\">\n<pre data-lang=\"cpp\"><code><span class=\"co2\">#include &lt;cstddef&gt;</span>\n<span class=\"co2\">#include &lt;iomanip&gt;</span>\n<span class=\"co2\">#include &lt;iostream&gt;</span>\n<span class=\"co2\">#include &lt;utility&gt;</span>\n<span class=\"co2\">#include &lt;vector&gt;</span>\n&nbsp;\n<span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span><span class=\"kw1\">class</span> Os, <span class=\"kw1\">class</span> T<span class=\"sy1\">&gt;</span>\nOs<span class=\"sy3\">&amp;</span> operator<span class=\"sy1\">&lt;&lt;</span><span class=\"br0\">(</span>Os<span class=\"sy3\">&amp;</span> os, <span class=\"kw4\">const</span> <a href=\"/w/cpp/container/vector\"><span class=\"kw1277\">std::<span class=\"me2\">vector</span></span></a><span class=\"sy1\">&lt;</span>T<span class=\"sy1\">&gt;</span><span class=\"sy3\">&amp;</span> v<span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    os <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'{'</span><span class=\"sy4\">;</span>\n    <span class=\"kw1\">for</span> <span class=\"br0\">(</span><a href=\"/w/cpp/types/size_t\"><span class=\"kw107\">std::<span class=\"me2\">size_t</span></span></a> t <span class=\"sy1\">=</span> <span class=\"nu0\">0</span><span class=\"sy4\">;</span> t <span class=\"sy3\">!</span><span class=\"sy1\">=</span> v.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span> <span class=\"sy2\">++</span>t<span class=\"br0\">)</span>\n        os <span class=\"sy1\">&lt;&lt;</span> v<span class=\"br0\">[</span>t<span class=\"br0\">]</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span>t <span class=\"sy2\">+</span> <span class=\"nu0\">1</span> <span class=\"sy1\">&lt;</span> v.<span class=\"me1\">size</span><span class=\"br0\">(</