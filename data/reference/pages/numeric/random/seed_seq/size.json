y4\">;</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> s1.<span class=\"me1\">size</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre data-output=\"1\"><code>3</code></pre> \n</div>\n<h3 id=\"Defect_report\">Defect report</h3>\n<p>The following behavior-changing defect reports were applied retroactively to previously published C++ standards.\n</p>\n<table class=\"dsctable\">\n<tr>\n<th>DR\n</th>\n<th>Applied to\n</th>\n<th>Behavior as published\n</th>\n<th>Correct behavior\n</th></tr>\n<tr>\n<td><a class=\"external text\" href=\"https://cplusplus.github.io/LWG/issue2440\" data-external=\"1\">LWG 2440</a>\n</td>\n<td>C++11\n</td>\n<td><code>seed_seq::size</code> was not noexcept\n</td>\n<td>made noexcept\n</td></tr></table>","headings":[{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Complexity","id":"Complexity"},{"depth":3,"text":"Example","id":"Example"},{"depth":3,"text":"Defect report","id":"Defect_report"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"numeric","title":"Numerics library"},{"path":"numeric/random","title":"Pseudo-random number generation"},{"path":"numeric/random/seed_seq","title":"std::seed_seq"}],"children":[],"map":{"label":"std::seed_seq::size","children":[{"label":"Declarations","note":"1 declaration; revisions: since C++11. Returns the size of the underlying seed sequence."},{"label":"Return value","note":"v .size()"},{"label":"Complexity","note":"Constant time."},{"label":"Example"},{"label":"Defect report","note":"The following behavior-changing defect reports were applied retroactively to previously published C++ standards."}]},"standards":["C++11"],"wordCount":75,"codeBlockCount":2}
