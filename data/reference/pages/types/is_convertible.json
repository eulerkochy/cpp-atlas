an></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">void</span><span class=\"br0\">(</span><span class=\"sy3\">&amp;</span><span class=\"br0\">)</span><span class=\"br0\">(</span>To<span class=\"br0\">)</span><span class=\"sy1\">&gt;</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">(</span><a href=\"/w/cpp/utility/declval\"><span class=\"kw1126\">std::<span class=\"me2\">declval</span></span></a><span class=\"sy1\">&lt;</span>From<span class=\"sy1\">&gt;</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"br0\">)</span>, <a href=\"/w/cpp/types/integral_constant\"><span class=\"kw652\">std::<span class=\"me2\">true_type</span></span></a><span class=\"br0\">{</span><span class=\"br0\">}</span>\n    <span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span><span class=\"kw1\">class</span>, <span class=\"kw1\">class</span><span class=\"sy1\">&gt;</span>\n    <span class=\"kw4\">auto</span> test_implicitly_convertible<span class=\"br0\">(</span>...<span class=\"br0\">)</span> <span class=\"sy2\">-</span><span class=\"sy1\">&gt;</span> <a href=\"/w/cpp/types/integral_constant\"><span class=\"kw653\">std::<span class=\"me2\">false_type</span></span></a><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span> <span class=\"co1\">// namespace detail</span>\n&nbsp;\n<span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span><span class=\"kw1\">class</span> From, <span class=\"kw1\">class</span> To<span class=\"sy1\">&gt;</span>\n<span class=\"kw1\">struct</span> is_convertible <span class=\"sy4\">:</span> <a href=\"/w/cpp/types/integral_constant\"><span class=\"kw650\">std::<span class=\"me2\">integral_constant</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">bool</span>,\n    <span class=\"br0\">(</span>decltype<span class=\"br0\">(</span>detail<span class=\"sy4\">::</span><span cla