n class=\"me2\">complex</span></span></a><span class=\"sy1\">&lt;</span>T<span class=\"sy1\">&gt;</span><span class=\"sy3\">&amp;</span> lhs,<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<span class=\"kw4\">const</span> T<span class=\"sy3\">&amp;</span> rhs <span class=\"br0\">)</span><span class=\"sy4\">;</span></span></div></td>\n<td class=\"t-dcl-nopad\">  </td>\n<td> <span class=\"t-mark-rev t-since-cxx20\">(since C++20)</span> </td>\n</tr>\n</tbody><tbody>\n</tbody>\n<tbody class=\"t-dcl-rev t-dcl-rev-num\"><tr class=\"t-dcl-rev-aux\" id=\"Version_9\">\n<td></td>\n<td rowspan=\"142\">(9)</td>\n<td></td>\n</tr>\n<tr class=\"t-dcl t-until-cxx20\">\n<td><div><span class=\"mw-geshi cpp source-cpp\"><span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span> <span class=\"kw1\">class</span> T <span class=\"sy1\">&gt;</span><br><a href=\"/w/cpp/numeric/complex\"><span class=\"kw1480\">std::<span class=\"me2\">complex</span></span></a><span class=\"sy1\">&lt;</span>T<span class=\"sy1\">&gt;</span> operator<span class=\"sy2\">*</span><span class=\"br0\">(</span> <span class=\"kw4\">const</span> T<span class=\"sy3\">&amp;</span> lhs,<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<span class=\"kw4\">const</span> <a href=\"/w/cpp/numeric/complex\"><span class=\"kw1480\">std::<span class=\"me2\">complex</span></span></a><span class=\"sy1\">&lt;</span>T<span class=\"sy1\">&gt;</span><span class=\"sy3\">&amp;</span> rhs <span class=\"br0\">)</span><span class=\"sy4\">;</span></span></div></td>\n<td class=\"t-dcl-nopad\"> </td>\n<td><span class=\"t-mark-rev t-until-cxx20\">(until C++20)</span></td>\n</tr>\n<tr class=\"t-dcl t-since-cxx20\">\n<td> <div><span class=\"mw-geshi cpp source-cpp\"><span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span> <span class=\"kw1\">class</span> T <span class=\"sy1\">&gt;</span><br><s