=\"sy1\">&lt;</span>reflect<span class=\"sy4\">::</span><span class=\"me2\">Object</span> M1<span class=\"sy1\">&gt;</span>\n    <span class=\"kw1\">friend</span> <span class=\"kw4\">constexpr</span> <span class=\"kw4\">bool</span> operator<span class=\"sy1\">==</span><span class=\"br0\">(</span>meta_t, meta_t<span class=\"sy1\">&lt;</span>M1<span class=\"sy1\">&gt;</span><span class=\"br0\">)</span> <span class=\"kw1\">noexcept</span>\n    <span class=\"br0\">{</span>\n        <span class=\"kw1\">return</span> reflect<span class=\"sy4\">::</span><span class=\"me2\">reflects_same_v</span><span class=\"sy1\">&lt;</span>M, M1<span class=\"sy1\">&gt;</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n    <span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span>reflect<span class=\"sy4\">::</span><span class=\"me2\">Object</span> M1<span class=\"sy1\">&gt;</span>\n    <span class=\"kw1\">friend</span> <span class=\"kw4\">constexpr</span> <span class=\"kw4\">bool</span> operator<span class=\"sy3\">!</span><span class=\"sy1\">=</span><span class=\"br0\">(</span>meta_t, meta_t<span class=\"sy1\">&lt;</span>M1<span class=\"sy1\">&gt;</span><span class=\"br0\">)</span> <span class=\"kw1\">noexcept</span>\n    <span class=\"br0\">{</span>\n        <span class=\"kw1\">return</span> <span class=\"sy3\">!</span>reflect<span class=\"sy4\">::</span><span class=\"me2\">reflects_same_v</span><span class=\"sy1\">&lt;</span>M, M1<span class=\"sy1\">&gt;</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n<span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n<span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span>reflect<span class=\"sy4\">::</span><span class=\"me2\">Object</span> M<span class=\"sy1\">&gt;</span>\n<span class=\"kw4\">constexpr</span> meta_t<span class=\"sy1\">&lt;</span>M<span class=\"sy1\">&gt;</span> meta<span class=\"br0\">{</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    static_assert<span class=\"br0\">(</span>meta<span class=\"sy1\">&lt;</span>reflexpr<span class=\"br0\">(</span><span class=\"kw4\">int</span><span class=\"br0\">)</span><span class=\"sy1\">&gt;</span> <span class=\"sy1\">==</span> meta<span class=\"sy1\">&lt;</span>reflexpr<span class=\"br0\">(</span><span class=\"kw4\">signed</span> <span class=\"kw4\">int</span><span class=\"br0\">)</span><span class=\"sy1\">&gt;</span>, <span class=\"st0\">\"\"</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"co1\">// meta&lt;int&gt;; // error: int is not a meta-object type</span>\n<span class=\"br0\">}</span></code></pre>\n</div>","headings":[{"depth":3,"text":"Example","id":"Example"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"experimental","title":"Experimental C++ Features"},{"path":"experimental/reflect","title":"Extensions for reflection"}],"children":[],"map":{"label":"std::experimental::reflect::Object","children":[{"label":"Declarations","note":"1 declaration. The Object concept is satisfied if and only if T is a meta-object type."},{"label":"Example"}]},"standards":[],"wordCount":93,"codeBlockCount":1}
