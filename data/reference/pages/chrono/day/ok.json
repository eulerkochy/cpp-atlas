an></span></code>.\n</p>\n<h3 id=\"Example\">Example</h3>\n<div class=\"t-example\">\n<pre data-lang=\"cpp\"><code><span class=\"co2\">#include &lt;chrono&gt;</span>\n<span class=\"kw1\">using</span> <span class=\"kw1\">namespace</span> std<span class=\"sy4\">::</span><span class=\"me2\">chrono_literals</span><span class=\"sy4\">;</span>\n&nbsp;\n<span class=\"kw4\">constexpr</span> <a href=\"/w/cpp/chrono/day\"><span class=\"kw2620\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">day</span></span></a> d0<span class=\"br0\">{</span><span class=\"nu8\">00</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n<span class=\"kw4\">constexpr</span> <a href=\"/w/cpp/chrono/day\"><span class=\"kw2620\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">day</span></span></a> d1<span class=\"br0\">{</span><span class=\"nu0\">13</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n<span class=\"kw4\">constexpr</span> <a href=\"/w/cpp/chrono/day\"><span class=\"kw2620\">std::<span class=\"me2\">chrono</span><span class=\"sy4\">::</span><span class=\"me2\">day</span></span></a> d2<span class=\"br0\">{</span><span class=\"nu0\">42</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\nstatic_assert\n<span class=\"br0\">(</span>\n    d0 <span class=\"sy1\">==</span> 0d <span class=\"sy3\">&amp;&amp;</span> <span class=\"sy3\">!</span>d0.<span class=\"me1\">ok</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy3\">&amp;&amp;</span>\n    d1 <span class=\"sy1\">==</span> 13d <span class=\"sy3\">&amp;&amp;</span> d1.<span class=\"me1\">ok</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy3\">&amp;&amp;</span>\n    d2 <span class=\"sy1\">==</span> 42d <span class=\"sy3\">&amp;&amp;</span> <span class=\"sy3\">!</span>d2.<span class=\"me1\">ok</span><span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=