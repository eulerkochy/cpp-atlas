 class=\"kw2\">true</span></span>.</div>\n<div class=\"t-li1\"><span class=\"t-li\">2)</span> Returns <span class=\"mw-geshi cpp source-cpp\"><span class=\"kw2\">true</span></span> if at least one value in <code class=\"t-c\"><span class=\"mw-geshi cpp source-cpp\">k</span></code> is <span class=\"mw-geshi cpp source-cpp\"><span class=\"kw2\">true</span></span>.</div>\n<div class=\"t-li1\"><span class=\"t-li\">3)</span> Returns <span class=\"mw-geshi cpp source-cpp\"><span class=\"kw2\">true</span></span> if all values in <code class=\"t-c\"><span class=\"mw-geshi cpp source-cpp\">k</span></code> are <span class=\"mw-geshi cpp source-cpp\"><span class=\"kw2\">false</span></span>.</div>\n<div class=\"t-li1\"><span class=\"t-li\">4)</span> Returns <span class=\"mw-geshi cpp source-cpp\"><span class=\"kw2\">true</span></span> if at least one value in <code class=\"t-c\"><span class=\"mw-geshi cpp source-cpp\">k</span></code> is <span class=\"mw-geshi cpp source-cpp\"><span class=\"kw2\">true</span></span> but not all values in <code class=\"t-c\"><span class=\"mw-geshi cpp source-cpp\">k</span></code> are <span class=\"mw-geshi cpp source-cpp\"><span class=\"kw2\">true</span></span>.</div>\n<h3 id=\"Parameters\">Parameters</h3>\n<table class=\"t-par-begin\">\n<tr class=\"t-par\">\n<td> k\n</td>\n<td> -\n</td>\n<td> the <a href=\"/w/cpp/experimental/simd/simd_mask\"><code>simd_mask</code></a> to apply the reduction to\n</td></tr></table>\n<h3 id=\"Return_value\">Return value</h3>\n<p>The boolean result of the horizontal reduction.\n</p>\n<h3 id=\"Example\">Example</h3>\n<div class=\"t-example\">\n<pre data-lang=\"cpp\"><code><span class=\"co2\">#include &lt;cassert&gt;</span>\n<span class=\"co2\">#include &lt;experimental/simd&gt;</span>\n&nbsp;\n<span class=\"kw1\">namespace</span> stq <span class=\"sy1\">=</span> std<span class=\"sy4\">::</span><span class=\"me2\">experimental</span><span class=\"sy4\">;</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <span class=\"kw1\">using</span> mask <span class=\"sy1\">=</span> stq<span class=\"sy4\">::</span><span class=\"me2\">fixed_size_simd_mask</span><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span>, <span class=\"nu0\">4</span><span class=\"sy1\">&gt;</span><span class=\"sy4\">;</span>\n&nbsp;\n    mask mask1<span class=\"br0\">{</span><span class=\"kw2\">false</span><span class=\"br0\">}</span><span class=\"sy4\">;</span> <span class=\"co1\">// = {0, 0, 0, 0}</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a>\n    <span class=\"br0\">(</span>\n        stq<span class=\"sy4\">::</span><span class=\"me2\">none_of</span><span class=\"br0\">(</span>mask1<span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"kw2\">true</span> <span class=\"sy3\">&amp;&amp;</span>\n        stq<span class=\"sy4\">::</span><span class=\"me2\">any_of</span><span class=\"br0\">(</span>mask1<span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"kw2\">false</span> <span class=\"sy3\">&amp;&amp;</span>\n        stq<span class=\"sy4\">::</span><span class=\"me2\">some_of</span><span class=\"br0\">(</span>mask1<span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"kw2\">false</span> <span class=\"sy3\">&amp;&amp;</span>\n        stq<span class=\"sy4\">::</span><span class=\"me2\">all_of</span><span class=\"br0\">(</span>mask1<span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"kw2\">false</span>\n    <span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    mask mask2<span class=\"br0\">{</span><span class=\"kw2\">true</span><span class=\"br0\">}</span><span class=\"sy4\">;</span> <span class=\"co1\">// = {1, 1, 1, 1}</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a>\n    <span class=\"br0\">(</span>\n        stq<span class=\"sy4\">::</span><span class=\"me2\"