d::<span class=\"me2\">counted_iterator</span></span></a><span class=\"br0\">(</span>first, count<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n        <span class=\"kw1\">return</span> <a href=\"/w/cpp/memory/ranges/uninitialized_value_construct\"><span class=\"kw3103\">ranges::<span class=\"me2\">uninitialized_value_construct</span></span></a><span class=\"br0\">(</span>iter, <a href=\"/w/cpp/iterator/default_sentinel_t\"><span class=\"kw2897\">std::<span class=\"me2\">default_sentinel</span></span></a><span class=\"br0\">)</span>.<span class=\"me1\">base</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n<span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n<span class=\"kw1\">inline</span> <span class=\"kw4\">constexpr</span> uninitialized_value_construct_n_fn uninitialized_value_construct_n<span class=\"br0\">{</span><span class=\"br0\">}</span><span class=\"sy4\">;</span></code></pre>\n</td></tr></table>\n<h3 id=\"Example\">Example</h3>\n<div class=\"t-example\">\n<pre data-lang=\"cpp\"><code><span class=\"co2\">#include &lt;iostream&gt;</span>\n<span class=\"co2\">#include &lt;memory&gt;</span>\n<span class=\"co2\">#include &lt;string&gt;</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <span class=\"kw1\">struct</span> S <span class=\"br0\">{</span> <a href=\"/w/cpp/string/basic_string\"><span class=\"kw1238\">std::<span class=\"me2\">string</span></span></a> m<span class=\"br0\">{</span><span class=\"st0\">\"█▓▒░ █▓▒░ █▓▒░ \"</span><span class=\"br0\">}</span><span class=\"sy4\">;</span> <span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw4\">constexpr</span> <span class=\"kw4\">int</span> n<span class=\"br0\">{</span><span class=\"nu0\">4</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    alignas<span class=\"br0\">(<