<span class=\"me2\">osyncstream</span></span></a><span class=\"br0\">{</span><a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n        <span class=\"kw4\">auto</span> scout4 <span class=\"sy1\">=</span> <a href=\"/w/cpp/io/basic_osyncstream\"><span class=\"kw2667\">std::<span class=\"me2\">osyncstream</span></span></a><span class=\"br0\">{</span><a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n        <span class=\"kw4\">auto</span> w1 <span class=\"sy1\">=</span> <a href=\"/w/cpp/thread/jthread\"><span class=\"kw3258\">std::<span class=\"me2\">jthread</span></span></a><span class=\"br0\">{</span>worker, <span class=\"nu0\">0</span>, <a href=\"/w/cpp/utility/functional/ref\"><span class=\"kw1076\">std::<span class=\"me2\">ref</span></span></a><span class=\"br0\">(</span>scout1<span class=\"br0\">)</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n        <span class=\"kw4\">auto</span> w2 <span class=\"sy1\">=</span> <a href=\"/w/cpp/thread/jthread\"><span class=\"kw3258\">std::<span class=\"me2\">jthread</span></span></a><span class=\"br0\">{</span>worker, <span class=\"nu0\">1</span>, <a href=\"/w/cpp/utility/functional/ref\"><span class=\"kw1076\">std::<span class=\"me2\">ref</span></span></a><span class=\"br0\">(</span>scout2<span class=\"br0\">)</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n        <span class=\"kw4\">auto</span> w3 <span class=\"sy1\">=</span> <a href=\"/w/cpp/thread/jthread\"><span class=\"kw3258\">std::<span class=\"me2\">jthread</span></span></a><span class=\"br0\">{</span>worker, <span class=\"nu0\">2</span>, <a href=\"/w/cpp/utility/functional/ref\"><span class=\"kw1076\">std::<span class=\"me2\">ref</span></span></a><span class=\"br0\">(</span>scout3<span class=\"br0\">)</span><span class=\"br0\">}<