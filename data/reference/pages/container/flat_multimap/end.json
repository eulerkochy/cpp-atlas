lass=\"br0\">)</span><span class=\"sy4\">;</span> <span class=\"sy2\">++</span>it<span class=\"br0\">)</span>\n        <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'['</span> <span class=\"sy1\">&lt;&lt;</span> it<span class=\"sy2\">-</span><span class=\"sy1\">&gt;</span>first <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"] = \"</span> <span class=\"sy1\">&lt;&lt;</span> it<span class=\"sy2\">-</span><span class=\"sy1\">&gt;</span>second <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"co1\">// Unlike std::multimap's bidirectional iterators, the std::flat_multimap</span>\n    <span class=\"co1\">// iterators are random-access, so they can be used with the operator[]:</span>\n    <span class=\"kw4\">auto</span> it <span class=\"sy1\">=</span> map.<span class=\"me1\">cbegin</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>it<span class=\"br0\">[</span><span class=\"nu0\">1</span><span class=\"br0\">]</span> <span class=\"sy1\">==</span> <span class=\"nu0\">19</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>it<span class=\"br0\">[</span><span class=\"nu0\">4</span><span class=\"br0\">]</span> <span class=\"sy1\">==</span> <span class=\"nu0\">13</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>it<span class=\"br0\">[</span><span class=\"nu0\">4</span><span class=\"br0\">]</span> <span class=\"sy1\">==</span> <span class=\"nu0\">42</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>it<span class=\"br0\">[</span><span class=\"nu0\">9</span><span class=\"br0\">]</span> <span class=\"sy1\">==</span> <span class=\"nu0\">94</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre data-output=\"1\"><code>[1] = 19\n[4] = 13\n[4] = 42\n[9] = 94</code></pre> \n</div>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/container/flat_multimap/begin\"> <span class=\"t-lines\"><span>begin</span><span>cbegin</span></span></a></div></div>\n</td>\n<td>  returns an iterator to the beginning <br> <span class=\"t-mark\">(public member function)</span> </td></tr>\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/iterator/end\"> <span class=\"t-lines\"><span>end</span><span>cend</span></span></a></div><div><span class=\"t-lines\"><span><span class=\"t-mark-rev t-since-cxx11\">(C++11)</span></span><span><span class=\"t-mark-rev t-since-cxx14\">(C++14)</span></span></span></div></div>\n</td>\n<td>  returns an iterator to the end of a container or array <br> <span class=\"t-mark\">(function template)</span> </td></tr>\n</table>","headings":[{"depth":3,"text":"Parameters","id":"Parameters"},{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Complexity","id":"Complexity"},{"depth":3,"text":"Example","id":"Example"},{"depth":3,"text":"See also","id":"See_also"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"container","title":"Containers library"},{"path":"container/flat_multimap","title":"std::flat_multimap"}],"children":[],"map":{"label":"std::flat_multimap<Key,T,Compare,KeyContainer,MappedContainer>::end, std::flat_multimap<Key,T,Compare,KeyContainer,MappedContainer>::cend","children":[{"label":"Declarations","n