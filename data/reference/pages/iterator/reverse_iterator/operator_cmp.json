span class=\"sy1\">&lt;=&gt;</span> lhs.<span class=\"me1\">base</span><span class=\"br0\">(</span><span class=\"br0\">)</span></span></code> rather than <code class=\"t-c\"><span class=\"mw-geshi cpp source-cpp\">lhs.<span class=\"me1\">base</span><span class=\"br0\">(</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;=&gt;</span> rhs.<span class=\"me1\">base</span><span class=\"br0\">(</span><span class=\"br0\">)</span></span></code> because this is a reverse iterator.\n</p>\n<h3 id=\"Example\">Example</h3>\n<div class=\"t-example\">\n<pre data-lang=\"cpp\"><code><span class=\"co2\">#include &lt;cassert&gt;</span>\n<span class=\"co2\">#include &lt;iterator&gt;</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <span class=\"kw4\">int</span> a<span class=\"br0\">[</span><span class=\"br0\">]</span><span class=\"br0\">{</span><span class=\"nu0\">0</span>, <span class=\"nu0\">1</span>, <span class=\"nu0\">2</span>, <span class=\"nu0\">3</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <span class=\"co1\">//            ↑  └───── x, y</span>\n    <span class=\"co1\">//            └──────── z</span>\n    <span class=\"co1\">// “x” and “y” are equal, but “x” is less than “z” (reversely)</span>\n    <a href=\"/w/cpp/iterator/reverse_iterator\"><span class=\"kw663\">std::<span class=\"me2\">reverse_iterator</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span><span class=\"sy2\">*</span><span class=\"sy1\">&gt;</span>\n        x<span class=\"br0\">{</span><a href=\"/w/cpp/iterator/rend\"><span class=\"kw687\">std::<span class=\"me2\">rend</span></span></a><span class=\"br0\">(</span>a<span class=\"br0\">)</span> <span class=\"sy2\">-</span> <a href=\"/w/cpp/iterator/size\"><span class=\"kw689\">std::<span class=\"me2\">size</span></span></a><span class=\"br0\">(</span>a<span class=\"br0\">)</span><span class=\"br0\">}</span>,\n        y<span class=\"br0\">{</span><a href=\"/w/cpp/iterator/rend\"><span class=\"kw687\">std::<span class=\"me2\">rend</span></span></a><span class=\"br0\">(</span>a<span class=\"br0\">)</span> <span class=\"sy2\">-</span> <a href=\"/w/cpp/iterator/size\"><span class=\"kw689\">std::<span class=\"me2\">size</span></span></a><span class=\"br0\">(</span>a<span class=\"br0\">)</span><span class=\"br0\">}</span>,\n        z<span class=\"br0\">{</span><a href=\"/w/cpp/iterator/rbegin\"><span class=\"kw683\">std::<span class=\"me2\">rbegin</span></span></a><span class=\"br0\">(</span>a<span class=\"br0\">)</span> <span class=\"sy2\">+</span> <span class=\"nu0\">1</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"co1\">// two-way comparisons</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>  x <span class=\"sy1\">==</span> y <span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span><span class=\"sy3\">!</span><span class=\"br0\">(</span>x <span class=\"sy3\">!</span><span class=\"sy1\">=</span> y<span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span><span class=\"sy3\">!</span><span class=\"br0\">(</span>x <span class=\"sy1\">&lt;</span>  y<span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>  x <span class=\"sy1\">&lt;=</span> y <span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span><span class=\"sy3\">!</span><span class=\"br0\">(</span>x <span class=\"sy1\">==</span> z<span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>  x <span class=\"sy3\">!</span><span class=\"sy1\">=</span> z <span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>  x <span class=\"sy1\">&lt;</span>  z <span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>  x <span class=\"sy1\">&lt;=</span> z <span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"co1\">// three-way comparisons</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>  x <span class=\"sy1\">&lt;=&gt;</span> y <span class=\"sy1\">==</span> <span class=\"nu0\">0</span> <span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span><span class=\"sy3\">!</span><span class=\"br0\">(</span>x <span class=\"sy1\">&lt;=&gt;</span> y <span class=\"sy1\">&lt;</span>  <span class=\"nu0\">0</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span><span class=\"sy3\">!</span><span class=\"br0\">(</span>x <span class=\"sy1\">&lt;=&gt;</span> y <span class=\"sy1\">&gt;</span>  <span class=\"nu0\">0</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span><span class=\"sy3\">!</span><span class=\"br0\">(</span>x <span class=\"sy1\">&lt;=&gt;</span> z <span class=\"sy1\">==</span> <span class=\"nu0\">0</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>  x <span class=\"sy1\">&lt;=&gt;</span> z <span class=\"sy1\">&lt;</span>  <span class=\"nu0\">0</span> <span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span><span class=\"sy3\">!</span><span class=\"br0\">(</span>x <span class=\"sy1\">&lt;=&gt;</span> z <span class=\"sy1\">&gt;</span>  <span class=\"nu0\">0</span><span class=\"br0\">)</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n</div>\n<h3 id=\"Defect_reports\">Defect reports</h3>\n<p>The following behavior-changing defect reports were applied retroactively to previously published C++ standards.\n</p>\n<table class=\"dsctable\">\n<tr>\n<th>DR\n</th>\n<th>Applied to\n</th>\n<th>Behavior as published\n</th>\n<th>Correct behavior\n</th></tr>\n<tr>\n<td><a class=\"external text\" href=\"https://cplusplus.github.io/LWG/issue280\" data-external=\"1\">LWG 280</a>\n</td>\n<td>C++98\n</td>\n<td>heterogeneous assignment was not allowed\n</td>\n<td>allowed\n</td></tr></table>","headings":[{"depth":3,"text":"Parameters","id":"Parameters"},{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Notes","id":"Notes"},{"depth":3,"text":"Example","id":"Example"},{"depth":3,"text":"Defect reports","id":"Defect_reports"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"iterator","title":"Iterator library"},{"path":"iterator/reverse_iterator","title":"std::reverse_iterator"}],"children":[],"map":{"label":"operator==,!=,<,<=,>,>=,<=>(std::reverse_iterator)","children":[{"label":"Declarations","note":"7 declarations; revisions: since C++20. Compares the underlying iterators of lhs and rhs."},{"label":"Parameters","note":"lhs, rhs"},{"label":"Return value","note":"lhs.base() == rhs.base()"},{"label":"Notes","note":"operator<=> returns rhs.base() <=> lhs.base() rather than lhs.base() <=> rhs.base() because this is a reverse iterator."},{"label":"Example"}]},"standards":["C++17","C++20"],"wordCount":489,"codeBlockCount":1}
