dians)."},{"label":"Parameters","note":"num"},{"label":"Return value","note":"If no errors occur, the cosine of num (cos(num)) in the range [-1.0, +1.0], is returned."},{"label":"Error handling","note":"Errors are reported as specified in math_errhandling."},{"label":"Notes","note":"The case where the argument is infinite is not specified to be a domain error in C, but it is defined as a domain error in POSIX."},{"label":"Example"},{"label":"See also","children":[{"label":"sin, sinf, sinl","note":"computes sine (sin(x))"},{"label":"tan, tanf, tanl","note":"computes tangent (tan(x))"},{"label":"acos, acosf, acosl","note":"computes arc cosine (arccos(x))"},{"label":"cos(std::complex)","note":"computes cosine of a complex number (cos(z))"},{"label":"cos(std::valarray)","note":"applies the function std::cos to each element of valarray"}]}]},"standards":["C++11","C++23","C++26"],"wordCount":618,"codeBlockCount":2}
