t</span>\n    <span class=\"br0\">{</span>\n        <span class=\"kw1\">return</span> <span class=\"br0\">(</span>lhs <span class=\"sy2\">%</span> <span class=\"nu0\">97</span><span class=\"br0\">)</span> <span class=\"sy1\">&lt;</span> <span class=\"br0\">(</span>rhs <span class=\"sy2\">%</span> <span class=\"nu0\">97</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n<span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <a href=\"/w/cpp/container/set\"><span class=\"kw1285\">std::<span class=\"me2\">set</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span>, ModCmp<span class=\"sy1\">&gt;</span> cont<span class=\"br0\">{</span><span class=\"nu0\">1</span>, <span class=\"nu0\">2</span>, <span class=\"nu0\">3</span>, <span class=\"nu0\">4</span>, <span class=\"nu0\">5</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"co1\">// Same behaviour as key_comp()</span>\n    <span class=\"kw4\">auto</span> comp_func <span class=\"sy1\">=</span> cont.<span class=\"me1\">value_comp</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n    <span class=\"kw1\">for</span> <span class=\"br0\">(</span><span class=\"kw4\">const</span> <span class=\"kw4\">int</span> val<span class=\"br0\">{</span><span class=\"nu0\">100</span><span class=\"br0\">}</span><span class=\"sy4\">;</span> <span class=\"kw4\">const</span> <span class=\"kw4\">int</span> key <span class=\"sy4\">:</span> cont<span class=\"br0\">)</span>\n    <span class=\"br0\">{</span>\n        <span class=\"kw4\">const</span> <span class=\"kw4\">bool</span> before <span class=\"sy1\">=</span> comp_func<span class=\"br0\">(</span>key, val<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n        <span class=\"kw4\">const</span> <span class=\"kw4\">bool</span> after <span class=\"sy1\">=</span> comp_func<span class=\"br0\">(</span>val, key<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n&nbsp;\n        <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"Key (\"</span> <span class=\"sy1\">&lt;&lt;</span> key <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\") \"</span><span class=\"sy4\">;</span>\n        <span class=\"kw1\">if</span> <span class=\"br0\">(</span><span class=\"sy3\">!</span>before <span class=\"sy3\">&amp;&amp;</span> <span class=\"sy3\">!</span>after<span class=\"br0\">)</span>\n            <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"equivalent to key (\"</span> <span class=\"sy1\">&lt;&lt;</span> val <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\")<span class=\"es1\">\\n</span>\"</span><span class=\"sy4\">;</span>\n        <span class=\"kw1\">else</span> <span class=\"kw1\">if</span> <span class=\"br0\">(</span>before<span class=\"br0\">)</span>\n            <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"goes before key (\"</span> <span class=\"sy1\">&lt;&lt;</span> val <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\")<span class=\"es1\">\\n</span>\"</span><span class=\"sy4\">;</span>\n        <span class=\"kw1\">else</span> <span class=\"kw1\">if</span> <span class=\"br0\">(</span>after<span class=\"br0\">)</span>\n            <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"goes after key (\"</span> <span class=\"sy1\">&lt;&lt;</span> val <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\")<span class=\"e