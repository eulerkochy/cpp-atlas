.\n</p>\n<h3 id=\"Example\">Example</h3>\n<div class=\"t-example\">\n<pre data-lang=\"cpp\"><code><span class=\"co2\">#include &lt;map&gt;</span>\n<span class=\"co2\">#include &lt;print&gt;</span>\n<span class=\"co2\">#include &lt;ranges&gt;</span>\n&nbsp;\n<span class=\"kw4\">void</span> make_uppercase<span class=\"br0\">(</span><span class=\"kw4\">char</span><span class=\"sy3\">&amp;</span> v<span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    v <span class=\"sy2\">+</span><span class=\"sy1\">=</span> <span class=\"st0\">'A'</span> <span class=\"sy2\">-</span> <span class=\"st0\">'a'</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span>\n&nbsp;\n<span class=\"kw4\">void</span> uppercase_transform<span class=\"br0\">(</span><a href=\"/w/cpp/container/multimap\"><span class=\"kw1293\">std::<span class=\"me2\">multimap</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">int</span>, <span class=\"kw4\">char</span><span class=\"sy1\">&gt;</span><span class=\"sy3\">&amp;</span> m, <span class=\"kw4\">int</span> k<span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <span class=\"kw4\">auto</span> <span class=\"br0\">[</span>first, last<span class=\"br0\">]</span> <span class=\"sy1\">=</span> m.<span class=\"me1\">equal_range</span><span class=\"br0\">(</span>k<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"kw1\">for</span> <span class=\"br0\">(</span><span class=\"kw4\">auto</span><span class=\"sy3\">&amp;</span> <span class=\"br0\">[</span>_, v<span class=\"br0\">]</span> <span class=\"sy4\">:</span> std<span class=\"sy4\">::</span><span class=\"me2\">ranges</span><span class=\"sy4\">::</span><span class=\"me2\">subrange</span><span class=\"br0\">(</span>first, last<span class=\"br0\">)</span><span class=\"br0\">)</span>\n        make_uppercase<span class=\"br0\">(</span>v<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span>\n&nbsp;\n<span class=\"kw4\">int</spa