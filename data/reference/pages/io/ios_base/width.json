"kw107\">std::<span class=\"me2\">size_t</span></span></a> margin <span class=\"sy1\">=</span> <span class=\"nu0\">1</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a>.<span class=\"me1\">put</span><span class=\"br0\">(</span><span class=\"st0\">'+'</span><span class=\"br0\">)</span>.<span class=\"me1\">fill</span><span class=\"br0\">(</span><span class=\"st0\">'-'</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <span class=\"kw1\">for</span> <span class=\"br0\">(</span><a href=\"/w/cpp/types/size_t\"><span class=\"kw107\">std::<span class=\"me2\">size_t</span></span></a> w <span class=\"sy4\">:</span> widths<span class=\"br0\">)</span>\n    <span class=\"br0\">{</span>\n        <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a>.<span class=\"me1\">width</span><span class=\"br0\">(</span>w <span class=\"sy2\">+</span> margin <span class=\"sy2\">*</span> <span class=\"nu0\">2</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n        <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'-'</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'+'</span><span class=\"sy4\">;</span>\n    <span class=\"br0\">}</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a>.<span class=\"me1\">put</span><span class=\"br0\">(</span><span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"br0\">)</span>.<span class=\"me1\">fill</span><span class=\"br0\">(</span><span class=\"st0\">' '</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span><span class=\"sy4\">;</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <sp