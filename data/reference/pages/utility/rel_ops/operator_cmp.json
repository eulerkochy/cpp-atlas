>&amp;</span> lhs, <span class=\"kw4\">const</span> Foo<span class=\"sy3\">&amp;</span> rhs<span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <span class=\"kw1\">return</span> lhs.<span class=\"me1\">n</span> <span class=\"sy1\">&lt;</span> rhs.<span class=\"me1\">n</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    Foo f1 <span class=\"sy1\">=</span> <span class=\"br0\">{</span><span class=\"nu0\">1</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    Foo f2 <span class=\"sy1\">=</span> <span class=\"br0\">{</span><span class=\"nu0\">2</span><span class=\"br0\">}</span><span class=\"sy4\">;</span>\n    <span class=\"kw1\">using</span> <span class=\"kw1\">namespace</span> std<span class=\"sy4\">::</span><span class=\"me2\">rel_ops</span><span class=\"sy4\">;</span>\n&nbsp;\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1774\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <a href=\"/w/cpp/io/manip/boolalpha\"><span class=\"kw1780\">std::<span class=\"me2\">boolalpha</span></span></a>\n              <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"{1}&nbsp;!= {2}&nbsp;: \"</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span>f1 <span class=\"sy3\">!</span><span class=\"sy1\">=</span> f2<span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span>\n              <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"{1} &gt;  {2}&nbsp;: \"</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span>f1 <span class=\"sy1\">&gt;</span>  f2<span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span>\n              <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"{1} &lt;= {2}&nbsp;: \"</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span>f1 <span class=\"sy1\">&lt;=</span> f2<span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span>\n              <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">\"{1} &gt;= {2}&nbsp;: \"</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"br0\">(</span>f1 <span class=\"sy1\">&gt;=</span> f2<span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre data-output=\"1\"><code>{1}&nbsp;!= {2}&nbsp;: true\n{1} &gt;  {2}&nbsp;: false\n{1} &lt;= {2}&nbsp;: true\n{1} &gt;= {2}&nbsp;: false</code></pre> \n</div>","headings":[{"depth":3,"text":"Parameters","id":"Parameters"},{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Possible implementation","id":"Possible_implementation"},{"depth":3,"text":"Notes","id":"Notes"},{"depth":3,"text":"Example","id":"Example"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"utility","title":"Utility library"}],"children":[],"map":{"label":"std::rel_ops::operator!=,>,<=,>=","children":[{"label":"Declarations","note":"4 declarations. Given a user-defined operator== and operator< for objects of type T, implements the usual semantics of other…"},{"label":"Parameters","note":"lhs, rhs"},{"label":"Return value","note":"Returns true if lhs is not equal to rhs."},{"label":"Possible implementation"},{"label":"Notes","note":"Boost.operators provides a more versatile alternative to std::rel_ops."},{"label":"Example"}]},"standards":["C++20"],"wordCount":396,"codeBlockCount":6}
