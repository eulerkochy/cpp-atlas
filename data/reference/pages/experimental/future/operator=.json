eshi cpp source-cpp\"><span class=\"sy2\">*</span>this</span></code>\n</p>","headings":[{"depth":3,"text":"Parameters","id":"Parameters"},{"depth":3,"text":"Return value","id":"Return_value"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"experimental","title":"Experimental C++ Features"},{"path":"experimental/future","title":"std::experimental::future"}],"children":[],"map":{"label":"std::experimental::future<T>::operator=","children":[{"label":"Declarations","note":"2 declarations. Assigns the contents of another future object."},{"label":"Parameters","note":"other"},{"label":"Return value","note":"*this"}]},"standards":[],"wordCount":73,"codeBlockCount":0}
