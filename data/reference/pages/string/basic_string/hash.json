href=\"/w/cpp/string/char_traits\"><span class=\"kw1275\">std::<span class=\"me2\">char_traits</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">char16_t</span><span class=\"sy1\">&gt;</span>, A<span class=\"sy1\">&gt;&gt;</span><span class=\"sy4\">;</span></span></div></td>\n<td> (2) </td>\n<td> <span class=\"t-mark-rev t-since-cxx11\">(since C++11)</span> </td>\n</tr>\n<tr class=\"t-dcl t-since-cxx11\" id=\"Version_3\">\n<td> <div><span class=\"mw-geshi cpp source-cpp\"><span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span> <span class=\"kw1\">class</span> A <span class=\"sy1\">&gt;</span><br><span class=\"kw1\">struct</span> hash<span class=\"sy1\">&lt;</span><a href=\"/w/cpp/string/basic_string\"><span class=\"kw1236\">std::<span class=\"me2\">basic_string</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">char32_t</span>, <a href=\"/w/cpp/string/char_traits\"><span class=\"kw1275\">std::<span class=\"me2\">char_traits</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">char32_t</span><span class=\"sy1\">&gt;</span>, A<span class=\"sy1\">&gt;&gt;</span><span class=\"sy4\">;</span></span></div></td>\n<td> (3) </td>\n<td> <span class=\"t-mark-rev t-since-cxx11\">(since C++11)</span> </td>\n</tr>\n<tr class=\"t-dcl t-since-cxx11\" id=\"Version_4\">\n<td> <div><span class=\"mw-geshi cpp source-cpp\"><span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span> <span class=\"kw1\">class</span> A <span class=\"sy1\">&gt;</span><br><span class=\"kw1\">struct</span> hash<span class=\"sy1\">&lt;</span><a href=\"/w/cpp/string/basic_string\"><span class=\"kw1236\">std::<span class=\"me2\">basic_string</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">wchar_t</span>, <a href=\"/w/cpp/string/char_traits\"><span class=\"kw1275\">std::<span class=\"me2\">char_traits</span></span></a><span class=\"sy1\">&lt;</span><span class=\"kw4\">wchar_t</span><span class=\"sy1\">&gt;</span>, A<span class=\"sy1\">&gt;&gt;</span><span class=\"sy4\">;</span></span></div></td>\n<td> (4) </td>\n<td> <span class=\"t-mark-rev t-since-cxx11\">(since C++11)</span> </td>\n</tr>\n<tr class=\"t-dcl t-since-cxx20\" id=\"Version_5\">\n<td> <div><span class=\"mw-geshi cpp source-cpp\"><span class=\"kw1\">template</span><span class=\"sy1\">&lt;</span> <span class=\"kw1\">class</span> A <span class=\"sy1\">&gt;</span><br><span class=\"kw1\">struct</span> hash<span class=\"sy1\">&lt;</span><a href=\"/w/cpp/string/basic_string\"><span class=\"kw1236\">std::<span class=\"me2\">basic_string</span></span></a><span class=\"sy1\">&lt;</span>char8_t, <a href=\"/w/cpp/string/char_traits\"><span class=\"kw1275\">std::<span class=\"me2\">char_traits</span></span></a><span class=\"sy1\">&lt;</span>char8_t<span class=\"sy1\">&gt;</span>, A<span class=\"sy1\">&gt;&gt;</span><span class=\"sy4\">;</span></span></div></td>\n<td> (5) </td>\n<td> <span class=\"t-mark-rev t-since-cxx20\">(since C++20)</span> </td>\n</tr>\n<tr class=\"t-dcl-sep\"><td></td><td></td><td></td></tr>\n</tbody></table>\n<p>The template specializations of <span class=\"t-lc\"><a href=\"/w/cpp/utility/hash\">std::hash</a></span> for the various string classes allow users to obtain hashes of strings.\n</p>\n<table class=\"t-rev-begin\">\n<tr class=\"t-rev t-since-cxx17\"><td>\n<p>These hashes equal the hashes of corresponding <span class=\"t-lc\"><a href=\"/w/cpp/string/basic_string_view\">std::basic_string_view</a></span> classes: If <code>S</code> is one of these string types, <code>SV</code> is the corresponding string view type, and <code>s</code> is an object of type <code>S</code>, then <code class=\"t-c\"><span class=\"mw-geshi cpp source-cpp\"><a href=\"/w/cpp/utility/hash\"><span class=\"kw1132\">std::<span class=\"me2\">hash</span></span></a><span class=\"sy1\">&lt;</span>S<span class=\"sy1\">&gt;</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">(</span>s<span class=\"br0\">)</span> <span class=\"sy1\">==</span> <a href=\"/w/cpp/utility/hash\"><span class=\"kw1132\">std::<span class=\"me2\">hash</span></span></a><span class=\"sy1\">&lt;</span>SV<span class=\"sy1\">&gt;</span><span class=\"br0\">(</span><span class=\"br0\">)</span><span class=\"br0\">(</span>SV<span class=\"br0\">(</span>s<span class=\"br0\">)</span><span class=\"br0\">)</span></span></code>.\n</p>\n</td>\n<td><span class=\"t-mark-rev t-since-cxx17\">(since C++17)</span></td></tr>\n</table>\n<h3 id=\"Example\">Example</h3>\n<div class=\"t-example\"><p>The following code shows one possible output of a hash function used on a string:</p>\n<pre data-lang=\"cpp\"><code><span class=\"co2\">#include &lt;functional&gt;</span>\n<span class=\"co2\">#include &lt;iostream&gt;</span>\n<span class=\"co2\">#include &lt;memory_resource&gt;</span>\n<span class=\"co2\">#include &lt;string&gt;</span>\n<span class=\"co2\">#include &lt;string_view&gt;</span>\n<span class=\"kw1\">using</span> <span class=\"kw1\">namespace</span> std<span class=\"sy4\">::</span><span class=\"me2\">literals</span><span class=\"sy4\">;</span>\n&nbsp;\n<span class=\"kw4\">int</span> main<span class=\"br0\">(</span><span class=\"br0\">)</span>\n<span class=\"br0\">{</span>\n    <span class=\"kw4\">auto</span> sv <span class=\"sy1\">=</span> <span class=\"st0\">\"Stand back! I've got jimmies!\"</span>sv<span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/string/basic_string\"><span class=\"kw1238\">std::<span class=\"me2\">string</span></span></a> s<span class=\"br0\">(</span>sv<span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/string/basic_string\"><span class=\"kw1246\">std::<span class=\"me2\">pmr</span><span class=\"sy4\">::</span><span class=\"me2\">string</span></span></a> pmrs<span class=\"br0\">(</span>sv<span class=\"br0\">)</span><span class=\"sy4\">;</span> <span class=\"co1\">// use default allocator</span>\n&nbsp;\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <a href=\"/w/cpp/utility/hash\"><span class=\"kw1132\">std::<span class=\"me2\">hash</span></span></a><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/string/basic_string_view\"><span class=\"kw1256\">std::<span class=\"me2\">string_view</span></span></a><span class=\"sy1\">&gt;</span><span class=\"br0\">{</span><span class=\"br0\">}</span><span class=\"br0\">(</span>sv<span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <a href=\"/w/cpp/utility/hash\"><span class=\"kw1132\">std::<span class=\"me2\">hash</span></span></a><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/string/basic_string\"><span class=\"kw1238\">std::<span class=\"me2\">string</span></span></a><span class=\"sy1\">&gt;</span><span class=\"br0\">{</span><span class=\"br0\">}</span><span class=\"br0\">(</span>s<span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/io/cout\"><span class=\"kw1775\">std::<span class=\"me2\">cout</span></span></a> <span class=\"sy1\">&lt;&lt;</span> <a href=\"/w/cpp/utility/hash\"><span class=\"kw1132\">std::<span class=\"me2\">hash</span></span></a><span class=\"sy1\">&lt;</span><a href=\"/w/cpp/string/basic_string\"><span class=\"kw1246\">std::<span class=\"me2\">pmr</span><span class=\"sy4\">::</span><span class=\"me2\">string</span></span></a><span class=\"sy1\">&gt;</span><span class=\"br0\">{</span><span class=\"br0\">}</span><span class=\"br0\">(</span>pmrs<span class=\"br0\">)</span> <span class=\"sy1\">&lt;&lt;</span> <span class=\"st0\">'<span class=\"es1\">\\n</span>'</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n