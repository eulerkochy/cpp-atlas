an class=\"sy4\">::</span><span class=\"me2\">vector_aligned</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n    <a href=\"/w/cpp/error/assert\"><span class=\"kw778\">assert</span></a><span class=\"br0\">(</span>stdx<span class=\"sy4\">::</span><span class=\"me2\">hmin</span><span class=\"br0\">(</span>w<span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"nu0\">1</span> and stdx<span class=\"sy4\">::</span><span class=\"me2\">hmax</span><span class=\"br0\">(</span>w<span class=\"br0\">)</span> <span class=\"sy1\">==</span> <span class=\"nu0\">5</span><span class=\"br0\">)</span><span class=\"sy4\">;</span>\n<span class=\"br0\">}</span></code></pre>\n<p>Output:\n</p>\n<pre data-output=\"1\"><code>sum of data = 523776</code></pre> \n</div>\n<h3 id=\"See_also\">See also</h3>\n<table class=\"t-dsc-begin\">\n<tr class=\"t-dsc\">\n<td>  <div class=\"t-dsc-member-div\"><div><a href=\"/w/cpp/algorithm/reduce\"> <span class=\"t-lines\"><span>reduce</span></span></a></div><div><span class=\"t-lines\"><span><span class=\"t-mark-rev t-since-cxx17\">(C++17)</span></span></span></div></div>\n</td>\n<td>  similar to <span class=\"t-lc\"><a href=\"/w/cpp/algorithm/accumulate\">std::accumulate</a></span>, except out of order <br> <span class=\"t-mark\">(function template)</span> </td></tr>\n</table>","headings":[{"depth":3,"text":"Parameters","id":"Parameters"},{"depth":3,"text":"Return value","id":"Return_value"},{"depth":3,"text":"Example","id":"Example"},{"depth":3,"text":"See also","id":"See_also"}],"breadcrumbs":[{"path":"","title":"C++ reference"},{"path":"experimental","title":"Experimental C++ Features"},{"path":"experimental/simd","title":"SIMD library"}],"children":[],"map":{"label":"std::experimental::reduce, std::experimental::hmin, std::experimental::hmax","children":[{"label":"Declarations","note":"11 declarations. Reduces all values in v over binary_op."},{"label":"Parameters","note":"v, x, identity_element, binary_op"},{"label":"Re